userSections = CASEDATA

# L0=0.1 m, U0=0.3 m/s (gas inlet), rho0=998.2 kg/m^3.
# All values below are nondimensional. The .re2 coordinates are still in metres.
[MESH]
file = bubbleColumn.re2

[GENERAL]
polynomialOrder = 7
# Resolve degree-14 alpha*UG products before conservative differentiation.
cubaturePolynomialOrder = 14
# Fresh start. Restart only from a checkpoint made by this nondimensional case.
stopAt = numSteps
numSteps = 100000
# 1e-5 s * U0/L0
dt = 3e-5
timeStepper = tombo2
checkpointInterval = 1000
scalars = ALPHA, UGX, UGY, UGZ

[FLUID PRESSURE]
initialGuess = previous
residualTol = 3.513641844631532e-06

[FLUID VELOCITY]
initialGuess = previous
# Boundary IDs: 1=inlet, 2=outlet, 3=wall
boundaryTypeMap = udfDirichlet, zeroNeumann, udfDirichlet
residualTol = 3.519977804679956e-08
rho = 1
viscosity = 3.339344152808389e-05
regularization = hpfrt + nModes=1 + scalingCoeff=3.333333333333333

[SCALAR ALPHA]
initialGuess = previous
boundaryTypeMap = udfDirichlet, zeroNeumann, zeroNeumann
residualTol = 1.05409255338946e-05
transportCoeff = 1.0
diffusionCoeff = 0.0003333333333333334
# NekRS native high-pass-filter relaxation. Use regularization = none to disable.
regularization = hpfrt + nModes=1 + scalingCoeff=3.333333333333333

[SCALAR UGX]
initialGuess = previous
boundaryTypeMap = udfDirichlet, zeroNeumann, udfDirichlet
residualTol = 3.513641844631532e-05
transportCoeff = 1.0
diffusionCoeff = 0.0003333333333333334
regularization = hpfrt + nModes=1 + scalingCoeff=3.333333333333333

[SCALAR UGY]
initialGuess = previous
boundaryTypeMap = udfDirichlet, zeroNeumann, udfDirichlet
residualTol = 3.513641844631532e-05
transportCoeff = 1.0
diffusionCoeff = 0.0003333333333333334
regularization = hpfrt + nModes=1 + scalingCoeff=3.333333333333333

[SCALAR UGZ]
initialGuess = previous
boundaryTypeMap = udfDirichlet, zeroNeumann, udfDirichlet
residualTol = 3.513641844631532e-05
transportCoeff = 1.0
diffusionCoeff = 0.0003333333333333334
regularization = hpfrt + nModes=1 + scalingCoeff=3.333333333333333

[CASEDATA]
rhoLiquid = 1
rhoGas = 0.00120216389501102
muLiquid = 3.339344152808389e-05
muGas = 6.0108194750551e-07
# Fresh starts use an axial plume for alpha and UG; restart files take precedence.
initialPlumeHeight = 0.5
initialPlumeThickness = 0.1
alphaInlet = 0.016667
gasInletVelocity = 1
# Initial nondimensional UG plume peak, multiplied by the axial tanh profile.
gasInitialVelocity = 1
gravityX = 0.0
gravityY = 0.0
gravityZ = -10.9
# Explicit filter of solved alpha each step, before clipping/properties/pressure.
# Uses the user bubble-basis module; independent of native HPFRT regularization.
# Strength 0 disables this filter. Modes: 1..N-1.
alphaExplicitFilterModes = 1
alphaExplicitFilterStrength = 0.05
alphaFloor = 1e-6
alphaClipEnabled = 1.0
alphaMinimum = 0.0
alphaMaximum = 1.0
subtractAlphaDiffusion = 0.0
subtractUgxDiffusion = 0.0
subtractUgyDiffusion = 0.0
subtractUgzDiffusion = 0.0
zRampBottom = 9
zRampTop = 9.5
outletDampingFactor = 20.0
gasVelocityClipEnabled = 0.0
gasVelocityMaximum = 1.666666666666667
mixtureVelocityClipEnabled = 0.0
mixtureVelocityMaximum = 3.333333333333333
gasMomentumCutoff = 1e-4
gasMomentumFullyActive = 1e-3
gasPressureEnabled = 1.0
# UG always uses the raw assembled strong pressure gradient.
# 0: latest completed pressure, grad(p^n); 1: EXT of raw gradient history,
# with the same time-dependent EXT coefficients used by native UM convection.
# No pressure spatial filter, temporal relaxation, weak selection or inlet mask.
gasPressureGradientExtrapolation = 0
dragEnabled = 1.0
bubbleDiameter = 0.03
# Set to 0.0 to omit -div(tau_d)/rho_m from mixture momentum.
driftStressEnabled = 1.0
virtualMassEnabled = 1.0
virtualMassCoefficient = 0.5
# Native alpha/UG scalar convection is disabled; user gas transport is supplied directly.
# Alpha uses selected conservative div(alpha*UG); UG uses cubature UG.grad(UG).
# Full alpha/UG convection products use native UM EXT coefficients.
# Scalar EXT1 only carries already-selected sources; diffusion stays implicit; full gas drag is explicit.
gasTransportMethod = 1
# 1: form alpha*UG at GLL nodes, then assembled SEM strong divergence.
# 2: conservative cubature flux differentiation (existing default).
alphaTransportForm = 2
# Target uses alpha conservative transport + numerical diffusion only.
# HPFRT, explicit-filter/clipping rates and boundary BDF overrides are excluded.
# 0 imposes div(U)=0; 1 enables the reconstructed target (optionally ramped).
mixtureDivergenceEnabled = 1
# Spatial inlet layer of thickness delta (mesh units): div(UM)=0 for z<=delta/2.
# Cosine ramp to the full reconstructed target over delta/2 < z < delta.
# Inlet is at z=0. Applied after filtering, extrapolation and ramp, each physical step.
# 0 disables the inlet layer; raw divergence exports remain unchanged.
divergenceInletThickness = 0.1
# 1: previous (rhoL-rhoG)/rhoM * [alpha transport/diffusion + UM.grad(alpha)].
# 2: (rhoL-rhoG)/rhoL * [div(alpha*(UM-UG)) + numerical diffusion].
# Relative flux follows alphaTransportForm and the same UM EXT coefficients.
mixtureDivergenceForm = 2
# Raw method0/method1/difference statistics in log and comparison CSV.
divergenceComparisonInterval = 10
# User explicitFilterApply: Legendre bubble-basis tensor filter.
# Modes: 1..N-1. Strength sets highest 1D mode attenuation: sigma_N=1-strength.
# Lower selected modes receive parabolic attenuation; 0 leaves d unchanged.
# Pressure uses the filtered/assembled target; comparison fields remain raw.
divergenceFilterModes = 1
divergenceFilterStrength = 0.25
divergenceExtrapolationEnabled = 0.0
divergenceRampEnabled = 1
divergenceRampSteps = 1000
stabilityMonitorEnabled = 1.0
stabilityMonitorInterval = 10
validationOutputInterval = 10

# Fixed native order: ALPHA -> UGX/UGY/UGZ -> pressure -> UM.
# Convection and VM liquid acceleration use fluid EXT.
# Strong pressure-gradient EXT is optional. Drag uses the current source-time slip.
# Rank-0 solve-order trace: first step plus every N steps.
# 1 prints every step; 0 disables the trace.
oneThroughLogInterval = 10


# Read-only UG equation snapshots, extrema/CSV and vector files at checkpoints.
# 1 enables; 0 disables snapshots and their diagnostic work.
ugTermDiagnosticsEnabled = 1
# First step + every N steps + every checkpoint; 0 means first/checkpoints only.
ugTermDiagnosticsInterval = 10
