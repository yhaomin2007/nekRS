      end
c-----------------------------------------------------------------------
      subroutine usrdat2
      include 'SIZE'
      include 'TOTAL'
      real invLength
      parameter (invLength = 10.0)
      integer n

c     Scale the curved GLL coordinates before NekRS builds its metrics.
      n = lx1*ly1*lz1*nelt
      call cmult(xm1,invLength,n)
      call cmult(ym1,invLength,n)
      call cmult(zm1,invLength,n)
      return
      end
c-----------------------------------------------------------------------
      subroutine usrdat3
      return
      end
