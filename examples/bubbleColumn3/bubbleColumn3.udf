#include "nrs.hpp"
#include "udf.hpp"
#include "bubbleColumn3Cubature.hpp"
#include <array>
#include "bubbleColumn3Krylov.hpp"

#ifdef __okl__
#include "bubbleColumn3.oudf"
#endif

namespace bubbleColumn3 {
struct Parameters {
  dfloat rhoLiquid=998.2,rhoGas=1.2,muLiquid=1e-3;
  dfloat alphaInlet=0.016667,ugInlet=0.3,ulInlet=0;
  dfloat initialPlumeHeight=0.05,initialPlumeThickness=0.01;
  dfloat gravity[3]={0,0,-9.81};
  dfloat dragEnabled=1,bubbleDiameter=3e-3;
  dfloat alphaMinimum=0,alphaMaximum=0.99;
  int virtualMassEnabled=0,monitorInterval=10;
  int dragCouplingMaxIterations=30;
  dfloat dragCouplingTolerance=1e-10;
  int pressureProjectionMaxIterations=200,pressureProjectionRestart=15;
  dfloat pressureProjectionTolerance=1e-8;
  dfloat pressureProjectionStabilization=0.1;
};
static Parameters p;
static const std::array<std::string,7> names={"alpha","ugx","ugy","ugz","ulx","uly","ulz"};
static deviceMemory<dfloat> ug,ul,lambdaG,lambdaL;
static deviceMemory<dfloat> fields,cube,products,transportG,transportL,zeroAdvection;
static occa::kernel interpolateKernel,productsKernel,projectKernel,alphaKernel;
static occa::kernel reconstructKernel,initializeKernel,clipKernel,dragKernel,sourceKernel,dragLoadKernel;
static deviceMemory<dfloat> predictorBase,phasePrevious,phaseDelta;
static int dragIterations=0;
static dfloat dragChange=0;
static int preparedStep=-1,completedStep=-1;
inline void validateLinearSolve(elliptic*,const std::string&);

inline void packVelocities()
{
  const auto O=nrs->fieldOffset,N=nrs->meshV->Nlocal;
  for(int c=0;c<3;++c) {
    ug.copyFrom(nrs->scalar->o_solution(names[1+c]),N,c*O,0);
    ul.copyFrom(nrs->scalar->o_solution(names[4+c]),N,c*O,0);
  }
}
inline void unpackVelocities()
{
  const auto O=nrs->fieldOffset,N=nrs->meshV->Nlocal;
  for(int c=0;c<3;++c) {
    nrs->scalar->o_solution(names[1+c]).copyFrom(ug,N,0,c*O);
    nrs->scalar->o_solution(names[4+c]).copyFrom(ul,N,0,c*O);
  }
}
inline void reconstructMixture()
{
  packVelocities();
  reconstructKernel(nrs->meshV->Nlocal,nrs->fieldOffset,
      nrs->scalar->o_solution("alpha"),ug,ul,nrs->fluid->o_U);
}
// Return four operators: div(alpha*v) and v.grad(v_x,y,z), evaluated with
// the existing dealiased Method2 GL interpolation/differentiation/projection.
inline void convection(const deviceMemory<dfloat>& velocity,deviceMemory<dfloat>& result)
{
  auto m=nrs->meshV;const auto O=nrs->fieldOffset,C=m->Nelements*m->cubNp;
  fields.copyFrom(nrs->scalar->o_solution("alpha"),m->Nlocal);
  for(int c=0;c<3;++c) fields.copyFrom(velocity,m->Nlocal,(c+1)*O,c*O);
  interpolateKernel(m->Nelements,O,C,m->o_cubInterpT,fields,cube);
  productsKernel(m->Nelements,C,m->o_cubD,m->o_cubvgeo,cube,products);
  projectKernel(m->Nelements,O,C,m->o_cubInterpT,m->o_vgeo,products,result);
  // Conservative-alpha kernel zeroes components 1..3. Preserve the separately
  // evaluated material convection before projecting alpha into scratch fields.
  alphaKernel(m->Nelements,C,m->o_cubD,m->o_cubvgeo,cube,products);
  projectKernel(m->Nelements,O,C,m->o_cubInterpT,m->o_vgeo,products,fields);
  result.copyFrom(fields,m->Nlocal);
  platform->linAlg->axmyMany(m->Nlocal,4,O,0,1.0,m->o_LMM,result);
  oogs::startFinish(result,4,O,ogsDfloat,ogsAdd,m->oogs);
  platform->linAlg->axmyMany(m->Nlocal,4,O,0,1.0,m->o_invLMM,result);
}
inline occa::memory implicitDrag(double,int is)
{
  if(is>=1 && is<=3) return lambdaG;
  if(is>=4 && is<=6) return lambdaL;
  return o_NULL;
}
inline void beginStep(double time)
{
  if(nrs->tstep<=0) return; // native adaptive-CFL initialization probe
  nekrsCheck(preparedStep==nrs->tstep || (preparedStep>0 && completedStep!=preparedStep),
      platform->comm.mpiComm(),EXIT_FAILURE,"%s","Repeated/missing method3 timestep.\n");
  preparedStep=nrs->tstep;
  auto &s=nrs->scalar;auto m=nrs->meshV;const auto O=nrs->fieldOffset;
  nekrsCheck(s->ellipticSolver.size()!=7,platform->comm.mpiComm(),EXIT_FAILURE,
      "%s","Method3 phase solvers are not ready at source preparation.\n");
  for(auto *solver:s->ellipticSolver) nekrsCheck(!solver,platform->comm.mpiComm(),EXIT_FAILURE,
      "%s","Method3 requires all seven native scalar solvers.\n");
  nekrsCheck(!nrs->fluid->ellipticSolver.empty() || nrs->fluid->ellipticSolverP,
      platform->comm.mpiComm(),EXIT_FAILURE,"%s","Native UM/P solves must stay disabled.\n");
  s->compute.assign(7,1);
  // Scalar elliptic masks exist here, unlike during UDF_Setup. Impose the
  // source-time inlet/wall values before forming the first phase predictors.
  s->applyDirichlet(time);
  reconstructMixture();convection(ug,transportG);convection(ul,transportL);
  auto alphaSource=s->o_explicitTerms("alpha");
  platform->linAlg->axpby(m->Nlocal,-1.0,transportG,1.0,alphaSource);
  for(int c=0;c<3;++c) {
    sourceKernel(m->Nlocal,O,c,p.gravity[c],transportG,s->o_explicitTerms(names[1+c]));
    sourceKernel(m->Nlocal,O,c,p.gravity[c],transportL,s->o_explicitTerms(names[4+c]));
  }
  // Assemble the six RHSs BEFORE the host shifts BDF and explicit histories.
  // Native scalar::makeForcing below assembles alpha and shifts ALL histories
  // once, including those of the six deferred components.
  for(int is=1;is<7;++is) {
    s->makeExplicit(is,time,nrs->tstep);
    launchKernel("scalar_t::sumMakef",m->Nlocal,m->o_LMM,1.0/nrs->dt[0],
        s->o_coeffEXT,s->o_coeffBDF,s->fieldOffsetScan[is],s->fieldOffsetSum,
        m->fieldOffset,s->o_transportCoeff(),s->o_S,zeroAdvection,s->o_EXT,s->o_JwF);
    predictorBase.copyFrom(s->o_JwF,m->Nlocal,s->fieldOffsetScan[is],s->fieldOffsetScan[is]);
    s->compute[is]=0;
  }
}
inline void postAlpha(double time,int)
{
  validateLinearSolve(nrs->scalar->ellipticSolver.at(0),"alpha");
  clipKernel(nrs->meshV->Nlocal,p.alphaMinimum,p.alphaMaximum,nrs->scalar->o_solution("alpha"));
  // Enforce inlet alpha again after clipping; restore six phase boundary values.
  nrs->scalar->compute.assign(7,1);
  nrs->scalar->applyDirichlet(time);
  packVelocities();
  // Current alpha pairs the equal/opposite drag coefficients and pressure
  // mobility. Slip is lagged, coefficients remain fixed during phase solves.
  dragKernel(nrs->meshV->Nlocal,nrs->fieldOffset,p.dragEnabled,p.rhoGas,p.rhoLiquid,
      p.muLiquid,p.bubbleDiameter,nrs->scalar->o_solution("alpha"),ug,ul,lambdaG,lambdaL);
  nrs->scalar->compute.assign(7,0);nrs->scalar->compute[0]=1;
}
inline void validateLinearSolve(elliptic *solver,const std::string& field)
{
  const auto tolerance=solver->options().getArgs("SOLVER TOLERANCE");
  const dfloat initial=solver->initialResidual(),final=solver->finalResidual();
  const dfloat target=std::stod(tolerance)*std::sqrt(nrs->meshV->volume)
      *(upperCase(tolerance).find("+RELATIVE")!=std::string::npos?initial:1.0);
  const dfloat floor=100*std::numeric_limits<dfloat>::epsilon()*initial;
  nekrsCheck(!std::isfinite(initial) || !std::isfinite(final)
      || final>std::max(target,floor),platform->comm.mpiComm(),EXIT_FAILURE,
      "%s linear solve did not converge: initial=%g final=%g target=%g iterations=%d preconditioner=%s\n",
      field.c_str(),initial,final,target,solver->Niter(),solver->options().getArgs("PRECONDITIONER").c_str());
}
inline void solvePhasePredictors(double time)
{
  auto &s=nrs->scalar;auto m=nrs->meshV;const auto N=m->Nlocal,O=nrs->fieldOffset;
  s->compute.assign(7,1);s->compute[0]=0;
  packVelocities();
  const int maxIterations=p.dragEnabled?p.dragCouplingMaxIterations:1;
  dragChange=0;
  for(dragIterations=1;dragIterations<=maxIterations;++dragIterations) {
    phasePrevious.copyFrom(ug,3*O);phasePrevious.copyFrom(ul,3*O,3*O,0);
    // Reuse identical BDF/convection/diffusion RHSs; do not shift histories.
    for(int c=0;c<3;++c) {
      auto rg=s->o_JwF.slice(s->fieldOffsetScan[1+c],N);
      auto rl=s->o_JwF.slice(s->fieldOffsetScan[4+c],N);
      rg.copyFrom(predictorBase.slice(s->fieldOffsetScan[1+c],N));
      rl.copyFrom(predictorBase.slice(s->fieldOffsetScan[4+c],N));
      dragLoadKernel(N,O,c,m->o_LMM,lambdaG,ul,rg);
      dragLoadKernel(N,O,c,m->o_LMM,lambdaL,ug,rl);
    }
    s->applyDirichlet(time);s->solve(time,dragIterations);
    for(int is=1;is<7;++is) validateLinearSolve(s->ellipticSolver.at(is),names[is]);
    packVelocities();
    if(!p.dragEnabled) break;
    phaseDelta.copyFrom(ug,3*O);phaseDelta.copyFrom(ul,3*O,3*O,0);
    const dfloat norm=platform->linAlg->weightedNorm2Many(N,6,O,m->o_LMM,phaseDelta,platform->comm.mpiComm());
    platform->linAlg->axpby(6*O,-1.0,phasePrevious,1.0,phaseDelta);
    const dfloat diff=platform->linAlg->weightedNorm2Many(N,6,O,m->o_LMM,phaseDelta,platform->comm.mpiComm());
    dragChange=diff/std::max(std::sqrt(m->volume),norm);
    nekrsCheck(!std::isfinite(dragChange),platform->comm.mpiComm(),EXIT_FAILURE,
        "%s","Nonfinite phase predictor during drag coupling.\n");
    if(dragChange<=p.dragCouplingTolerance) break;
  }
  nekrsCheck(dragIterations>maxIterations,platform->comm.mpiComm(),EXIT_FAILURE,
      "Phase drag coupling did not converge: change=%g tolerance=%g maxIterations=%d\n",
      dragChange,p.dragCouplingTolerance,maxIterations);
  s->compute.assign(7,1);
}
inline bool singlePass(int stage)
{
  nekrsCheck(stage!=1,platform->comm.mpiComm(),EXIT_FAILURE,"%s",
      "bubbleColumn3 requires a single native outer stage.\n");
  return true;
}
} // namespace bubbleColumn3
#include "bubbleColumn3Pressure.hpp"

void UDF_Setup0(MPI_Comm,setupAide&)
{
  using namespace bubbleColumn3;
  // Some installed v26 parsers reject an elliptic-section poisson PAR key.
  // Set its internal option before kernel registration instead. The pressure
  // constructor also receives o_NULL for its Helmholtz mass coefficient.
  platform->options.setArgs("ELLIPTIC PHASEPRESSURE HELMHOLTZ TYPE","POISSON");
  platform->options.setArgs("ELLIPTIC PHASEPRESSURE ELLIPTIC COEFF FIELD","TRUE");
  // STOKES here disables only NATIVE UM-based scalar advection. User sources
  // still contain full phase convection and conservative alpha transport.
  nekrsCheck(!platform->options.compareArgs("FLUID VELOCITY SOLVER","NONE")
      || !platform->options.compareArgs("EQUATION TYPE","STOKES"),
      platform->comm.mpiComm(),EXIT_FAILURE,"%s",
      "bubbleColumn3 needs fluid velocity solver=none and equation=stokes (user convection).\n");
#define READ(key,member) platform->par->extract("casedata",key,p.member)
  READ("rholiquid",rhoLiquid);READ("rhogas",rhoGas);READ("muliquid",muLiquid);
  READ("alphainlet",alphaInlet);READ("gasinletvelocity",ugInlet);READ("liquidinletvelocity",ulInlet);
  READ("initialplumeheight",initialPlumeHeight);READ("initialplumethickness",initialPlumeThickness);
  READ("gravityx",gravity[0]);READ("gravityy",gravity[1]);READ("gravityz",gravity[2]);
  READ("dragenabled",dragEnabled);READ("bubblediameter",bubbleDiameter);
  READ("alphaminimum",alphaMinimum);READ("alphamaximum",alphaMaximum);
  READ("virtualmassenabled",virtualMassEnabled);READ("monitorinterval",monitorInterval);
  READ("dragcouplingmaxiterations",dragCouplingMaxIterations);READ("dragcouplingtolerance",dragCouplingTolerance);
  READ("pressureprojectionmaxiterations",pressureProjectionMaxIterations);
  READ("pressureprojectionrestart",pressureProjectionRestart);
  READ("pressureprojectiontolerance",pressureProjectionTolerance);
  READ("pressureprojectionstabilization",pressureProjectionStabilization);
#undef READ
  nekrsCheck(!(std::isfinite(p.rhoLiquid)&&p.rhoLiquid>0 && std::isfinite(p.rhoGas)&&p.rhoGas>0
      && std::isfinite(p.muLiquid)&&p.muLiquid>0 && std::isfinite(p.bubbleDiameter)&&p.bubbleDiameter>0
      && std::isfinite(p.initialPlumeThickness)&&p.initialPlumeThickness>0
      && std::isfinite(p.ugInlet) && std::isfinite(p.ulInlet)
      && std::isfinite(p.gravity[0]) && std::isfinite(p.gravity[1]) && std::isfinite(p.gravity[2])
      && std::isfinite(p.initialPlumeHeight) && p.initialPlumeHeight>=0 && p.alphaMinimum>=0 && p.alphaMaximum<1
      && p.alphaMinimum<=p.alphaInlet && p.alphaInlet<=p.alphaMaximum
      && (p.dragEnabled==0 || p.dragEnabled==1) && p.monitorInterval>=0
      && std::isfinite(p.pressureProjectionStabilization) && p.pressureProjectionStabilization>0
      && p.pressureProjectionStabilization<=1 && p.pressureProjectionMaxIterations>0 && p.pressureProjectionRestart>0
      && std::isfinite(p.pressureProjectionTolerance) && p.pressureProjectionTolerance>0 && p.pressureProjectionTolerance<1
      && p.dragCouplingMaxIterations>0 && std::isfinite(p.dragCouplingTolerance) && p.dragCouplingTolerance>0)
      || p.virtualMassEnabled!=0,
      platform->comm.mpiComm(),EXIT_FAILURE,"%s",
      "Invalid method3 parameters; alphaMaximum<1 and virtualMassEnabled=0 required.\n");
  int N=0,C=0;
  platform->options.getArgs("POLYNOMIAL DEGREE",N);
  platform->options.getArgs("CUBATURE POLYNOMIAL DEGREE",C);
  nekrsCheck(C<2*N,platform->comm.mpiComm(),EXIT_FAILURE,"%s","Need cubaturePolynomialOrder>=2*polynomialOrder.\n");
  // Core advection kernels are registered even for equation=stokes. Supply
  // c_I for order pairs missing from the installed interpolation table.
  const auto interpolationHeader=missingCubatureInterpolationHeader(N,C);
  if(!interpolationHeader.empty()) {
    platform->kernelInfo["headers"].asArray();
    platform->kernelInfo["headers"]+=interpolationHeader;
  }
}

void UDF_LoadKernels(deviceKernelProperties& info)
{
  using namespace bubbleColumn3;
  info.define("p_ALPHA_INLET")=p.alphaInlet;
  info.define("p_UG_INLET")=p.ugInlet;
  info.define("p_UL_INLET")=p.ulInlet;
  auto ci=info;int C=0;platform->options.getArgs("CUBATURE POLYNOMIAL DEGREE",C);
  ci.define("p_cubNq")=C+1;ci.define("p_cubNp")=(C+1)*(C+1)*(C+1);
  if(platform->options.compareArgs("REGISTER ONLY","TRUE")) {
    platform->kernelRequests.add("bubbleColumn3::transport","bubbleColumn3Transport.okl",ci);
    platform->kernelRequests.add("bubbleColumn3::equations","bubbleColumn3Equations.okl",info);
  } else {
#define LOAD(member,request,name) member=platform->kernelRequests.load(request,name)
    LOAD(interpolateKernel,"bubbleColumn3::transport","gasInterpolate");
    LOAD(productsKernel,"bubbleColumn3::transport","gasCubatureProducts");
    LOAD(projectKernel,"bubbleColumn3::transport","gasProject");
    LOAD(alphaKernel,"bubbleColumn3::transport","alphaConservativeCubature");
    LOAD(reconstructKernel,"bubbleColumn3::equations","reconstruct");
    LOAD(initializeKernel,"bubbleColumn3::equations","initialize");
    LOAD(clipKernel,"bubbleColumn3::equations","clipAlpha");
    LOAD(dragKernel,"bubbleColumn3::equations","drag");
    LOAD(sourceKernel,"bubbleColumn3::equations","phaseSource");
    LOAD(dragLoadKernel,"bubbleColumn3::equations","addDragLoad");
    LOAD(mobilityKernel,"bubbleColumn3::equations","mobility");
    LOAD(correctKernel,"bubbleColumn3::equations","correct");
    // Negative boundary flux is accumulated with CUDA-compatible atomicAdd.
    LOAD(surfaceKernel,"bubbleColumn3::equations","pressureSurface");
#undef LOAD
  }
}

void UDF_Setup()
{
  using namespace bubbleColumn3;
  nekrsCheck(!nrs->fluid || nrs->Nscalar!=7 || nrs->scalar->anyCvodeSolver
      || nrs->geom || nrs->neknek || nrs->advectionSubcycingSteps || nrs->meshV->Nbid!=3,
      platform->comm.mpiComm(),EXIT_FAILURE,"%s",
      "bubbleColumn3 requires fixed mesh, seven native elliptic scalars, no NekNek/subcycling.\n");
  auto &s=nrs->scalar; auto m=nrs->meshV;const auto O=nrs->fieldOffset;
  nekrsCheck(platform->options.compareArgs("VARIABLE DT","TRUE"),
      platform->comm.mpiComm(),EXIT_FAILURE,"%s",
      "Method3 currently requires fixed dt: native adaptive CFL uses UM and can miss phase slip.\n");
  for(int is=0;is<7;++is) {
    const auto it=s->nameToIndex.find(names[is]);
    nekrsCheck(it==s->nameToIndex.end() || it->second!=is || !s->compute[is],
        platform->comm.mpiComm(),EXIT_FAILURE,"Expected active scalar %s at %d\n",names[is].c_str(),is);
    nekrsCheck(s->mesh(is)!=m || s->fieldOffset()!=O
        || platform->app->bc->hasRobin("SCALAR"+scalarDigitStr(is)),
        platform->comm.mpiComm(),EXIT_FAILURE,"%s","Method3 requires common fluid meshes and Dirichlet/Neumann scalar BCs.\n");
    const auto field="scalar"+scalarDigitStr(is);
    for(int bid=1;bid<=3;++bid) {
      const auto expected=(bid==1 || (is>0 && bid==3))
          ? bdryBase::bcType_udfDirichlet : bdryBase::bcType_zeroNeumann;
      nekrsCheck(platform->app->bc->typeId(bid,field)!=expected,
          platform->comm.mpiComm(),EXIT_FAILURE,
          "Unexpected %s boundary map at ID %d: use the supplied Method3 inlet/outlet/wall maps.\n",
          names[is].c_str(),bid);
    }
    const auto range=platform->linAlg->minMax(m->Nlocal,{s->o_transportCoeff(names[is])},platform->comm.mpiComm());
    nekrsCheck(std::abs(range[0].first-1)>1e-12 || std::abs(range[0].second-1)>1e-12,
        platform->comm.mpiComm(),EXIT_FAILURE,"%s","All phase/alpha transportCoeff must be 1.\n");
  }
  nekrsCheck(!nrs->fluid->ellipticSolver.empty() || nrs->fluid->ellipticSolverP,
      platform->comm.mpiComm(),EXIT_FAILURE,"%s","Native UM/P solvers must be disabled.\n");
  // Our deferred assembly uses the same BDF/EXT histories as the native alpha.
  ug.resize(3*O);ul.resize(3*O);lambdaG.resize(O);lambdaL.resize(O);
  predictorBase.resize(s->fieldOffsetSum);phasePrevious.resize(6*O);phaseDelta.resize(6*O);
  platform->linAlg->fill(6*O,0.0,phasePrevious);platform->linAlg->fill(6*O,0.0,phaseDelta);
  fields.resize(4*O);cube.resize(4*m->Nelements*m->cubNp);products.resize(cube.size());
  transportG.resize(4*O);transportL.resize(4*O);
  zeroAdvection.resize(std::max(s->o_coeffBDF.size(),s->o_coeffEXT.size())*s->fieldOffsetSum);
  platform->linAlg->fill(zeroAdvection.size(),0.0,zeroAdvection);
  platform->linAlg->fill(O,0.0,lambdaG);platform->linAlg->fill(O,0.0,lambdaL);
  if(platform->options.getArgs("RESTART FILE NAME").empty()) {
    for(const auto &name:names) platform->linAlg->fill(O,0.0,s->o_solution(name));
    initializeKernel(m->Nlocal,p.alphaInlet,p.ugInlet,p.ulInlet,p.initialPlumeHeight,
        p.initialPlumeThickness,m->o_z,s->o_solution("alpha"),s->o_solution("ugz"),s->o_solution("ulz"));
  }
  clipKernel(m->Nlocal,p.alphaMinimum,p.alphaMaximum,s->o_solution("alpha"));
  // Native scalar elliptic solvers are constructed after UDF_Setup. Boundary
  // application must wait until beginStep, when their masks are available.
  reconstructMixture(); // explicit-coefficient native Ax after solve; never use unbound elliptic op
  nrs->userSource=&beginStep;nrs->postScalar=&postAlpha;
  nrs->userConvergenceCheck=&singlePass;s->userImplicitLinearTerm=&implicitDrag;
  if(platform->comm.mpiRank()==0)
    printf("bubbleColumn3: seven scalars ALPHA UGX UGY UGZ ULX ULY ULZ; native velocity/pressure OFF; "
        "user phase convection ON; alpha -> UG/UL predictors -> shared P -> both phase corrections -> reconstructed UM; VM OFF\n");
}

void UDF_ExecuteStep(double time,int step)
{
  using namespace bubbleColumn3;
  if(step<=0) return;
  nekrsCheck(step!=preparedStep || step==completedStep || !nrs->timeStepConverged,
      platform->comm.mpiComm(),EXIT_FAILURE,"%s","Method3 deferred solve out of order.\n");
  solvePhasePredictors(time);
  reconstructMixture();solvePressureAndCorrect(time,step);
  completedStep=step;
  if(nrs->checkpointStep) {
    const auto O=nrs->fieldOffset,N=nrs->meshV->Nlocal;
    nrs->writeToFile("ug",time,nrs->meshV,{{"velocity",{ug.slice(0,N),ug.slice(O,N),ug.slice(2*O,N)}}});
    nrs->writeToFile("ul",time,nrs->meshV,{{"velocity",{ul.slice(0,N),ul.slice(O,N),ul.slice(2*O,N)}}});
  }
}
