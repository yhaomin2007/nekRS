// Volume velocity is a diagnostic/constraint field, never an evolved momentum.
@kernel void reconstruct(const dlong N, const dlong O,
    @restrict const dfloat *a, @restrict const dfloat *ug,
    @restrict const dfloat *ul, @restrict dfloat *um)
{
  for(dlong i=0;i<N;++i;@tile(p_blockSize,@outer,@inner)) {
    for(int c=0;c<3;++c) um[i+c*O]=a[i]*ug[i+c*O]+(1-a[i])*ul[i+c*O];
  }
}
@kernel void initialize(const dlong N, const dfloat ai, const dfloat ui,
    const dfloat li, const dfloat height, const dfloat width,
    @restrict const dfloat *z, @restrict dfloat *a,
    @restrict dfloat *gz, @restrict dfloat *lz)
{
  for(dlong i=0;i<N;++i;@tile(p_blockSize,@outer,@inner)) {
    const dfloat f=0.5*(1-tanh((z[i]-height)/width));
    a[i]=ai*f; gz[i]=ui*f; lz[i]=li;
  }
}
@kernel void clipAlpha(const dlong N, const dfloat lo, const dfloat hi,
    @restrict dfloat *a)
{
  for(dlong i=0;i<N;++i;@tile(p_blockSize,@outer,@inner)) a[i]=fmin(hi,fmax(lo,a[i]));
}
// Schiller-Naumann drag, equal and opposite force per unit mixture volume.
// Coefficients are lagged in slip and frozen after alpha transport; both
// partner loads are iterated to convergence with these implicit diagonals.
@kernel void drag(const dlong N, const dlong O, const dfloat enabled,
    const dfloat rg, const dfloat rl, const dfloat mu, const dfloat diameter,
    @restrict const dfloat *a, @restrict const dfloat *ug,
    @restrict const dfloat *ul, @restrict dfloat *lg, @restrict dfloat *ll)
{
  for(dlong i=0;i<N;++i;@tile(p_blockSize,@outer,@inner)) {
    dfloat w2=0;
    for(int c=0;c<3;++c) {const dfloat w=ug[i+c*O]-ul[i+c*O]; w2+=w*w;}
    const dfloat w=sqrt(w2), re=rl*w*diameter/mu;
    // Cd*|w| remains finite at zero slip.
    const dfloat cdw=(re<1000) ? 24*mu/(rl*diameter)*(1+0.15*pow(re,0.687)) : 0.44*w;
    const dfloat k=enabled*0.75*rl*cdw/diameter;
    lg[i]=k/rg;
    ll[i]=a[i]*k/((1-a[i])*rl);
  }
}
@kernel void phaseSource(const dlong N, const dlong O, const int component,
    const dfloat gravity, @restrict const dfloat *convection,
    @restrict dfloat *source)
{
  for(dlong i=0;i<N;++i;@tile(p_blockSize,@outer,@inner))
    source[i]=-convection[i+(component+1)*O]+gravity;
}
// Add the current frozen-coefficient partner load directly to the BDF RHS.
// It must not enter EXT history: both sides use the same timestep coefficient.
@kernel void addDragLoad(const dlong N, const dlong O, const int component,
    @restrict const dfloat *mass, @restrict const dfloat *lambda,
    @restrict const dfloat *partner, @restrict dfloat *rhs)
{
  for(dlong i=0;i<N;++i;@tile(p_blockSize,@outer,@inner))
    rhs[i]+=mass[i]*lambda[i]*partner[i+component*O];
}
@kernel void mobility(const dlong N, const dfloat tau,
    const dfloat rg, const dfloat rl, @restrict const dfloat *a,
    @restrict const dfloat *lg, @restrict const dfloat *ll,
    @restrict dfloat *bg, @restrict dfloat *bl, @restrict dfloat *bm)
{
  for(dlong i=0;i<N;++i;@tile(p_blockSize,@outer,@inner)) {
    // Invert the TWO-PHASE local inertia/drag block, not its diagonals.
    // [[1+tau*lg,-tau*lg],[-tau*ll,1+tau*ll]] * beta = tau*[1/rg,1/rl].
    const dfloat tg=tau*lg[i],tl=tau*ll[i],det=1+tg+tl;
    bg[i]=tau*((1+tl)/rg+tg/rl)/det;
    bl[i]=tau*(tl/rg+(1+tg)/rl)/det;
    bm[i]=a[i]*bg[i]+(1-a[i])*bl[i];
  }
}
@kernel void correct(const dlong N, const dlong O,
    @restrict const dfloat *beta, @restrict const dfloat *grad,
    @restrict dfloat *velocity)
{
  for(dlong i=0;i<N;++i;@tile(p_blockSize,@outer,@inner))
    for(int c=0;c<3;++c) velocity[i+c*O]-=beta[i]*grad[i+c*O];
}
// Adapted from fluidSolver_t::divergenceSurfaceHex3D: subtract prescribed
// volume flux on pressure-Neumann boundaries. ID 2 is p=0 (no surface load).
@kernel void pressureSurface(const dlong Nelements, const dlong O,
    @restrict const dfloat *sgeo, @restrict const dlong *vmapM,
    @restrict const int *EToB, @restrict const dfloat *um,
    @restrict dfloat *rhs)
{
  for(dlong e=0;e<Nelements;++e;@outer(0)) {
    for(int f=0;f<p_Nfaces;++f) {
      for(int n=0;n<p_Nfp;++n;@inner(0)) {
        const int bid=EToB[e*p_Nfaces+f];
        if(bid==1 || bid==3) {
          const dlong s=(e*p_Nfaces+f)*p_Nfp+n, i=vmapM[s];
          const dfloat flux=sgeo[s*p_Nsgeo+p_NXID]*um[i]
              +sgeo[s*p_Nsgeo+p_NYID]*um[i+O]
              +sgeo[s*p_Nsgeo+p_NZID]*um[i+2*O];
          // CUDA has atomicAdd(double*,double), but no floating atomicSub.
          // Retain the negative Neumann flux using atomic addition.
          @atomic rhs[i]+=(-sgeo[s*p_Nsgeo+p_WSJID]*flux);
        }
      }
    }
  }
}

// K_VM = C_VM rho_l alpha per mixture volume. Work in phase-mass units.
// Native BDF/EXT bases contain history/dt - material convection + gravity.
// Their difference cancels common gravity and gives the VM history load.
@kernel void virtualMass(const dlong N, const dfloat inverseTau,
    const dfloat cvm, const dfloat rg, const dfloat rl,
    @restrict const dfloat *alpha, @restrict dfloat *lg, @restrict dfloat *ll,
    @restrict const dfloat *materialG, @restrict const dfloat *materialL,
    @restrict dfloat *bg, @restrict dfloat *bl)
{
  for(dlong i=0;i<N;++i;@tile(p_blockSize,@outer,@inner)) {
    const dfloat vg=cvm*rl/rg, vl=cvm*alpha[i]/(1-alpha[i]);
    const dfloat difference=materialG[i]-materialL[i];
    bg[i]+=vg*difference;
    bl[i]-=vl*difference;
    // Called for each component, but the diagonal is changed only once.
    if(inverseTau>0) {lg[i]+=vg*inverseTau;ll[i]+=vl*inverseTau;}
  }
}
@kernel void viscousMobility(const dlong N, const dlong O, const dfloat inverseTau,
    const dfloat rg, const dfloat rl, @restrict const dfloat *alpha,
    @restrict const dfloat *lg, @restrict const dfloat *ll,
    @restrict const dfloat *invMass, @restrict const dfloat *diagG,
    @restrict const dfloat *diagL, @restrict dfloat *bg,
    @restrict dfloat *bl, @restrict dfloat *bm)
{
  for(dlong i=0;i<N;++i;@tile(p_blockSize,@outer,@inner)) {
    dfloat dg=0,dl=0;
    for(int c=0;c<3;++c) {dg+=diagG[i+c*O];dl+=diagL[i+c*O];}
    const dfloat ag=inverseTau+invMass[i]*dg/3;
    const dfloat al=inverseTau+invMass[i]*dl/3;
    const dfloat det=ag*al+ag*ll[i]+al*lg[i];
    bg[i]=((al+ll[i])/rg+lg[i]/rl)/det;
    bl[i]=(ll[i]/rg+(ag+lg[i])/rl)/det;
    bm[i]=alpha[i]*bg[i]+(1-alpha[i])*bl[i];
  }
}

@kernel void couplingBalance(const dlong N, const dlong O, const dfloat cvm,
    const dfloat rg, const dfloat rl, @restrict const dfloat *alpha,
    @restrict const dfloat *mass, @restrict const dfloat *lg, @restrict const dfloat *ll,
    @restrict const dfloat *ug, @restrict const dfloat *ul,
    @restrict const dfloat *baseG, @restrict const dfloat *baseL,
    @restrict dfloat *balance)
{
  for(dlong i=0;i<N;++i;@tile(p_blockSize,@outer,@inner)) {
    const dfloat vg=cvm*rl/rg,vl=cvm*alpha[i]/(1-alpha[i]);
    dfloat error=0,scale=0;
    for(int c=0;c<3;++c) {
      const dlong j=i+c*O;
      const dfloat historyDifference=baseG[j]-baseL[j];
      const dfloat slip=ul[j]-ug[j];
      const dfloat fg=alpha[i]*rg*(mass[i]*lg[i]*slip+vg*historyDifference);
      const dfloat fl=(1-alpha[i])*rl*(-mass[i]*ll[i]*slip-vl*historyDifference);
      error=fmax(error,fabs(fg+fl));
      scale=fmax(scale,fmax(fabs(fg),fabs(fl)));
    }
    balance[i]=(scale>0)?error/scale:0;
  }
}
