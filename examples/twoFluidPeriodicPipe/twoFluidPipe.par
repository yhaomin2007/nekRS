[GENERAL]
polynomialOrder = 5
stopAt = numSteps
numSteps = 20
dt = 1.0e-4
timeStepper = tombo1
checkpointInterval = 25

usr = "twoFluidPipe.usr"
udf = "twoFluidPipe.udf"

[MESH]
file = "../turbPipePeriodic/turbPipe.re2"

[FLUID PRESSURE]
residualTol = 1.0e-8

[FLUID VELOCITY]
boundaryTypeMap = zeroDirichlet
rho = 1000.0
viscosity = 1.0e-3
residualTol = 1.0e-9

[TWO FLUID]
gasVolumeFraction = 0.05
bubbleDiameter = 3.0e-3
gasDensity = 1.2
gasViscosity = 1.8e-5
gravityX = 0.0
gravityY = 0.0
gravityZ = 0.1
alphaFloor = 1.0e-8
dragMultiplier = 0.0
