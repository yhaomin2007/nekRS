[GENERAL]
polynomialOrder = 3
stopAt = numSteps
numSteps = 100
dt = 1e-4
timeStepper = tombo1
checkpointInterval = 20

[FLUID PRESSURE]
residualTol = 1e-10

[FLUID VELOCITY]
boundaryTypeMap = none
rho = 1000.0
viscosity = 1.0e-3
residualTol = 1e-11

[TWO FLUID]
gasVolumeFraction = 0.10
bubbleDiameter = 1.0e-3
gasDensity = 1.0
gasViscosity = 1.8e-5
gravityX = 0.0
gravityY = 0.0
gravityZ = 0.0
alphaFloor = 1e-8
