#ifdef __okl__

void udfDirichlet(bcData *bc)
{
  if (isField("fluid velocity")) {
    bc->uxFluid = 0.0;
    bc->uyFluid = 0.0;
    bc->uzFluid = 0.10;
  } else if (isField("gas velocity")) {
    bc->uxFluid = 0.0;
    bc->uyFluid = 0.0;
    bc->uzFluid = 0.15;
  } else if (isField("scalar alpha")) {
    bc->sScalar = 0.05;
  }
}

#endif

void UDF_Setup()
{
  std::vector<dfloat> liquidVelocity(3*nrs->fieldOffset, 0.0);
  std::vector<dfloat> gasVelocity(3*nrs->fieldOffset, 0.0);
  std::vector<dfloat> alpha(nrs->fieldOffset, 0.05);

  nrs->fluid->o_U.copyFrom(liquidVelocity.data(), liquidVelocity.size());
  nrs->gas->o_U.copyFrom(gasVelocity.data(), gasVelocity.size());
  nrs->scalar->o_solution("alpha").copyFrom(alpha.data(), alpha.size());
}

void UDF_ExecuteStep(double time, int tstep)
{
  auto mesh = nrs->meshV;
  const auto comm = platform->comm.mpiComm();
  const dfloat alphaMin = platform->linAlg->min(mesh->Nlocal,
                                                nrs->twoFluid->o_alphaG,
                                                comm);
  const dfloat alphaMax = platform->linAlg->max(mesh->Nlocal,
                                                nrs->twoFluid->o_alphaG,
                                                comm);
  const dfloat alphaMean = platform->linAlg->innerProd(mesh->Nlocal,
                                                       mesh->o_LMM,
                                                       nrs->twoFluid->o_alphaG,
                                                       comm)/mesh->volume;
  const dfloat l2Mixture = platform->linAlg->weightedNorm2(
      mesh->Nlocal,
      mesh->o_LMM,
      nrs->twoFluid->o_continuityResidual,
      comm)/sqrt(mesh->volume);
  const dfloat maxMixture = platform->linAlg->amax(
      mesh->Nlocal, nrs->twoFluid->o_continuityResidual, comm);
  const dfloat pressureMin = platform->linAlg->min(
      mesh->Nlocal, nrs->fluid->o_P, comm);
  const dfloat pressureMax = platform->linAlg->max(
      mesh->Nlocal, nrs->fluid->o_P, comm);
  const dfloat pressureMean = platform->linAlg->innerProd(
      mesh->Nlocal, mesh->o_LMM, nrs->fluid->o_P, comm)/mesh->volume;
  const dfloat liquidUzMean = platform->linAlg->innerProd(
      mesh->Nlocal, mesh->o_LMM,
      nrs->fluid->o_U.slice(2*nrs->fieldOffset), comm)/mesh->volume;
  const dfloat gasUzMean = platform->linAlg->innerProd(
      mesh->Nlocal, mesh->o_LMM,
      nrs->gas->o_U.slice(2*nrs->fieldOffset), comm)/mesh->volume;

  if (platform->comm.mpiRank() == 0) {
    printf("twoFluidInletOutlet step=%d time=%g alpha=[%.8e,%.8e] "
           "mean=%.8e meanUzL=%.8e meanUzG=%.8e "
           "p=[%.8e,%.8e] pMean=%.8e L2(Rm)=%.8e max|Rm|=%.8e\n",
           tstep, time, alphaMin, alphaMax, alphaMean,
           liquidUzMean, gasUzMean, pressureMin, pressureMax, pressureMean,
           l2Mixture, maxMixture);
  }
  nrs->twoFluid->reportContinuity();

  nekrsCheck(nrs->lastStep &&
                 (alphaMin < -1.0e-12 || alphaMax > 1.0 + 1.0e-12 ||
                  l2Mixture > 1.0e-5 || maxMixture > 1.0e-3),
             comm,
             EXIT_FAILURE,
             "inlet-outlet verification failed: alpha=[%g,%g] "
             "L2(Rm)=%g max|Rm|=%g\n",
             alphaMin, alphaMax, l2Mixture, maxMixture);
}
