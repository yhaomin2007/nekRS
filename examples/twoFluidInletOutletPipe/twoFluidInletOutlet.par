[GENERAL]
polynomialOrder = 3
stopAt = numSteps
numSteps = 20
dt = 1.0e-4
timeStepper = tombo1
checkpointInterval = 20
scalars = alpha

udf = "twoFluidInletOutlet.udf"

[MESH]
file = "../turbPipe/turbPipe.re2"

[FLUID PRESSURE]
residualTol = 1.0e-8

[FLUID VELOCITY]
boundaryTypeMap = udfDirichlet, zeroNeumann, zeroDirichlet
rho = 1000.0
viscosity = 1.0e-3
residualTol = 1.0e-9

[SCALAR ALPHA]
transportCoeff = 1.0
diffusionCoeff = 1.0e-5
boundaryTypeMap = udfDirichlet, zeroNeumann, zeroNeumann
residualTol = 1.0e-10

[TWO FLUID]
nativeAlphaScalar = true
gasBoundaryTypeMap = udfDirichlet, zeroNeumann, zeroDirichlet
gasVolumeFraction = 0.05
bubbleDiameter = 3.0e-3
gasDensity = 1000.0
gasViscosity = 1.0e-3
gravityX = 0.0
gravityY = 0.0
gravityZ = 0.0
alphaFloor = 1.0e-8
alphaDiffusivity = 1.0e-5
dragMultiplier = 0.0
mixtureContinuityTolerance = 1.0e-6
couplingIterations = 1
pressureCorrectors = 1
