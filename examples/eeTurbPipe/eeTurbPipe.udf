#include "tavg.hpp"
#include "planarCopy.hpp"
#include <cmath>

static int NSLABS;
static int NELSLAB;
static int processAscentYamlFrequency;

static deviceMemory<int> o_bID;
static planarCopy *recyc = nullptr;
static dfloat inletArea = 0.0;

// Milestone-1 gas momentum state. These buffers deliberately do not alias the
// native liquid velocity solver state. Follow-up commits will switch each gas
// predictor/solve operation onto these buffers before the mixture pressure
// projection is introduced.
static deviceMemory<dfloat> o_UgHistory;
static deviceMemory<dfloat> o_Uge;
static deviceMemory<dfloat> o_ADVg;
static deviceMemory<dfloat> o_EXTg;
static deviceMemory<dfloat> o_JwFg;
static deviceMemory<dfloat> o_relUrstg;

#ifdef __okl__
void udfDirichlet(bcData *bc)
{
  if (isField("fluid velocity")) {
    bc->uxFluid = bc->usrwrk[bc->idxVol + 0 * bc->fieldOffset];
    bc->uyFluid = bc->usrwrk[bc->idxVol + 1 * bc->fieldOffset];
    bc->uzFluid = bc->usrwrk[bc->idxVol + 2 * bc->fieldOffset];
  } else if (isField("fluid pressure")) {
    const dfloat iU0delta = 20.0;
    const dfloat un = bc->uxFluid * bc->nx + bc->uyFluid * bc->ny + bc->uzFluid * bc->nz;
    const dfloat s0 = 0.5 * (1.0 - tanh(un * iU0delta));
    bc->pFluid = -0.5 * (bc->uxFluid * bc->uxFluid + bc->uyFluid * bc->uyFluid + bc->uzFluid * bc->uzFluid) * s0;
  }
}
#endif

void UDF_Setup0(MPI_Comm comm, setupAide &options)
{
  platform->par->extract("casedata", "nslabs", NSLABS);
  platform->par->extract("casedata", "nelslab", NELSLAB);
  platform->par->extract("casedata", "processAscentYamlFrequency", processAscentYamlFrequency);
}

// First E-E reduction test: solve a second velocity field with the same
// momentum operator, coefficients, pressure and BC topology as the standard
// NekRS liquid velocity. The predictor forcing is still shared in this
// checkpoint; dedicated gas histories/forcing buffers are now allocated and
// will replace those aliases incrementally.
static void solveGasVelocity(double time)
{
  auto fluid = nrs->fluid.get();
  auto mesh = fluid->mesh;

  if (!nrs->o_Ug.isInitialized() || fluid->ellipticSolver.empty()) {
    return;
  }

  const auto fieldOffset = fluid->fieldOffset;
  const auto fieldOffsetSum = fluid->fieldOffsetSum;
  const auto g0idt = *fluid->g0 / fluid->dt[0];

  auto o_mueDiv = platform->deviceMemoryPool.reserve<dfloat>(fieldOffset);
  platform->linAlg->axmyz(mesh->Nlocal, 1.0 / 3.0, fluid->o_mue, fluid->o_div, o_mueDiv);

  auto o_gradMueDiv = platform->deviceMemoryPool.reserve<dfloat>(fieldOffsetSum);
  launchKernel("core-gradientVolumeHex3D",
               mesh->Nelements,
               mesh->o_vgeo,
               mesh->o_D,
               fieldOffset,
               o_mueDiv,
               o_gradMueDiv);

  auto o_gradP = platform->deviceMemoryPool.reserve<dfloat>(fieldOffsetSum);
  launchKernel("core-wGradientVolumeHex3D",
               mesh->Nelements,
               mesh->o_vgeo,
               mesh->o_D,
               fieldOffset,
               fluid->o_P,
               o_gradP);

  auto o_rhs = platform->deviceMemoryPool.reserve<dfloat>(fieldOffsetSum);
  launchKernel("fluidSolver_t::velocityRhsHex3D",
               mesh->Nlocal,
               fieldOffset,
               fluid->o_rho,
               fluid->o_JwF,
               o_gradMueDiv,
               o_gradP,
               o_rhs);

  launchKernel("fluidSolver_t::velocityNeumannBCHex3D",
               fluid->o_velocityName,
               fluid->o_pressureName,
               mesh->Nelements,
               fieldOffset,
               mesh->o_sgeo,
               mesh->o_vmapM,
               mesh->o_EToB,
               fluid->o_EToB,
               time,
               mesh->o_x,
               mesh->o_y,
               mesh->o_z,
               fluid->o_rho,
               fluid->o_mue,
               platform->app->bc->o_usrwrk,
               fluid->o_Ue,
               o_rhs);

  int component = 0;
  for (auto *solver : fluid->ellipticSolver) {
    if (solver->Nmasked()) {
      const auto offset = (fluid->ellipticSolver.size() == 1) ? 0 : component * fieldOffset;
      launchKernel("core-maskCopy",
                   solver->Nmasked(),
                   offset,
                   offset,
                   solver->o_maskIds(),
                   fluid->o_U,
                   nrs->o_Ug);
    }
    component++;
  }

  auto o_lambda1 = platform->deviceMemoryPool.reserve<dfloat>(mesh->Nlocal);
  platform->linAlg->axpby(mesh->Nlocal, g0idt, fluid->o_rho, 0.0, o_lambda1);

  if (fluid->ellipticSolver.at(0)->Nfields() > 1) {
    fluid->ellipticSolver.at(0)->solve(fluid->o_mue,
                                       o_lambda1,
                                       o_rhs,
                                       nrs->o_Ug.slice(0, fieldOffsetSum));
  } else {
    const auto o_rhsX = o_rhs.slice(0 * fieldOffset, mesh->Nlocal);
    const auto o_rhsY = o_rhs.slice(1 * fieldOffset, mesh->Nlocal);
    const auto o_rhsZ = o_rhs.slice(2 * fieldOffset, mesh->Nlocal);
    fluid->ellipticSolver.at(0)->solve(fluid->o_mue,
                                       o_lambda1,
                                       o_rhsX,
                                       nrs->o_Ug.slice(0 * fieldOffset, mesh->Nlocal));
    fluid->ellipticSolver.at(1)->solve(fluid->o_mue,
                                       o_lambda1,
                                       o_rhsY,
                                       nrs->o_Ug.slice(1 * fieldOffset, mesh->Nlocal));
    fluid->ellipticSolver.at(2)->solve(fluid->o_mue,
                                       o_lambda1,
                                       o_rhsZ,
                                       nrs->o_Ug.slice(2 * fieldOffset, mesh->Nlocal));
  }
}

static void updateRecyclingBoundary()
{
  if (!recyc) {
    return;
  }

  auto mesh = nrs->meshV;
  recyc->execute();

  const auto flux = mesh->surfaceAreaNormalMultiplyVectorIntegrate(
      nrs->fluid->fieldOffset,
      o_bID,
      platform->app->bc->o_usrwrk);

  const dfloat uBulk = 1.0;
  platform->linAlg->scale(nrs->fluid->fieldOffsetSum,
                          -uBulk * inletArea / flux,
                          platform->app->bc->o_usrwrk);
}

static void initializeGasSolverState()
{
  auto fluid = nrs->fluid.get();
  auto mesh = fluid->mesh;
  const auto fieldOffsetSum = fluid->fieldOffsetSum;

  const int nHist = std::max(static_cast<int>(nrs->o_coeffBDF.size()),
                             static_cast<int>(nrs->o_coeffEXT.size()));
  const int nEXT = static_cast<int>(nrs->o_coeffEXT.size());

  o_UgHistory.resize(std::max(1, nHist) * fieldOffsetSum);
  o_Uge.resize(fieldOffsetSum);
  o_ADVg.resize(std::max(1, nEXT) * fieldOffsetSum);
  o_EXTg.resize(std::max(1, nEXT) * fieldOffsetSum);
  o_JwFg.resize(fieldOffsetSum);

  // Subcycling stores the contravariant convecting velocity on the cubature
  // grid. Allocate the same amount of state as the native fluid solver but do
  // not alias fluid->o_relUrst.
  const auto nUrstStates = std::max(1, nHist);
  o_relUrstg.resize(nUrstStates * mesh->dim * fluid->cubatureOffset);

  platform->linAlg->fill(o_ADVg.size(), 0.0, o_ADVg);
  platform->linAlg->fill(o_EXTg.size(), 0.0, o_EXTg);
  platform->linAlg->fill(o_JwFg.size(), 0.0, o_JwFg);
  platform->linAlg->fill(o_relUrstg.size(), 0.0, o_relUrstg);
}

static void seedGasHistoryFromLiquid()
{
  auto fluid = nrs->fluid.get();
  const auto fieldOffsetSum = fluid->fieldOffsetSum;
  const int nHist = std::max(static_cast<int>(nrs->o_coeffBDF.size()),
                             static_cast<int>(nrs->o_coeffEXT.size()));

  nrs->o_Ug.copyFrom(fluid->o_U, fieldOffsetSum);
  o_Uge.copyFrom(nrs->o_Ug, fieldOffsetSum);
  for (int s = 0; s < std::max(1, nHist); ++s) {
    o_UgHistory.copyFrom(nrs->o_Ug, fieldOffsetSum, s * fieldOffsetSum, 0);
  }
}

void UDF_Setup()
{
  auto mesh = nrs->meshV;
  const auto zLen = std::abs(platform->linAlg->max(mesh->Nlocal, mesh->o_z, platform->comm.mpiComm()) -
                             platform->linAlg->min(mesh->Nlocal, mesh->o_z, platform->comm.mpiComm()));

  std::vector<dfloat> x(mesh->Nlocal);
  std::vector<dfloat> y(mesh->Nlocal);
  std::vector<dfloat> z(mesh->Nlocal);
  mesh->o_x.copyTo(x.data());
  mesh->o_y.copyTo(y.data());
  mesh->o_z.copyTo(z.data());

  if (platform->options.getArgs("RESTART FILE NAME").empty()) {
    auto rand = randomVector<dfloat>(mesh->Nlocal, -1.0, 1.0, true);
    std::vector<dfloat> U(mesh->dim * nrs->fluid->fieldOffset, 0.0);
    for (int n = 0; n < mesh->Nlocal; n++) {
      const auto R = 0.5;
      const auto xr = x[n] / R;
      const auto yr = y[n] / R;
      const auto zo = 2 * M_PI * z[n] / zLen;
      auto rr = xr * xr + yr * yr;
      rr = (rr > 0) ? std::sqrt(rr) : 0.0;
      const auto th = std::atan2(y[n], x[n]);
      auto uz = 6.0 / 5.0 * (1 - std::pow(rr, 6));
      const auto phase_z = 0.35 * 2 * M_PI * std::sin(4.0 * zo);
      auto amp_sin = 5.0 * std::sin(9.0 * th + phase_z);
      if (amp_sin > 0.2) amp_sin = 0.2;
      if (amp_sin < -0.2) amp_sin = -0.2;
      if (rr > 0.93) uz += amp_sin;
      U[n + 0 * nrs->fluid->fieldOffset] = 0.05 * std::pow(rand[n], 2);
      U[n + 1 * nrs->fluid->fieldOffset] = 0.1 * std::pow(rand[n], 3);
      U[n + 2 * nrs->fluid->fieldOffset] = uz + 0.01 * rand[n];
    }
    nrs->fluid->o_solution().copyFrom(U.data(), U.size());
  }

  platform->app->bc->o_usrwrk.resize(mesh->dim * nrs->fluid->fieldOffset);

  const dfloat zRecycLayer = 0.25 * zLen;
  std::vector<int> bID{1};
  o_bID.resize(bID.size());
  o_bID.copyFrom(bID);

  deviceMemory<dfloat> o_tmp(mesh->Nlocal);
  platform->linAlg->fill(o_tmp.size(), 1.0, o_tmp);
  inletArea = mesh->surfaceAreaMultiplyIntegrate(o_bID, o_tmp);

  recyc = new planarCopy(mesh,
                         nrs->fluid->o_solution(),
                         mesh->dim,
                         nrs->fluid->fieldOffset,
                         0.0,
                         0.0,
                         zRecycLayer,
                         bID[0],
                         platform->app->bc->o_usrwrk);

  nrs->o_Ug.resize(nrs->fluid->fieldOffsetSum);
  nrs->o_Ug.copyFrom(nrs->fluid->o_U, nrs->fluid->fieldOffsetSum);
  initializeGasSolverState();

  nrs->preFluid = [](double time, int tstep) {
    static bool gasInitializedFromProjectedLiquid = false;
    if (!gasInitializedFromProjectedLiquid) {
      seedGasHistoryFromLiquid();
      gasInitializedFromProjectedLiquid = true;

      if (platform->comm.mpiRank() == 0) {
        std::cout << "eeTurbPipe: initialized independent u_g and gas history state from projected u_l" << std::endl;
      }
    }
  };

  // Do not register u_g with the legacy Nek checkpoint writer in this
  // reduction test: iofldNek only accepts its built-in variable names.
  // The CI regression validates u_g through the per-step norms below.
}

void UDF_ExecuteStep(double time, int tstep)
{
  // Match turbPipe's recycling workflow. The tstep=0 execute prepares the
  // prescribed inlet field before the first physical solve.
  if (tstep == 0) {
    updateRecyclingBoundary();
    return;
  }

  // Solve u_g before refreshing usrwrk so the gas solve sees the same recycled
  // boundary data that was used by the just-completed liquid solve.
  solveGasVelocity(time);

  auto mesh = nrs->fluid->mesh;
  auto o_diff = platform->deviceMemoryPool.reserve<dfloat>(nrs->fluid->fieldOffsetSum);
  o_diff.copyFrom(nrs->o_Ug, nrs->fluid->fieldOffsetSum);
  platform->linAlg->axpbyMany(mesh->Nlocal,
                              mesh->dim,
                              nrs->fluid->fieldOffset,
                              -1.0,
                              nrs->fluid->o_U,
                              1.0,
                              o_diff);

  const auto diffL2 = platform->linAlg->weightedNorm2Many(mesh->Nlocal,
                                                          mesh->dim,
                                                          nrs->fluid->fieldOffset,
                                                          mesh->o_LMM,
                                                          o_diff,
                                                          platform->comm.mpiComm());
  const auto liquidL2 = platform->linAlg->weightedNorm2Many(mesh->Nlocal,
                                                            mesh->dim,
                                                            nrs->fluid->fieldOffset,
                                                            mesh->o_LMM,
                                                            nrs->fluid->o_U,
                                                            platform->comm.mpiComm());
  const auto relL2 = diffL2 / std::max(liquidL2, static_cast<dfloat>(1e-30));

  platform->linAlg->abs(nrs->fluid->fieldOffsetSum, o_diff);
  const auto maxDiff = platform->linAlg->max(nrs->fluid->fieldOffsetSum,
                                              o_diff,
                                              platform->comm.mpiComm());

  if (platform->comm.mpiRank() == 0) {
    if (tstep == 1) {
      std::cout << "eeTurbPipe: fixed alpha_g=0.1, alpha_l=0.9; fluid->o_U is u_l; nrs->o_Ug is independently solved u_g"
                << std::endl;
      std::cout << "eeTurbPipe: dedicated gas history/extrapolation/advection/explicit/JwF/Urst buffers allocated"
                << std::endl;
    }
    std::cout << "eeTurbPipe: step=" << tstep
              << " ug-ul relL2=" << relL2
              << " maxAbs=" << maxDiff << std::endl;
  }

  // Prepare the recycled inlet data for the next physical timestep, exactly
  // as the reference turbPipe example does.
  updateRecyclingBoundary();
}
