userSections = CASEDATA

[GENERAL]
polynomialOrder = 7
stopAt = endTime
# Short CI regression run: approximately 50 steps from the initial dt=6e-3.
endTime = 0.30
timeStepper = tombo2
dt = targetCFL=4 + max=1e-2 + initial=6e-3
checkpointControl = simulationTime
checkpointInterval = 10
regularization = hpfrt + nModes=1 + scalingCoeff=10

[FLUID PRESSURE]
residualTol = 1e-04

[FLUID VELOCITY]
boundaryTypeMap = udfDirichlet, zeroNeumann, zeroDirichlet
rho = 1.0
viscosity = 1/19000
residualTol = 1e-06

[CASEDATA]
NSLABS = 60
NELSLAB = 132
processAscentYamlFrequency = 100
EE_MODE = true
ALPHA_G = 0.1
ALPHA_L = 0.9
EE_IDENTICAL_PHASE_TEST = true
