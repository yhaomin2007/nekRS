@kernel void initializePhaseVelocities(
    const dlong N,
    const dlong offset,
    const dfloat gasAmplitude,
    const dfloat liquidAmplitude,
    const dfloat xOrigin,
    const dfloat yOrigin,
    const dfloat xLength,
    const dfloat yLength,
    @ restrict const dfloat *x,
    @ restrict const dfloat *y,
    @ restrict dfloat *ug,
    @ restrict dfloat *ul)
{
  for (dlong n = 0; n < N; ++n; @tile(p_blockSize, @outer, @inner)) {
    const dfloat twoPi = 6.283185307179586476925286766559;
    const dfloat kx = twoPi / xLength;
    const dfloat ky = twoPi / yLength;
    const dfloat sx = sin(kx * (x[n] - xOrigin));
    const dfloat sy = sin(ky * (y[n] - yOrigin));

    ug[n + 0 * offset] = gasAmplitude * sx;
    ug[n + 1 * offset] = 0.0;
    ug[n + 2 * offset] = 0.0;

    ul[n + 0 * offset] = 0.0;
    ul[n + 1 * offset] = liquidAmplitude * sy;
    ul[n + 2 * offset] = 0.0;
  }
}

@kernel void buildMomentumRhs(
    const dlong N,
    const dlong offset,
    const dfloat rhoOverDt,
    @ restrict const dfloat *LMM,
    @ restrict const dfloat *uOld,
    @ restrict dfloat *rhs)
{
  for (dlong n = 0; n < N; ++n; @tile(p_blockSize, @outer, @inner)) {
    const dfloat coeff = LMM[n] * rhoOverDt;
    for (int i = 0; i < 3; ++i) {
      rhs[n + i * offset] = coeff * uOld[n + i * offset];
    }
  }
}

@kernel void buildMixture(
    const dlong N,
    const dlong offset,
    const dfloat alphaGas,
    @ restrict const dfloat *ug,
    @ restrict const dfloat *ul,
    @ restrict dfloat *um)
{
  for (dlong n = 0; n < N; ++n; @tile(p_blockSize, @outer, @inner)) {
    const dfloat alphaLiquid = 1.0 - alphaGas;
    for (int i = 0; i < 3; ++i) {
      um[n + i * offset] =
          alphaGas * ug[n + i * offset]
          + alphaLiquid * ul[n + i * offset];
    }
  }
}

@kernel void buildPressureForcingWeak(
    const dlong N,
    const dlong offset,
    const dfloat invDt,
    const dfloat nu,
    @ restrict const dfloat *LMM,
    @ restrict const dfloat *uOld,
    @ restrict const dfloat *curlCurlWeak,
    @ restrict dfloat *forcingWeak)
{
  for (dlong n = 0; n < N; ++n; @tile(p_blockSize, @outer, @inner)) {
    for (int i = 0; i < 3; ++i) {
      const dlong id = n + i * offset;
      forcingWeak[id] =
          invDt * LMM[n] * uOld[id]
          - nu * curlCurlWeak[id];
    }
  }
}

@kernel void buildViscousPressureForcing(
    const dlong N,
    const dlong offset,
    const dfloat alphaGas,
    const dfloat alphaLiquid,
    const dfloat invDt,
    @ restrict const dfloat *ug,
    @ restrict const dfloat *ul,
    @ restrict const dfloat *pressureForcingMixture,
    @ restrict dfloat *viscousPressureForcingMixture)
{
  for (dlong n = 0; n < N; ++n; @tile(p_blockSize, @outer, @inner)) {
    for (int i = 0; i < 3; ++i) {
      const dlong id = n + i * offset;
      const dfloat transientMixture =
          invDt * (alphaGas * ug[id] + alphaLiquid * ul[id]);
      viscousPressureForcingMixture[id] =
          pressureForcingMixture[id] - transientMixture;
    }
  }
}
