userSections = CASEDATA

[GENERAL]
polynomialOrder = 5
stopAt = numSteps
numSteps = 5
dt = 1.0e-3
timeStepper = tombo1
checkpointInterval = 1

[PROBLEMTYPE]
equation = Stokes

[FLUID PRESSURE]
residualTol = 1.0e-12
solver = cg + flexible
preconditioner = multigrid

[FLUID VELOCITY]
boundaryTypeMap = none
residualTol = 1.0e-12
rho = 1.0
viscosity = 1.0e-6

[CASEDATA]
alphaGas = 0.20
rhoGas = 1.20
rhoLiquid = 998.20

# Dynamic viscosities used by the two custom phase Helmholtz predictors.
muGas = 1.80e-5
muLiquid = 1.00e-3

gasAmplitude = 0.20
liquidAmplitude = 0.10


xOrigin = -0.05
yOrigin = -0.05
xLength = 0.10
yLength = 0.10
