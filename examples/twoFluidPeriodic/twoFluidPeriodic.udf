#ifdef __okl__

#endif

#include <algorithm>
#include <cmath>
#include <vector>

#include "opSEM.hpp"
#include "registerKernels.hpp"

namespace twoFluidPeriodic
{
struct Parameters {
  dfloat alphaGas = 0.2;
  dfloat rhoGas = 1.2;
  dfloat rhoLiquid = 998.2;
  dfloat muGas = 1.8e-5;
  dfloat muLiquid = 1.0e-3;
  dfloat gasAmplitude = 0.20;
  dfloat liquidAmplitude = 0.10;
  dfloat xOrigin = -0.05;
  dfloat yOrigin = -0.05;
  dfloat xLength = 0.10;
  dfloat yLength = 0.10;
};

static Parameters p;

static deviceMemory<dfloat> o_ug;
static deviceMemory<dfloat> o_ul;
static deviceMemory<dfloat> o_uPressurePredictor;
static deviceMemory<dfloat> o_uCorrected;
static deviceMemory<dfloat> o_gradP;

static deviceMemory<dfloat> o_lambdaP;
static deviceMemory<dfloat> o_rhsP;
static deviceMemory<dfloat> o_divPressurePredictor;
static deviceMemory<dfloat> o_divPost;

static deviceMemory<dfloat> o_lambda0Gas;
static deviceMemory<dfloat> o_lambda1Gas;
static deviceMemory<dfloat> o_lambda0Liquid;
static deviceMemory<dfloat> o_lambda1Liquid;
static deviceMemory<dfloat> o_rhsGas;
static deviceMemory<dfloat> o_rhsLiquid;
static deviceMemory<dfloat> o_pressureLoad;

static elliptic *gasMomentumSolver = nullptr;
static elliptic *liquidMomentumSolver = nullptr;

static occa::kernel initializePhaseVelocitiesKernel;
static occa::kernel buildMixtureKernel;
static occa::kernel buildMomentumRhsKernel;

inline void registerKernels(deviceKernelProperties &kernelInfo)
{
  const std::string request = "twoFluidPeriodic::equations";
  const std::string fileName = "twoFluidPeriodicEquations.okl";

  if (platform->options.compareArgs("REGISTER ONLY", "TRUE")) {
    platform->kernelRequests.add(request, fileName, kernelInfo);
  } else {
    initializePhaseVelocitiesKernel =
        platform->kernelRequests.load(request, "initializePhaseVelocities");
    buildMixtureKernel =
        platform->kernelRequests.load(request, "buildMixture");
    buildMomentumRhsKernel =
        platform->kernelRequests.load(request, "buildMomentumRhs");
  }
}

inline void allocate()
{
  const dlong offset = nrs->fieldOffset;

  o_ug.resize(3 * offset);
  o_ul.resize(3 * offset);
  o_uPressurePredictor.resize(3 * offset);
  o_uCorrected.resize(3 * offset);
  o_gradP.resize(3 * offset);

  o_lambdaP.resize(offset);
  o_rhsP.resize(offset);
  o_divPressurePredictor.resize(offset);
  o_divPost.resize(offset);

  o_lambda0Gas.resize(offset);
  o_lambda1Gas.resize(offset);
  o_lambda0Liquid.resize(offset);
  o_lambda1Liquid.resize(offset);
  o_rhsGas.resize(3 * offset);
  o_rhsLiquid.resize(3 * offset);
  o_pressureLoad.resize(3 * offset);
}

inline void initialize()
{
  auto mesh = nrs->meshV;
  initializePhaseVelocitiesKernel(mesh->Nlocal,
                                  nrs->fieldOffset,
                                  p.gasAmplitude,
                                  p.liquidAmplitude,
                                  p.xOrigin,
                                  p.yOrigin,
                                  p.xLength,
                                  p.yLength,
                                  mesh->o_x,
                                  mesh->o_y,
                                  o_ug,
                                  o_ul);
}

inline void setupPhaseMomentumSolvers()
{
  if (gasMomentumSolver && liquidMomentumSolver) {
    return;
  }

  auto mesh = nrs->meshV;
  const dfloat g0idt = nrs->g0 / nrs->dt[0];

  platform->linAlg->fill(mesh->Nlocal, p.muGas, o_lambda0Gas);
  platform->linAlg->fill(mesh->Nlocal, p.rhoGas * g0idt, o_lambda1Gas);
  platform->linAlg->fill(mesh->Nlocal, p.muLiquid, o_lambda0Liquid);
  platform->linAlg->fill(mesh->Nlocal, p.rhoLiquid * g0idt, o_lambda1Liquid);

  std::vector<int> EToB(mesh->Nelements * mesh->Nfaces, ellipticBcType::NO_OP);

  gasMomentumSolver = new elliptic(
      "ug", mesh, nrs->fieldOffset, EToB, o_lambda0Gas, o_lambda1Gas);
  liquidMomentumSolver = new elliptic(
      "ul", mesh, nrs->fieldOffset, EToB, o_lambda0Liquid, o_lambda1Liquid);
}

inline void neutralizeNativeFluid(double, int)
{
  const dlong offset = nrs->fieldOffset;
  platform->linAlg->fill(3 * offset, 0.0, nrs->fluid->o_U);
  platform->linAlg->fill(3 * offset, 0.0, nrs->fluid->o_JwF);
  platform->linAlg->fill(offset, 0.0, nrs->fluid->o_P);
}

inline dfloat rms(deviceMemory<dfloat> field)
{
  auto mesh = nrs->meshV;
  const dfloat l2 = platform->linAlg->weightedNorm2(
      mesh->Nlocal, mesh->o_LMM, field, platform->comm.mpiComm());
  return l2 / std::sqrt(mesh->volume);
}

// NekRS-native ordering for the simplified two-fluid Stokes prototype:
//
//  1. Build the pressure predictor from the phase velocities / explicit
//     forcing, before the implicit viscous Helmholtz solves.
//  2. Solve one common pressure equation using the transient pressure response.
//  3. Insert the NekRS weak pressure-gradient load directly into each phase
//     momentum RHS.
//  4. Solve the FINAL gas and liquid Helmholtz equations with viscosity and
//     pressure present in the same solve.
//
// This intentionally follows the native pressure-before-velocity-Helmholtz
// splitting.  It is not an exact monolithic Schur complement.
inline void project(double time, int tstep)
{
  setupPhaseMomentumSolvers();

  auto mesh = nrs->meshV;
  const dlong offset = nrs->fieldOffset;
  const dfloat alpha = p.alphaGas;
  const dfloat beta = 1.0 - alpha;
  const dfloat invDt = 1.0 / nrs->dt[0];
  const dfloat g0idt = nrs->g0 * invDt;
  const dfloat dtOverG0 = nrs->dt[0] / nrs->g0;

  // Keep the phase Helmholtz operators synchronized with the current timestep:
  //
  //   A_k = (rho_k*g0/dt) M + mu_k K.
  platform->linAlg->fill(mesh->Nlocal, p.muGas, o_lambda0Gas);
  platform->linAlg->fill(mesh->Nlocal, p.rhoGas * g0idt, o_lambda1Gas);
  platform->linAlg->fill(mesh->Nlocal, p.muLiquid, o_lambda0Liquid);
  platform->linAlg->fill(mesh->Nlocal, p.rhoLiquid * g0idt, o_lambda1Liquid);

  // Pressure predictor.  For tombo1 and this Stokes test the explicit/transient
  // state is simply the current phase velocity.  This is the two-fluid analogue
  // of forming the native NekRS pressure RHS before the implicit velocity
  // Helmholtz solve.
  buildMixtureKernel(mesh->Nlocal,
                     offset,
                     alpha,
                     o_ug,
                     o_ul,
                     o_uPressurePredictor);

  opSEM::strongDivergence(
      mesh, offset, o_uPressurePredictor, o_divPressurePredictor);

  // Transient two-fluid pressure response:
  //
  // lambda_p = dt/g0 * [alpha/rho_g + (1-alpha)/rho_l].
  //
  // The viscous operators are NOT folded into a local pressure mobility.
  // Instead, viscosity is handled in the final phase Helmholtz solves below,
  // exactly in the spirit of native NekRS splitting.
  const dfloat lambdaP =
      dtOverG0 * (alpha / p.rhoGas + beta / p.rhoLiquid);
  platform->linAlg->fill(mesh->Nlocal, lambdaP, o_lambdaP);

  launchKernel("core-wDivergenceVolumeHex3D",
               mesh->Nelements,
               mesh->o_vgeo,
               mesh->o_D,
               offset,
               o_uPressurePredictor,
               o_rhsP);

  nrs->fluid->ellipticSolverP->solve(
      o_lambdaP,
      o_NULL,
      o_rhsP,
      nrs->fluid->o_P.slice(0, mesh->Nlocal));

  // Native NekRS uses the weak pressure-gradient load in the velocity RHS.
  launchKernel("core-wGradientVolumeHex3D",
               mesh->Nelements,
               mesh->o_vgeo,
               mesh->o_D,
               offset,
               nrs->fluid->o_P,
               o_pressureLoad);

  // Non-pressure transient phase RHS.
  buildMomentumRhsKernel(mesh->Nlocal,
                         offset,
                         p.rhoGas * invDt,
                         mesh->o_LMM,
                         o_ug,
                         o_rhsGas);
  buildMomentumRhsKernel(mesh->Nlocal,
                         offset,
                         p.rhoLiquid * invDt,
                         mesh->o_LMM,
                         o_ul,
                         o_rhsLiquid);

  // Add the SAME common weak pressure load to both phase momentum equations:
  //
  //   A_g u_g^{n+1} = H_g + G_w p
  //   A_l u_l^{n+1} = H_l + G_w p.
  //
  // Since A_k contains mu_k K, the pressure response now passes through the
  // full phase Helmholtz operator instead of being appended afterward as
  // -(dt/rho_k) grad(p).
  platform->linAlg->axpbyMany(
      mesh->Nlocal, 3, offset, 1.0, o_pressureLoad, 1.0, o_rhsGas);
  platform->linAlg->axpbyMany(
      mesh->Nlocal, 3, offset, 1.0, o_pressureLoad, 1.0, o_rhsLiquid);

  int gasIterations = 0;
  int liquidIterations = 0;
  dfloat gasResidualMax = 0.0;
  dfloat liquidResidualMax = 0.0;

  for (int i = 0; i < 3; ++i) {
    gasMomentumSolver->solve(
        o_lambda0Gas,
        o_lambda1Gas,
        o_rhsGas.slice(i * offset, mesh->Nlocal),
        o_ug.slice(i * offset, mesh->Nlocal));
    gasIterations += gasMomentumSolver->Niter();
    gasResidualMax =
        std::max(gasResidualMax, gasMomentumSolver->finalResidual());

    liquidMomentumSolver->solve(
        o_lambda0Liquid,
        o_lambda1Liquid,
        o_rhsLiquid.slice(i * offset, mesh->Nlocal),
        o_ul.slice(i * offset, mesh->Nlocal));
    liquidIterations += liquidMomentumSolver->Niter();
    liquidResidualMax =
        std::max(liquidResidualMax, liquidMomentumSolver->finalResidual());
  }

  buildMixtureKernel(mesh->Nlocal,
                     offset,
                     alpha,
                     o_ug,
                     o_ul,
                     o_uCorrected);

  opSEM::strongDivergence(mesh, offset, o_uCorrected, o_divPost);
  nrs->fluid->o_U.copyFrom(o_uCorrected, 3 * offset);

  // Physical strong gradient is only exported as a diagnostic.  The momentum
  // solve itself uses o_pressureLoad from the native weak-gradient kernel.
  opSEM::strongGrad(mesh, offset, nrs->fluid->o_P, o_gradP);

  const dfloat preRms = rms(o_divPressurePredictor);
  const dfloat postRms = rms(o_divPost);
  const dfloat reduction =
      postRms / std::max(preRms, static_cast<dfloat>(1.0e-30));

  if (platform->comm.mpiRank() == 0) {
    printf("twoFluidPeriodic nekrsNative step=%d time=%.8e alpha=%.6e "
           "lambdaP=%.8e divPressureRMS=%.8e divPostRMS=%.8e "
           "divRatio=%.8e pIters=%d pResidual=%.8e "
           "ugIters=%d ugResidualMax=%.8e "
           "ulIters=%d ulResidualMax=%.8e\n",
           tstep,
           time,
           alpha,
           lambdaP,
           preRms,
           postRms,
           reduction,
           nrs->fluid->ellipticSolverP->Niter(),
           nrs->fluid->ellipticSolverP->finalResidual(),
           gasIterations,
           gasResidualMax,
           liquidIterations,
           liquidResidualMax);
  }
}

inline void writeFields(double time)
{
  auto mesh = nrs->meshV;
  const dlong offset = nrs->fieldOffset;

  std::vector<deviceMemory<dfloat>> ug = {
      o_ug.slice(0 * offset, mesh->Nlocal),
      o_ug.slice(1 * offset, mesh->Nlocal),
      o_ug.slice(2 * offset, mesh->Nlocal)};
  std::vector<deviceMemory<dfloat>> ul = {
      o_ul.slice(0 * offset, mesh->Nlocal),
      o_ul.slice(1 * offset, mesh->Nlocal),
      o_ul.slice(2 * offset, mesh->Nlocal)};
  std::vector<deviceMemory<dfloat>> up = {
      o_uPressurePredictor.slice(0 * offset, mesh->Nlocal),
      o_uPressurePredictor.slice(1 * offset, mesh->Nlocal),
      o_uPressurePredictor.slice(2 * offset, mesh->Nlocal)};
  std::vector<deviceMemory<dfloat>> uc = {
      o_uCorrected.slice(0 * offset, mesh->Nlocal),
      o_uCorrected.slice(1 * offset, mesh->Nlocal),
      o_uCorrected.slice(2 * offset, mesh->Nlocal)};
  std::vector<deviceMemory<dfloat>> gp = {
      o_gradP.slice(0 * offset, mesh->Nlocal),
      o_gradP.slice(1 * offset, mesh->Nlocal),
      o_gradP.slice(2 * offset, mesh->Nlocal)};

  nrs->writeToFile("ug", time, mesh, {{"velocity", ug}});
  nrs->writeToFile("ul", time, mesh, {{"velocity", ul}});
  nrs->writeToFile("upress", time, mesh, {{"velocity", up}});
  nrs->writeToFile("ucorr", time, mesh, {{"velocity", uc}});
  nrs->writeToFile("gradp", time, mesh, {{"velocity", gp}});
  nrs->writeToFile("tfdiag",
                   time,
                   mesh,
                   {{"scalar00", {o_divPressurePredictor.slice(0, mesh->Nlocal)}},
                    {"scalar01", {o_divPost.slice(0, mesh->Nlocal)}}});
}

} // namespace twoFluidPeriodic

void UDF_LoadKernels(deviceKernelProperties &kernelInfo)
{
  twoFluidPeriodic::registerKernels(kernelInfo);

  // Independent scalar non-Poisson Helmholtz kernels for the final gas and
  // liquid momentum solves.
  registerEllipticKernels("ug", false);
}

void UDF_Setup0(MPI_Comm, setupAide &)
{
  auto &p = twoFluidPeriodic::p;

  platform->par->extract("casedata", "alphagas", p.alphaGas);
  platform->par->extract("casedata", "rhogas", p.rhoGas);
  platform->par->extract("casedata", "rholiquid", p.rhoLiquid);
  platform->par->extract("casedata", "mugas", p.muGas);
  platform->par->extract("casedata", "muliquid", p.muLiquid);
  platform->par->extract("casedata", "gasamplitude", p.gasAmplitude);
  platform->par->extract("casedata", "liquidamplitude", p.liquidAmplitude);
  platform->par->extract("casedata", "xorigin", p.xOrigin);
  platform->par->extract("casedata", "yorigin", p.yOrigin);
  platform->par->extract("casedata", "xlength", p.xLength);
  platform->par->extract("casedata", "ylength", p.yLength);

  nekrsCheck(p.alphaGas <= 0.0 || p.alphaGas >= 1.0,
             platform->comm.mpiComm(),
             EXIT_FAILURE,
             "alphaGas must satisfy 0 < alphaGas < 1, got %g\n",
             p.alphaGas);
  nekrsCheck(p.rhoGas <= 0.0 || p.rhoLiquid <= 0.0,
             platform->comm.mpiComm(),
             EXIT_FAILURE,
             "%s",
             "phase densities must be positive\n");
  nekrsCheck(p.muGas <= 0.0 || p.muLiquid <= 0.0,
             platform->comm.mpiComm(),
             EXIT_FAILURE,
             "%s",
             "phase viscosities must be positive\n");

  // The common pressure coefficient is supplied as a nodal field.
  platform->options.setArgs("FLUID PRESSURE ELLIPTIC COEFF FIELD", "TRUE");

  platform->options.setArgs("UG SOLVER", "CG+FLEXIBLE");
  platform->options.setArgs("UG PRECONDITIONER", "JACOBI");
  platform->options.setArgs("UG SOLVER TOLERANCE", "1.0e-12");
  platform->options.setArgs("UG ELLIPTIC COEFF FIELD", "TRUE");

  platform->options.setArgs("UL SOLVER", "CG+FLEXIBLE");
  platform->options.setArgs("UL PRECONDITIONER", "JACOBI");
  platform->options.setArgs("UL SOLVER TOLERANCE", "1.0e-12");
  platform->options.setArgs("UL ELLIPTIC COEFF FIELD", "TRUE");
}

void UDF_Setup()
{
  twoFluidPeriodic::allocate();
  twoFluidPeriodic::initialize();
  nrs->preFluid = &twoFluidPeriodic::neutralizeNativeFluid;
}

void UDF_ExecuteStep(double time, int tstep)
{
  if (tstep <= 0) {
    return;
  }

  twoFluidPeriodic::project(time, tstep);

  if (nrs->checkpointStep) {
    twoFluidPeriodic::writeFields(time);
  }
}

