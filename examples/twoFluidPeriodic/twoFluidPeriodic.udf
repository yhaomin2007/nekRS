#ifdef __okl__

#endif

#include <cmath>
#include <vector>

#include "opSEM.hpp"
#include "registerKernels.hpp"

namespace twoFluidPeriodic
{
struct Parameters {
  dfloat alphaGas = 0.2;
  dfloat rhoGas = 1.2;
  dfloat rhoLiquid = 998.2;
  dfloat muGas = 1.8e-5;
  dfloat muLiquid = 1.0e-3;
  dfloat gasAmplitude = 0.20;
  dfloat liquidAmplitude = 0.10;
  dfloat xOrigin = -0.05;
  dfloat yOrigin = -0.05;
  dfloat xLength = 0.10;
  dfloat yLength = 0.10;
};

static Parameters p;

static deviceMemory<dfloat> o_ug;
static deviceMemory<dfloat> o_ul;
static deviceMemory<dfloat> o_ugPredictor;
static deviceMemory<dfloat> o_ulPredictor;
static deviceMemory<dfloat> o_uPredictor;
static deviceMemory<dfloat> o_uCorrected;
static deviceMemory<dfloat> o_gradP;
static deviceMemory<dfloat> o_lambdaP;
static deviceMemory<dfloat> o_rhsP;
static deviceMemory<dfloat> o_divPre;
static deviceMemory<dfloat> o_divPost;
static deviceMemory<dfloat> o_pExact;
static deviceMemory<dfloat> o_pError;

static deviceMemory<dfloat> o_lambda0Gas;
static deviceMemory<dfloat> o_lambda1Gas;
static deviceMemory<dfloat> o_lambda0Liquid;
static deviceMemory<dfloat> o_lambda1Liquid;
static deviceMemory<dfloat> o_rhsGas;
static deviceMemory<dfloat> o_rhsLiquid;

static deviceMemory<dfloat> o_diagGas;
static deviceMemory<dfloat> o_diagLiquid;
static deviceMemory<dfloat> o_rAUGas;
static deviceMemory<dfloat> o_rAULiquid;

static elliptic *gasMomentumSolver = nullptr;
static elliptic *liquidMomentumSolver = nullptr;

static occa::kernel initializePhaseVelocitiesKernel;
static occa::kernel buildMixtureKernel;
static occa::kernel correctPhaseVelocitiesKernel;
static occa::kernel buildExactPressureKernel;
static occa::kernel buildMomentumRhsKernel;
static occa::kernel buildScalarHelmholtzDiagonalKernel;
static occa::kernel finalizeMomentumMobilityKernel;
static occa::kernel buildPressureMobilityKernel;
static occa::kernel correctPhaseVelocitiesRAUKernel;

inline void registerKernels(deviceKernelProperties &kernelInfo)
{
  const std::string request = "twoFluidPeriodic::equations";
  const std::string fileName = "twoFluidPeriodicEquations.okl";

  if (platform->options.compareArgs("REGISTER ONLY", "TRUE")) {
    platform->kernelRequests.add(request, fileName, kernelInfo);
  } else {
    initializePhaseVelocitiesKernel =
        platform->kernelRequests.load(request, "initializePhaseVelocities");
    buildMixtureKernel =
        platform->kernelRequests.load(request, "buildMixture");
    correctPhaseVelocitiesKernel =
        platform->kernelRequests.load(request, "correctPhaseVelocities");
    buildExactPressureKernel =
        platform->kernelRequests.load(request, "buildExactPressure");
    buildMomentumRhsKernel =
        platform->kernelRequests.load(request, "buildMomentumRhs");
    buildScalarHelmholtzDiagonalKernel =
        platform->kernelRequests.load(request, "buildScalarHelmholtzDiagonal");
    finalizeMomentumMobilityKernel =
        platform->kernelRequests.load(request, "finalizeMomentumMobility");
    buildPressureMobilityKernel =
        platform->kernelRequests.load(request, "buildPressureMobility");
    correctPhaseVelocitiesRAUKernel =
        platform->kernelRequests.load(request, "correctPhaseVelocitiesRAU");
  }
}

inline void allocate()
{
  const dlong offset = nrs->fieldOffset;

  o_ug.resize(3 * offset);
  o_ul.resize(3 * offset);
  o_ugPredictor.resize(3 * offset);
  o_ulPredictor.resize(3 * offset);
  o_uPredictor.resize(3 * offset);
  o_uCorrected.resize(3 * offset);
  o_gradP.resize(3 * offset);
  o_lambdaP.resize(offset);
  o_rhsP.resize(offset);
  o_divPre.resize(offset);
  o_divPost.resize(offset);
  o_pExact.resize(offset);
  o_pError.resize(offset);

  o_lambda0Gas.resize(offset);
  o_lambda1Gas.resize(offset);
  o_lambda0Liquid.resize(offset);
  o_lambda1Liquid.resize(offset);
  o_rhsGas.resize(3 * offset);
  o_rhsLiquid.resize(3 * offset);

  o_diagGas.resize(offset);
  o_diagLiquid.resize(offset);
  o_rAUGas.resize(offset);
  o_rAULiquid.resize(offset);
}

inline void initialize()
{
  auto mesh = nrs->meshV;
  initializePhaseVelocitiesKernel(mesh->Nlocal,
                                  nrs->fieldOffset,
                                  p.gasAmplitude,
                                  p.liquidAmplitude,
                                  p.xOrigin,
                                  p.yOrigin,
                                  p.xLength,
                                  p.yLength,
                                  mesh->o_x,
                                  mesh->o_y,
                                  o_ug,
                                  o_ul);
}

inline void setupPhaseMomentumSolvers()
{
  if (gasMomentumSolver && liquidMomentumSolver) {
    return;
  }

  auto mesh = nrs->meshV;

  const dfloat g0idt = nrs->g0 / nrs->dt[0];

  platform->linAlg->fill(mesh->Nlocal, p.muGas, o_lambda0Gas);
  platform->linAlg->fill(mesh->Nlocal, p.rhoGas * g0idt, o_lambda1Gas);
  platform->linAlg->fill(mesh->Nlocal, p.muLiquid, o_lambda0Liquid);
  platform->linAlg->fill(mesh->Nlocal, p.rhoLiquid * g0idt, o_lambda1Liquid);

  // Fully periodic domain: there are no physical boundary faces, so all
  // elliptic face entries are NO_OP. One scalar elliptic solver is reused for
  // x/y/z components of each phase.
  std::vector<int> EToB(mesh->Nelements * mesh->Nfaces, ellipticBcType::NO_OP);

  gasMomentumSolver = new elliptic(
      "ug", mesh, nrs->fieldOffset, EToB, o_lambda0Gas, o_lambda1Gas);
  liquidMomentumSolver = new elliptic(
      "ul", mesh, nrs->fieldOffset, EToB, o_lambda0Liquid, o_lambda1Liquid);
}

inline void neutralizeNativeFluid(double, int)
{
  const dlong offset = nrs->fieldOffset;
  platform->linAlg->fill(3 * offset, 0.0, nrs->fluid->o_U);
  platform->linAlg->fill(3 * offset, 0.0, nrs->fluid->o_JwF);
  platform->linAlg->fill(offset, 0.0, nrs->fluid->o_P);
}

inline dfloat rms(deviceMemory<dfloat> field)
{
  auto mesh = nrs->meshV;
  const dfloat l2 = platform->linAlg->weightedNorm2(
      mesh->Nlocal, mesh->o_LMM, field, platform->comm.mpiComm());
  return l2 / std::sqrt(mesh->volume);
}

inline void updateMomentumMobilities()
{
  auto mesh = nrs->meshV;
  const dlong offset = nrs->fieldOffset;

  // Build the actual assembled scalar Helmholtz diagonal for each phase:
  //
  //   A_k = (rho_k*g0/dt) M + mu_k K .
  //
  // The pressure correction acts on a physical nodal gradient, whereas A_k is
  // a weak-form matrix. Therefore the local pressure mobility used below is
  //
  //   rAU_k = M_ii / diag(A_k)_ii .
  //
  // In the transient-only limit this reduces exactly to dt/(g0*rho_k).
  buildScalarHelmholtzDiagonalKernel(mesh->Nelements,
                                     offset,
                                     mesh->o_ggeo,
                                     mesh->o_D,
                                     o_lambda0Gas,
                                     o_lambda1Gas,
                                     o_diagGas);
  buildScalarHelmholtzDiagonalKernel(mesh->Nelements,
                                     offset,
                                     mesh->o_ggeo,
                                     mesh->o_D,
                                     o_lambda0Liquid,
                                     o_lambda1Liquid,
                                     o_diagLiquid);

  oogs::startFinish(o_diagGas, 1, offset, ogsDfloat, ogsAdd, mesh->oogs);
  oogs::startFinish(o_diagLiquid, 1, offset, ogsDfloat, ogsAdd, mesh->oogs);

  finalizeMomentumMobilityKernel(mesh->Nlocal,
                                 mesh->o_LMM,
                                 o_diagGas,
                                 o_rAUGas);
  finalizeMomentumMobilityKernel(mesh->Nlocal,
                                 mesh->o_LMM,
                                 o_diagLiquid,
                                 o_rAULiquid);
}

inline void solvePhasePredictors()
{
  setupPhaseMomentumSolvers();

  auto mesh = nrs->meshV;
  const dlong offset = nrs->fieldOffset;
  const dfloat invDt = 1.0 / nrs->dt[0];
  const dfloat g0idt = nrs->g0 * invDt;

  // Backward-Euler transient + implicit viscous diffusion:
  //
  // [rho_k*g0/dt - div(mu_k grad)] u_k,H
  //     = rho_k/dt * u_k^n.
  platform->linAlg->fill(mesh->Nlocal, p.muGas, o_lambda0Gas);
  platform->linAlg->fill(mesh->Nlocal, p.rhoGas * g0idt, o_lambda1Gas);
  platform->linAlg->fill(mesh->Nlocal, p.muLiquid, o_lambda0Liquid);
  platform->linAlg->fill(mesh->Nlocal, p.rhoLiquid * g0idt, o_lambda1Liquid);

  // Keep the pressure mobility consistent with the same discrete Helmholtz
  // coefficients used by these predictor solves.
  updateMomentumMobilities();

  buildMomentumRhsKernel(mesh->Nlocal,
                         offset,
                         p.rhoGas * invDt,
                         mesh->o_LMM,
                         o_ug,
                         o_rhsGas);
  buildMomentumRhsKernel(mesh->Nlocal,
                         offset,
                         p.rhoLiquid * invDt,
                         mesh->o_LMM,
                         o_ul,
                         o_rhsLiquid);

  o_ugPredictor.copyFrom(o_ug, 3 * offset);
  o_ulPredictor.copyFrom(o_ul, 3 * offset);

  for (int i = 0; i < 3; ++i) {
    gasMomentumSolver->solve(
        o_lambda0Gas,
        o_lambda1Gas,
        o_rhsGas.slice(i * offset, mesh->Nlocal),
        o_ugPredictor.slice(i * offset, mesh->Nlocal));

    liquidMomentumSolver->solve(
        o_lambda0Liquid,
        o_lambda1Liquid,
        o_rhsLiquid.slice(i * offset, mesh->Nlocal),
        o_ulPredictor.slice(i * offset, mesh->Nlocal));
  }
}

inline void project(double time, int tstep)
{
  auto mesh = nrs->meshV;
  const dlong offset = nrs->fieldOffset;

  solvePhasePredictors();

  const dfloat alpha = p.alphaGas;
  const dfloat beta = 1.0 - alpha;
  const dfloat dtOverG0 = nrs->dt[0] / nrs->g0;
  const dfloat DgTransient = dtOverG0 / p.rhoGas;
  const dfloat DlTransient = dtOverG0 / p.rhoLiquid;

  // OpenFOAM-style diagonal momentum response:
  //
  //   u_k = u_k,H - rAU_k grad(p),
  //
  // where rAU_k = M_ii / diag(A_k)_ii.  The pressure coefficient is therefore
  // the volume-fraction-weighted sum of the two phase mobilities.
  buildPressureMobilityKernel(mesh->Nlocal,
                              alpha,
                              o_rAUGas,
                              o_rAULiquid,
                              o_lambdaP);

  buildMixtureKernel(mesh->Nlocal,
                     offset,
                     alpha,
                     o_ugPredictor,
                     o_ulPredictor,
                     o_uPredictor);

  opSEM::strongDivergence(mesh, offset, o_uPredictor, o_divPre);

  launchKernel("core-wDivergenceVolumeHex3D",
               mesh->Nelements,
               mesh->o_vgeo,
               mesh->o_D,
               offset,
               o_uPredictor,
               o_rhsP);

  nrs->fluid->ellipticSolverP->solve(
      o_lambdaP, o_NULL, o_rhsP, nrs->fluid->o_P.slice(0, mesh->Nlocal));

  opSEM::strongGrad(mesh, offset, nrs->fluid->o_P, o_gradP);

  o_ug.copyFrom(o_ugPredictor, 3 * offset);
  o_ul.copyFrom(o_ulPredictor, 3 * offset);
  correctPhaseVelocitiesRAUKernel(mesh->Nlocal,
                                  offset,
                                  o_rAUGas,
                                  o_rAULiquid,
                                  o_gradP,
                                  o_ug,
                                  o_ul);

  buildMixtureKernel(mesh->Nlocal,
                     offset,
                     alpha,
                     o_ug,
                     o_ul,
                     o_uCorrected);
  opSEM::strongDivergence(mesh, offset, o_uCorrected, o_divPost);

  nrs->fluid->o_U.copyFrom(o_uCorrected, 3 * offset);

  // The pressure mobility is now the nodal Helmholtz-diagonal approximation
  // rAU=M/diag(A), so the pressure operator has a spatially varying SEM nodal
  // coefficient. The earlier closed-form sinusoidal pressure is no longer the
  // exact solution of this modified discrete operator.
  const dfloat pErrorRms = NAN;
  platform->linAlg->fill(mesh->Nlocal, 0.0, o_pExact);
  platform->linAlg->fill(mesh->Nlocal, 0.0, o_pError);

  const dfloat preRms = rms(o_divPre);
  const dfloat postRms = rms(o_divPost);
  const dfloat reduction =
      postRms / std::max(preRms, static_cast<dfloat>(1.0e-30));

  if (platform->comm.mpiRank() == 0) {
    const dfloat rAUGasMin = platform->linAlg->min(mesh->Nlocal, o_rAUGas, platform->comm.mpiComm());
    const dfloat rAUGasMax = platform->linAlg->max(mesh->Nlocal, o_rAUGas, platform->comm.mpiComm());
    const dfloat rAULiquidMin = platform->linAlg->min(mesh->Nlocal, o_rAULiquid, platform->comm.mpiComm());
    const dfloat rAULiquidMax = platform->linAlg->max(mesh->Nlocal, o_rAULiquid, platform->comm.mpiComm());

    printf("twoFluidPeriodic step=%d time=%.8e alpha=%.6e "
           "DgTransient=%.8e DlTransient=%.8e "
           "rAUGas[min,max]=[%.8e,%.8e] rAULiquid[min,max]=[%.8e,%.8e] "
           "divPreRMS=%.8e divPostRMS=%.8e divRatio=%.8e "
           "pExactRMSE=%.8e "
           "ugIters=%d ugResidual=%.8e ulIters=%d ulResidual=%.8e "
           "pIters=%d pResidual=%.8e\n",
           tstep,
           time,
           alpha,
           DgTransient,
           DlTransient,
           rAUGasMin,
           rAUGasMax,
           rAULiquidMin,
           rAULiquidMax,
           preRms,
           postRms,
           reduction,
           pErrorRms,
           gasMomentumSolver->Niter(),
           gasMomentumSolver->finalResidual(),
           liquidMomentumSolver->Niter(),
           liquidMomentumSolver->finalResidual(),
           nrs->fluid->ellipticSolverP->Niter(),
           nrs->fluid->ellipticSolverP->finalResidual());
  }
}

inline void writeFields(double time)
{
  auto mesh = nrs->meshV;
  const dlong offset = nrs->fieldOffset;

  std::vector<deviceMemory<dfloat>> ug = {
      o_ug.slice(0 * offset, mesh->Nlocal),
      o_ug.slice(1 * offset, mesh->Nlocal),
      o_ug.slice(2 * offset, mesh->Nlocal)};
  std::vector<deviceMemory<dfloat>> ul = {
      o_ul.slice(0 * offset, mesh->Nlocal),
      o_ul.slice(1 * offset, mesh->Nlocal),
      o_ul.slice(2 * offset, mesh->Nlocal)};
  std::vector<deviceMemory<dfloat>> ugH = {
      o_ugPredictor.slice(0 * offset, mesh->Nlocal),
      o_ugPredictor.slice(1 * offset, mesh->Nlocal),
      o_ugPredictor.slice(2 * offset, mesh->Nlocal)};
  std::vector<deviceMemory<dfloat>> ulH = {
      o_ulPredictor.slice(0 * offset, mesh->Nlocal),
      o_ulPredictor.slice(1 * offset, mesh->Nlocal),
      o_ulPredictor.slice(2 * offset, mesh->Nlocal)};
  std::vector<deviceMemory<dfloat>> uPredictor = {
      o_uPredictor.slice(0 * offset, mesh->Nlocal),
      o_uPredictor.slice(1 * offset, mesh->Nlocal),
      o_uPredictor.slice(2 * offset, mesh->Nlocal)};
  std::vector<deviceMemory<dfloat>> uCorrected = {
      o_uCorrected.slice(0 * offset, mesh->Nlocal),
      o_uCorrected.slice(1 * offset, mesh->Nlocal),
      o_uCorrected.slice(2 * offset, mesh->Nlocal)};
  std::vector<deviceMemory<dfloat>> gradP = {
      o_gradP.slice(0 * offset, mesh->Nlocal),
      o_gradP.slice(1 * offset, mesh->Nlocal),
      o_gradP.slice(2 * offset, mesh->Nlocal)};

  nrs->writeToFile("ugH", time, mesh, {{"velocity", ugH}});
  nrs->writeToFile("ulH", time, mesh, {{"velocity", ulH}});
  nrs->writeToFile("ug", time, mesh, {{"velocity", ug}});
  nrs->writeToFile("ul", time, mesh, {{"velocity", ul}});
  nrs->writeToFile("upred", time, mesh, {{"velocity", uPredictor}});
  nrs->writeToFile("ucorr", time, mesh, {{"velocity", uCorrected}});
  nrs->writeToFile("gradp", time, mesh, {{"velocity", gradP}});
  nrs->writeToFile("tfdiag",
                   time,
                   mesh,
                   {{"scalar00", {o_divPre.slice(0, mesh->Nlocal)}},
                    {"scalar01", {o_divPost.slice(0, mesh->Nlocal)}},
                    {"scalar02", {o_pExact.slice(0, mesh->Nlocal)}},
                    {"scalar03", {o_pError.slice(0, mesh->Nlocal)}}});
}

} // namespace twoFluidPeriodic

void UDF_LoadKernels(deviceKernelProperties &kernelInfo)
{
  twoFluidPeriodic::registerKernels(kernelInfo);

  // The case creates its own scalar Helmholtz solver for each phase. These
  // solvers need the non-Poisson scalar elliptic Ax/preconditioner kernels,
  // which are not registered by the native pressure (Poisson) or velocity
  // (3-field block) solvers. UG and UL use the same discretization/options, so
  // one registration supplies the generic scalar Helmholtz kernel requests
  // used by both case-level solvers.
  registerEllipticKernels("ug", false);
}

void UDF_Setup0(MPI_Comm, setupAide &)
{
  auto &p = twoFluidPeriodic::p;

  platform->par->extract("casedata", "alphagas", p.alphaGas);
  platform->par->extract("casedata", "rhogas", p.rhoGas);
  platform->par->extract("casedata", "rholiquid", p.rhoLiquid);
  platform->par->extract("casedata", "mugas", p.muGas);
  platform->par->extract("casedata", "muliquid", p.muLiquid);
  platform->par->extract("casedata", "gasamplitude", p.gasAmplitude);
  platform->par->extract("casedata", "liquidamplitude", p.liquidAmplitude);
  platform->par->extract("casedata", "xorigin", p.xOrigin);
  platform->par->extract("casedata", "yorigin", p.yOrigin);
  platform->par->extract("casedata", "xlength", p.xLength);
  platform->par->extract("casedata", "ylength", p.yLength);

  nekrsCheck(p.alphaGas <= 0.0 || p.alphaGas >= 1.0,
             platform->comm.mpiComm(),
             EXIT_FAILURE,
             "alphaGas must satisfy 0 < alphaGas < 1, got %g\n",
             p.alphaGas);
  nekrsCheck(p.rhoGas <= 0.0 || p.rhoLiquid <= 0.0,
             platform->comm.mpiComm(),
             EXIT_FAILURE,
             "%s",
             "phase densities must be positive\n");
  nekrsCheck(p.muGas <= 0.0 || p.muLiquid <= 0.0,
             platform->comm.mpiComm(),
             EXIT_FAILURE,
             "%s",
             "phase viscosities must be positive\n");
  nekrsCheck(p.xLength <= 0.0 || p.yLength <= 0.0,
             platform->comm.mpiComm(),
             EXIT_FAILURE,
             "%s",
             "periodic lengths must be positive\n");

  platform->options.setArgs("FLUID PRESSURE ELLIPTIC COEFF FIELD", "TRUE");

  // Case-layer scalar Helmholtz solvers used for the three Cartesian
  // components of each phase momentum predictor.
  platform->options.setArgs("UG SOLVER", "CG+FLEXIBLE");
  platform->options.setArgs("UG PRECONDITIONER", "JACOBI");
  platform->options.setArgs("UG SOLVER TOLERANCE", "1.0e-12");
  platform->options.setArgs("UG ELLIPTIC COEFF FIELD", "TRUE");

  platform->options.setArgs("UL SOLVER", "CG+FLEXIBLE");
  platform->options.setArgs("UL PRECONDITIONER", "JACOBI");
  platform->options.setArgs("UL SOLVER TOLERANCE", "1.0e-12");
  platform->options.setArgs("UL ELLIPTIC COEFF FIELD", "TRUE");
}

void UDF_Setup()
{
  twoFluidPeriodic::allocate();
  twoFluidPeriodic::initialize();
  nrs->preFluid = &twoFluidPeriodic::neutralizeNativeFluid;
}

void UDF_ExecuteStep(double time, int tstep)
{
  if (tstep <= 0) {
    return;
  }

  twoFluidPeriodic::project(time, tstep);

  if (nrs->checkpointStep) {
    twoFluidPeriodic::writeFields(time);
  }
}

