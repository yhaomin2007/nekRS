c-----------------------------------------------------------------------
      subroutine usrdat2
      include 'SIZE'
      include 'TOTAL'

c     Fully periodic control box: all faces use boundary ID 0.
      do iel=1,nelt
      do ifc=1,2*ndim
         boundaryID(ifc,iel) = 0
      enddo
      enddo

      return
      end
c-----------------------------------------------------------------------
