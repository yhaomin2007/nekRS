// NekRS extracts __okl__ from this file before processing includes, so the
// original turbPipe boundary section must be present here explicitly.
#ifdef __okl__


// Boundary conditions
void udfDirichlet(bcData *bc)
{
  if (isField("fluid velocity")) {
    bc->uxFluid = bc->usrwrk[bc->idxVol + 0 * bc->fieldOffset];
    bc->uyFluid = bc->usrwrk[bc->idxVol + 1 * bc->fieldOffset];
    bc->uzFluid = bc->usrwrk[bc->idxVol + 2 * bc->fieldOffset];
  } else if (isField("fluid pressure")) {
    const dfloat iU0delta = 20.0;
    const dfloat un = bc->uxFluid * bc->nx + bc->uyFluid * bc->ny + bc->uzFluid * bc->nz;
    const dfloat s0 = 0.5 * (1.0 - tanh(un * iU0delta));
    bc->pFluid = -0.5 * (bc->uxFluid * bc->uxFluid + bc->uyFluid * bc->uyFluid + bc->uzFluid * bc->uzFluid) * s0;
  } else if (isField("scalar s00")) {
    if (bc->id == 1) {
      bc->sScalar = 0;
    } else {
      bc->sScalar = 0.5 * (tanh((bc->z - 1.0) / 0.2) + 1.0); // smooth ramp
    }
  }
}
#endif

// Reuse turbPipe's mesh physics, initial conditions, recycling and output.
// Its step callback is invoked only at setup or after the last inner pass.
#define UDF_Setup0 turbPipeSetup0
#define UDF_Setup turbPipeSetup
#define UDF_ExecuteStep turbPipeExecuteStep
#include "../turbPipe/turbPipe.udf"
#undef UDF_Setup0
#undef UDF_Setup
#undef UDF_ExecuteStep

#include "frozenInner.hpp"

void UDF_Setup0(MPI_Comm comm, setupAide &options)
{
  turbPipeSetup0(comm, options);
  platform->par->extract("casedata", "picardenabled", frozenInner::enabled);
  platform->par->extract("casedata", "inneriterations", frozenInner::iterations);
  platform->par->extract("casedata", "repeattolerance", frozenInner::tolerance);
  platform->par->extract("casedata", "picardconvection", frozenInner::updateConvection);
  platform->par->extract("casedata", "picardtolerance", frozenInner::picardTolerance);
}

void UDF_Setup()
{
  turbPipeSetup();
  frozenInner::configure();
}

void UDF_ExecuteStep(double time, int tstep)
{
  if (frozenInner::enabled && tstep > 0 && !nrs->timeStepConverged) {
    frozenInner::restoreForNextPass();
    return;
  }
  turbPipeExecuteStep(time, tstep);
}
