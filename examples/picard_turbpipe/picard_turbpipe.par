userSections = CASEDATA

#[OCCA]
#backend = CUDA
#deviceNumber = LOCAL-RANK

[GENERAL]
#verbose = true
polynomialOrder = 7
#startFrom = "restart.fld"
stopAt = numSteps
numSteps = 20

timeStepper = tombo2

#dt = 6.0e-3
#advectionSubCyclingSteps = 2
dt = 1e-3
advectionSubCyclingSteps = 0

checkpointControl = steps
checkpointInterval = 10

regularization = hpfrt + nModes=1 + scalingCoeff=10

scalars = s00

[MESH]
file = ../turbPipe/turbPipe.re2

[FLUID PRESSURE]
initialGuess = previous
residualTol = 1e-10
#initialGuess = projectionAconj+nVector=10

[FLUID VELOCITY]
initialGuess = previous
boundaryTypeMap = udfDirichlet, zeroNeumann,zeroDirichlet
rho = 1.0
viscosity = 1/19000
residualTol = 1e-10

[SCALAR S00]
initialGuess = previous
transportCoeff = 1.0
diffusionCoeff = 1/19000
boundaryTypeMap = udfDirichlet, zeroNeumann, udfDirichlet
residualTol = 1e-10
regularization = avm+noiseThreshold=1e-3

[CASEDATA]
# adjust to actual mesh
NSLABS  = 60
NELSLAB = 132
processAscentYamlFrequency = 100

# 0: native one-pass baseline, with no frozen-inner callbacks installed.
picardEnabled = 1
# Maximum passes per timestep, including the native predictor.
innerIterations = 3
# max|repeat-first| / max(1,max|first|), checked independently for U,p,s00.
repeatTolerance = 1e-9

# 0: frozen repeatability control; 1: update full convection from latest iterate.
picardConvection = 1
# Stop after a corrector when max scaled U,p,s00 change is below this value.
picardTolerance = 1e-8
