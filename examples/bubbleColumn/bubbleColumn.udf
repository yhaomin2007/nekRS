#include "bubbleColumnTerms.hpp"
#include "bubbleColumnCubature.hpp"
#include "bubbleColumnAlphaStabilization.hpp"
#include "bubbleColumnPhaseMomentum.hpp"

#ifdef __okl__
#include "bubbleColumn.oudf"
#endif

void UDF_LoadKernels(deviceKernelProperties &info)
{
  info.define("p_RHO_LIQUID")=bubbleColumn::p.rhoLiquid;
  info.define("p_RHO_GAS")=bubbleColumn::p.rhoGas;
  info.define("p_ALPHA_INLET")=bubbleColumn::p.alphaInlet;
  info.define("p_UG_INLET")=bubbleColumn::p.ugInlet;
  bubbleColumn::registerKernels(info);
  bubbleColumn::alphaStabilization::registerKernels(info);
  bubbleColumn::alphaStabilization::residual::registerKernels(info);
  bubbleColumn::phaseMomentum::registerKernels(info);
}

void UDF_Setup0(MPI_Comm,setupAide &)
{
  platform->options.setArgs("LOWMACH","FALSE");
  platform->options.setArgs("FLUID PRESSURE ELLIPTIC COEFF FIELD","TRUE");
  int N=0,cubN=0;
  platform->options.getArgs("POLYNOMIAL DEGREE",N);
  platform->options.getArgs("CUBATURE POLYNOMIAL DEGREE",cubN);
  const auto header=bubbleColumn::missingCubatureInterpolationHeader(N,cubN);
  if (!header.empty()) {
    platform->kernelInfo["headers"].asArray();
    platform->kernelInfo["headers"]+=header;
  }
  auto &p=bubbleColumn::p;
  // Fixed Method1 choices. Old experimental limiter/ramp/filter switches are
  // deliberately not read from .par in this case.
  p.rhoLiquid=998.2; p.rhoGas=1.2; p.muLiquid=1e-3; p.muGas=1.8e-5;
  p.alphaInlet=0.016667; p.ugInlet=0.3;
  p.gravity[2]=-9.81;
  p.alphaFloor=1e-6; p.alphaClippingEnabled=1;
  p.alphaMinimum=0; p.alphaMaximum=1;
  p.zRampBottom=0.9; p.zRampTop=0.95; p.outletDampingFactor=1;
  p.gasMomentumCutoff=1e-4; p.gasMomentumFullyActive=1e-3;
  p.gasPressureEnabled=1; p.dragEnabled=1; p.bubbleDiameter=3e-3;
  p.driftStressEnabled=1; p.virtualMassEnabled=1; p.virtualMassCoefficient=0.5;
  p.mixtureDivergenceForm=2; p.divergenceFilterStrength=0;
  p.divergenceComparisonInterval=10; p.validationOutputInterval=10;
  auto read=[&](const char *key,auto &value) { platform->par->extract("casedata",key,value); };
  read("rholiquid",p.rhoLiquid); read("rhogas",p.rhoGas);
  read("muliquid",p.muLiquid); read("mugas",p.muGas);
  read("alphainlet",p.alphaInlet); read("gasinletvelocity",p.ugInlet);
  p.ugInitial=p.ugInlet;
  read("initialplumeheight",p.initialPlumeHeight);
  read("initialplumethickness",p.initialPlumeThickness);
  read("gravityz",p.gravity[2]); read("bubblediameter",p.bubbleDiameter);
  read("virtualmasscoefficient",p.virtualMassCoefficient);
  read("gaspressuregradientextrapolation",p.gasPressureGradientExtrapolation);
  read("alphacompressionenabled",p.alphaCompressionEnabled);
  read("diagnosticinterval",bubbleColumn::phaseMomentum::interval);
  bubbleColumn::alphaStabilization::readParameters();
  bubbleColumn::alphaStabilization::residual::readParameters();
  nekrsCheck(!(std::isfinite(p.rhoLiquid) && p.rhoLiquid>0 &&
      std::isfinite(p.rhoGas) && p.rhoGas>0 &&
      std::isfinite(p.muLiquid) && p.muLiquid>0 &&
      std::isfinite(p.muGas) && p.muGas>=0 &&
      std::isfinite(p.bubbleDiameter) && p.bubbleDiameter>0 &&
      std::isfinite(p.alphaInlet) && p.alphaInlet>=0 && p.alphaInlet<1 &&
      std::isfinite(p.ugInlet) && std::isfinite(p.gravity[2]) &&
      std::isfinite(p.initialPlumeHeight) && p.initialPlumeHeight>=0 &&
      std::isfinite(p.initialPlumeThickness) && p.initialPlumeThickness>0) ||
      (p.alphaCompressionEnabled!=0 && p.alphaCompressionEnabled!=1),
      platform->comm.mpiComm(),EXIT_FAILURE,"%s","Invalid Method1 physical parameters.\n");
}

void UDF_Setup()
{
  bubbleColumn::allocate();
  bubbleColumn::alphaStabilization::allocate();
  bubbleColumn::alphaStabilization::residual::allocate();
  bubbleColumn::phaseMomentum::allocate();
  if (platform->options.getArgs("RESTART FILE NAME").empty()) {
    const auto &p=bubbleColumn::p;
    for (const char *name:{"ulx","uly","ulz"})
      platform->linAlg->fill(nrs->meshV->Nlocal,0.0,nrs->scalar->o_solution(name));
    bubbleColumn::initializePlumeKernel(nrs->meshV->Nlocal,nrs->fieldOffset,
        p.rhoLiquid,p.rhoGas,p.alphaInlet,p.ugInitial,
        p.initialPlumeHeight,p.initialPlumeThickness,nrs->meshV->o_z,
        nrs->scalar->o_solution("alpha"),nrs->scalar->o_solution("ugx"),
        nrs->scalar->o_solution("ugy"),nrs->scalar->o_solution("ugz"),nrs->fluid->o_U);
    // Replace the plume helper's stationary-liquid special case with the
    // mass-weighted velocity of the actual initialized UG and UL fields.
    bubbleColumn::phaseMomentum::initializeMixture();
  }
  bubbleColumn::initializeHistory();
  nrs->userSource=&bubbleColumn::phaseMomentum::beginStep;
  nrs->postScalar=&bubbleColumn::phaseMomentum::postScalar;
  nrs->userProperties=&bubbleColumn::updateProperties;
  nrs->userDivergence=&bubbleColumn::updateDivergence;
  nrs->preFluid=&bubbleColumn::phaseMomentum::preFluid;
  nrs->userConvergenceCheck=&bubbleColumn::phaseMomentum::singlePass;
  if (platform->comm.mpiRank()==0)
    printf("Method1: ALPHA -> UG -> UL -> native PRESSURE -> native UM -> phase correction.\n"
           "UM is never reset from phase predictors; core solvers unchanged.\n"
           "Phase convection=fluid EXT; pressure=strong %s; alphaCompression=%d.\n"
           "Physical phase stress and drag explicit; VM uses symmetric local inertia block.\n",
        bubbleColumn::p.gasPressureGradientExtrapolation?"EXT":"latest",
        bubbleColumn::p.alphaCompressionEnabled);
}

void UDF_ExecuteStep(double time,int tstep)
{
  if (tstep>0) bubbleColumn::phaseMomentum::correct();
  bubbleColumn::reconstructGasVelocity();
  bubbleColumn::reconstructLiquidVelocity();
  bubbleColumn::phaseMomentum::diagnostics(time);
  if(bubbleColumn::alphaStabilization::residual::active())
    bubbleColumn::alphaStabilization::residual::diagnostics(time);
  else bubbleColumn::alphaStabilization::diagnostics(time);
}
