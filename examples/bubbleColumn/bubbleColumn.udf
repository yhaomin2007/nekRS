#include "bubbleColumnTerms.hpp"

#ifdef __okl__
#include "bubbleColumn.oudf"
#endif

void UDF_LoadKernels(deviceKernelProperties& kernelInfo)
{
  kernelInfo.define("p_RHO_LIQUID") = bubbleColumn::p.rhoLiquid;
  kernelInfo.define("p_RHO_GAS") = bubbleColumn::p.rhoGas;
  kernelInfo.define("p_ALPHA_INLET") = bubbleColumn::p.alphaInlet;
  kernelInfo.define("p_UG_INLET") = bubbleColumn::p.ugInlet;
  bubbleColumn::registerKernels(kernelInfo);
}

void UDF_Setup0(MPI_Comm, setupAide &)
{
  // userDivergence does not require thermodynamic LOWMACH mode. Keep that
  // mode disabled (and therefore avoid its p0th requirement), while retaining
  // the variable 1/rho_m coefficient in the pressure projection.
  platform->options.setArgs("LOWMACH", "FALSE");
  platform->options.setArgs("FLUID PRESSURE ELLIPTIC COEFF FIELD", "TRUE");
  auto &p = bubbleColumn::p;
  platform->par->extract("casedata", "rholiquid", p.rhoLiquid);
  platform->par->extract("casedata", "rhogas", p.rhoGas);
  platform->par->extract("casedata", "muliquid", p.muLiquid);
  platform->par->extract("casedata", "mugas", p.muGas);
  platform->par->extract("casedata", "alphainitial", p.alphaInitial);
  platform->par->extract("casedata", "alphainlet", p.alphaInlet);
  platform->par->extract("casedata", "gasinletvelocity", p.ugInlet);
  platform->par->extract("casedata", "initialplumeheight", p.initialPlumeHeight);
  platform->par->extract("casedata", "initialplumethickness", p.initialPlumeThickness);
  platform->par->extract("casedata", "gravityx", p.gravity[0]);
  platform->par->extract("casedata", "gravityy", p.gravity[1]);
  platform->par->extract("casedata", "gravityz", p.gravity[2]);
  platform->par->extract("casedata", "alphafloor", p.alphaFloor);
  platform->par->extract("casedata", "dragenabled", p.dragEnabled);
  platform->par->extract("casedata", "bubblediameter", p.bubbleDiameter);
  platform->par->extract("casedata", "virtualmassenabled", p.virtualMassEnabled);
  platform->par->extract("casedata", "virtualmasscoefficient", p.virtualMassCoefficient);
}

void UDF_Setup()
{
  bubbleColumn::allocate();
  if (platform->options.getArgs("RESTART FILE NAME").empty()) {
    const auto &p = bubbleColumn::p;
    bubbleColumn::initializePlumeKernel(
        nrs->meshV->Nlocal,
        nrs->fieldOffset,
        p.rhoLiquid,
        p.rhoGas,
        p.alphaInlet,
        p.ugInlet,
        p.initialPlumeHeight,
        p.initialPlumeThickness,
        nrs->meshV->o_z,
        nrs->scalar->o_solution("alpha"),
        nrs->scalar->o_solution("ugx"),
        nrs->scalar->o_solution("ugy"),
        nrs->scalar->o_solution("ugz"),
        nrs->fluid->o_U);
  }
  bubbleColumn::initializeHistory();
  nrs->userSource = &bubbleColumn::addExplicitSources;
  nrs->scalar->userImplicitLinearTerm = &bubbleColumn::implicitGasDrag;
  nrs->userProperties = &bubbleColumn::updateProperties;
  nrs->userDivergence = &bubbleColumn::updateDivergence;
}

void UDF_ExecuteStep(double time, int tstep)
{
  if (tstep > 0 && bubbleColumn::p.virtualMassEnabled != 0.0) {
    bubbleColumn::updateVirtualMassHistory();
  }
  if (nrs->checkpointStep) {
    nrs->copyToNek(time, tstep);
    nek::userchk();
  }
}
