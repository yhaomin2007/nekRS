void udfDirichlet(bcData *bc)
{
  if (isField("fluid velocity")) {
    if (bc->id == 1) {
      const dfloat rhoM = (1.0 - p_ALPHA_INLET) * p_RHO_LIQUID
                          + p_ALPHA_INLET * p_RHO_GAS;
      // Density-averaged inlet velocity; the liquid inlet velocity is zero.
      bc->uxFluid = 0.0;
      bc->uyFluid = 0.0;
      bc->uzFluid = p_ALPHA_INLET * p_RHO_GAS * p_UG_INLET / rhoM;
    } else if (bc->id == 3) {
      bc->uxFluid = 0.0;
      bc->uyFluid = 0.0;
      bc->uzFluid = 0.0;
    }
  } else if (isField("fluid pressure") && bc->id == 2) {
    // Turbulent/open outlet condition used by the NekRS turbPipe example.
    // The smooth switch activates the kinetic-pressure correction during
    // local backflow (u.n < 0) and vanishes for outward flow.
    const dfloat inverseVelocityThickness = 20.0;
    const dfloat normalVelocity =
        bc->uxFluid * bc->nx + bc->uyFluid * bc->ny + bc->uzFluid * bc->nz;
    const dfloat backflowSwitch =
        0.5 * (1.0 - tanh(normalVelocity * inverseVelocityThickness));
    bc->pFluid = -0.5
                 * (bc->uxFluid * bc->uxFluid + bc->uyFluid * bc->uyFluid
                    + bc->uzFluid * bc->uzFluid)
                 * backflowSwitch;
  } else if (isField("scalar alpha")) {
    bc->sScalar = p_ALPHA_INLET;
  } else if (isField("scalar qgx")) {
    bc->sScalar = 0.0;
  } else if (isField("scalar qgy")) {
    bc->sScalar = 0.0;
  } else if (isField("scalar qgz")) {
    bc->sScalar = (bc->id == 1) ? p_ALPHA_INLET * p_UG_INLET : 0.0;
  }
}
