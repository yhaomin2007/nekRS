userSections = CASEDATA

[GENERAL]
polynomialOrder = 7
# UG scalars require a new run or a converted UG restart.
# startFrom = bubblecolumn0.f00036
stopAt = numSteps
numSteps = 100000
#dt = initial=1.0e-5+targetCFL=0.01+max=1e-2
dt = 1e-5
timeStepper = tombo2
checkpointInterval = 1000
scalars = ALPHA, UGX, UGY, UGZ

[FLUID PRESSURE]
residualTol = 1e-6

[FLUID VELOCITY]
# Boundary IDs: 1=inlet, 2=outlet, 3=wall
boundaryTypeMap = udfDirichlet, zeroNeumann, udfDirichlet
residualTol = 1e-6
rho = 998.2
viscosity = 1.0e-3
regularization = hpfrt + nModes=1 + scalingCoeff=10.0

[SCALAR ALPHA]
boundaryTypeMap = udfDirichlet, zeroNeumann, zeroNeumann
residualTol = 1e-6
transportCoeff = 1.0
diffusionCoeff = 1e-5
# NekRS native high-pass-filter relaxation. Use regularization = none to disable.
regularization = hpfrt + nModes=1 + scalingCoeff=10.0

[SCALAR UGX]
boundaryTypeMap = udfDirichlet, zeroNeumann, udfDirichlet
residualTol = 1e-6
transportCoeff = 1.0
diffusionCoeff = 1e-5
regularization = hpfrt + nModes=1 + scalingCoeff=10.0

[SCALAR UGY]
boundaryTypeMap = udfDirichlet, zeroNeumann, udfDirichlet
residualTol = 1e-6
transportCoeff = 1.0
diffusionCoeff =1e-5
regularization = hpfrt + nModes=1 + scalingCoeff=10.0

[SCALAR UGZ]
boundaryTypeMap = udfDirichlet, zeroNeumann, udfDirichlet
residualTol = 1e-6
transportCoeff = 1.0
diffusionCoeff = 1e-5
regularization = hpfrt + nModes=1 + scalingCoeff=10.0

[CASEDATA]
rhoLiquid = 998.2
rhoGas = 1.2
muLiquid = 1.0e-3
muGas = 1.8e-5
alphaInitial = 0.016667
alphaInlet = 0.016667
gasInletVelocity = 0.3
# Uniform initial gas velocity along z (m/s); ugz=gasInitialVelocity.
gasInitialVelocity = 0.3
gravityX = 0.0
gravityY = 0.0
gravityZ = -9.81
alphaFloor = 1e-6
alphaClipEnabled = 1.0
alphaMinimum = 0.0
alphaMaximum = 1.0
subtractAlphaDiffusion = 0.0
subtractUgxDiffusion = 0.0
subtractUgyDiffusion = 0.0
subtractUgzDiffusion = 0.0
zRampBottom = 0.9
zRampTop = 0.95
outletDampingFactor = 20.0
smoothGasVelocityMaskEnabled = 1.0
gasVelocityClipEnabled = 0.0
gasVelocityMaximum = 0.5
mixtureVelocityClipEnabled = 0.0
mixtureVelocityMaximum = 1.0
gasMomentumCutoff = 1e-4
gasMomentumFullyActive = 1e-3
gasPressureEnabled = 1.0
# 1: suppress all UG pressure-gradient components at inlet nodes (boundary ID 1).
# Includes shared inlet/wall corner nodes; 0 retains pressure forcing everywhere.
gasPressureInletMaskEnabled = 0
# Pressure gradient used in the UG source:
# 0 = assembled strong gradient, 1 = mass-normalized weak gradient matching
# the volume pressure operator used by the native NekRS velocity RHS.
# Both raw forms are always computed, compared, and exported at checkpoints.
gasPressureGradientMethod = 0
# Exponential relaxation of the selected lagged pressure gradient used by UG:
# gradP_used^n = (1-weight)*gradP_used^(n-1) + weight*gradP_lagged^n.
# Set enabled=0 or weight=1 to recover the unfiltered lagged gradient.
gasPressureGradientFilterEnabled = 0
gasPressureGradientFilterWeight = 0.2
dragEnabled = 1.0
bubbleDiameter = 3.0e-3
# Set to 0.0 to omit -div(tau_d)/rho_m from mixture momentum.
driftStressEnabled = 1.0
virtualMassEnabled = 1.0
virtualMassCoefficient = 0.5
# Native alpha/UG advection always uses predicted UG directly.
# Alpha compression: 0=GLL alpha*div(UG), 1=cubature projection.
gasTransportMethod = 1
# 0: off (diagnostic); 1: explicit compression; 2: implicit frozen div(ug)*alpha.
# Mode 2 uses assembled nodal strong divergence in native Helmholtz;
# gasTransportMethod selects GLL/cubature compression only for mode 1.
# UG velocity equation has no corresponding ug_i*div(ug) source.
alphaCompressionMode = 1
# Metres from the inlet plane z=0: suppress alpha*div(ug) at z <= thickness.
# 0 disables this local mask; positive values work with modes 1 and 2.
# A nodal step mask is applied after assembly/projection in explicit mode.
alphaCompressionInletThickness = 0.01
# 0: latest-state scalar convection and explicit RHS (EXT1); 1: configured EXT history
# BDF time derivative and fluid EXT are unchanged.
scalarExtrapolationEnabled = 0
# Mixture-divergence construction: 0=reconstructed alpha RHS,
# 1=discrete BDF alpha history plus native NekRS scalar advection.
mixtureDivergenceMethod = 0
# Raw method0/method1/difference statistics in log and comparison CSV.
divergenceComparisonInterval = 10
divergenceFilterEnabled = 0
divergenceFilterModes = 1
divergenceFilterStrength = 0.25
divergenceExtrapolationEnabled = 0.0
divergenceRampEnabled = 1
divergenceRampSteps = 1000
stabilityMonitorEnabled = 1.0
stabilityMonitorInterval = 10
validationOutputInterval = 10
