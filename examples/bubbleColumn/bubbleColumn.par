userSections = CASEDATA

[GENERAL]
polynomialOrder = 7
cubaturePolynomialOrder = 14
stopAt = numSteps
numSteps = 100000
dt = 1e-5
timeStepper = tombo2
checkpointInterval = 1000
scalars = ALPHA, UGX, UGY, UGZ, ULX, ULY, ULZ
# Fresh start, or a checkpoint with all seven scalars.

[FLUID PRESSURE]
initialGuess = previous
residualTol = 1e-6

[FLUID VELOCITY]
initialGuess = previous
boundaryTypeMap = udfDirichlet, zeroNeumann, udfDirichlet
residualTol = 1e-6
rho = 998.2
viscosity = 1e-3
regularization = hpfrt + nModes=1 + scalingCoeff=10.0

[SCALAR ALPHA]
initialGuess = previous
boundaryTypeMap = udfDirichlet, zeroNeumann, zeroNeumann
residualTol = 1e-6
transportCoeff = 1
diffusionCoeff = 1e-5
regularization = hpfrt + nModes=1 + scalingCoeff=10.0

[SCALAR UGX]
initialGuess = previous
boundaryTypeMap = udfDirichlet, zeroNeumann, udfDirichlet
residualTol = 1e-6
transportCoeff = 1
# Additional numerical diffusivity; physical stress is supplied by the UDF.
diffusionCoeff = 1e-5
regularization = hpfrt + nModes=1 + scalingCoeff=10.0

[SCALAR UGY]
initialGuess = previous
boundaryTypeMap = udfDirichlet, zeroNeumann, udfDirichlet
residualTol = 1e-6
transportCoeff = 1
# Additional numerical diffusivity; physical stress is supplied by the UDF.
diffusionCoeff = 1e-5
regularization = hpfrt + nModes=1 + scalingCoeff=10.0

[SCALAR UGZ]
initialGuess = previous
boundaryTypeMap = udfDirichlet, zeroNeumann, zeroNeumann
residualTol = 1e-6
transportCoeff = 1
# Additional numerical diffusivity; physical stress is supplied by the UDF.
diffusionCoeff = 1e-5
regularization = hpfrt + nModes=1 + scalingCoeff=10.0

[SCALAR ULX]
initialGuess = previous
boundaryTypeMap = udfDirichlet, zeroNeumann, udfDirichlet
residualTol = 1e-6
transportCoeff = 1
# Additional numerical diffusivity; physical stress is supplied by the UDF.
diffusionCoeff = 1e-5
regularization = hpfrt + nModes=1 + scalingCoeff=10.0

[SCALAR ULY]
initialGuess = previous
boundaryTypeMap = udfDirichlet, zeroNeumann, udfDirichlet
residualTol = 1e-6
transportCoeff = 1
# Additional numerical diffusivity; physical stress is supplied by the UDF.
diffusionCoeff = 1e-5
regularization = hpfrt + nModes=1 + scalingCoeff=10.0

[SCALAR ULZ]
initialGuess = previous
boundaryTypeMap = udfDirichlet, zeroNeumann, udfDirichlet
residualTol = 1e-6
transportCoeff = 1
# Additional numerical diffusivity; physical stress is supplied by the UDF.
diffusionCoeff = 1e-5
regularization = hpfrt + nModes=1 + scalingCoeff=10.0

[CASEDATA]
rhoLiquid = 998.2
rhoGas = 1.2
muLiquid = 1e-3
muGas = 1.8e-5
alphaInlet = 0.016667
gasInletVelocity = 0.3
initialPlumeHeight = 0.05
initialPlumeThickness = 0.01
gravityZ = -9.81
bubbleDiameter = 3e-3
virtualMassCoefficient = 0.5
# 0: latest strong grad(p); 1: native fluid EXT of strong gradient history.
gasPressureGradientExtrapolation = 0
# 0 removes alpha*div(UG) for diagnostics and changes phase conservation.
alphaCompressionEnabled = 1
# First step, every N steps, and checkpoints; 0: first/checkpoints only.
diagnosticInterval = 10

# Alpha-only artificial diffusion: 0=off, 1=crosswind, 3=streamline, 4=both.
# Adaptive mode 2 and full SUPG mode 5 are reserved, not implemented.
alphaStabilizationMode = 1
alphaCrosswindDiffusivity = 2e-5
alphaStreamlineDiffusivity = 2e-5
# Velocity regularization (m/s); at UG=0 crosswind becomes isotropic.
alphaDirectionEpsilon = 1e-6
