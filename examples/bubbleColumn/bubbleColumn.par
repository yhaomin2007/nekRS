userSections = CASEDATA

[GENERAL]
polynomialOrder = 5
stopAt = numSteps
numSteps = 100
dt = 1e-3
timeStepper = tombo2
checkpointInterval = 20
scalars = ALPHA, UGX, UGY, UGZ

[FLUID PRESSURE]
residualTol = 1e-8
initialGuess = previous

[FLUID VELOCITY]
# Boundary IDs: 1=inlet, 2=outlet, 3=wall
boundaryTypeMap = udfDirichlet, zeroNeumann, udfDirichlet
residualTol = 1e-8
rho = 998.2
viscosity = 1.0e-3

[SCALAR ALPHA]
boundaryTypeMap = udfDirichlet, zeroNeumann, zeroNeumann
residualTol = 1e-8
transportCoeff = 1.0
diffusionCoeff = 1e-12

[SCALAR UGX]
boundaryTypeMap = udfDirichlet, zeroNeumann, udfDirichlet
residualTol = 1e-8
transportCoeff = 1.0
diffusionCoeff = 1e-12

[SCALAR UGY]
boundaryTypeMap = udfDirichlet, zeroNeumann, udfDirichlet
residualTol = 1e-8
transportCoeff = 1.0
diffusionCoeff = 1e-12

[SCALAR UGZ]
boundaryTypeMap = udfDirichlet, zeroNeumann, udfDirichlet
residualTol = 1e-8
transportCoeff = 1.0
diffusionCoeff = 1e-12

[CASEDATA]
rhoLiquid = 998.2
rhoGas = 1.2
muLiquid = 1.0e-3
muGas = 1.8e-5
alphaInitial = 0.0
alphaInlet = 0.5
gasInletVelocity = 0.1
initialPlumeHeight = 5.0e-2
initialPlumeThickness = 1.0e-2
gravityX = 0.0
gravityY = 0.0
gravityZ = -9.81
alphaFloor = 1e-6
dragEnabled = 1.0
bubbleDiameter = 3.0e-3
virtualMassEnabled = 0.0
virtualMassCoefficient = 0.5
