userSections = CASEDATA

[GENERAL]
polynomialOrder = 7
cubaturePolynomialOrder = 14
stopAt = numSteps
numSteps = 100000
dt = 1e-5
timeStepper = tombo2
checkpointInterval = 1000
scalars = ALPHA, UGX, UGY, UGZ, ULX, ULY, ULZ
# Fresh start, or a checkpoint with all seven scalars.

[FLUID PRESSURE]
initialGuess = previous
residualTol = 1e-6

[FLUID VELOCITY]
initialGuess = previous
boundaryTypeMap = udfDirichlet, zeroNeumann, udfDirichlet
residualTol = 1e-6
rho = 998.2
viscosity = 1e-3
regularization = hpfrt + nModes=1 + scalingCoeff=10.0

[SCALAR ALPHA]
initialGuess = previous
boundaryTypeMap = udfDirichlet, zeroNeumann, zeroNeumann
residualTol = 1e-6
transportCoeff = 1
diffusionCoeff = 1e-5
regularization = hpfrt + nModes=1 + scalingCoeff=10.0

[SCALAR UGX]
initialGuess = previous
boundaryTypeMap = udfDirichlet, zeroNeumann, udfDirichlet
residualTol = 1e-6
transportCoeff = 1
# Additional numerical diffusivity; physical stress is supplied by the UDF.
diffusionCoeff = 1e-5
regularization = hpfrt + nModes=1 + scalingCoeff=10.0

[SCALAR UGY]
initialGuess = previous
boundaryTypeMap = udfDirichlet, zeroNeumann, udfDirichlet
residualTol = 1e-6
transportCoeff = 1
# Additional numerical diffusivity; physical stress is supplied by the UDF.
diffusionCoeff = 1e-5
regularization = hpfrt + nModes=1 + scalingCoeff=10.0

[SCALAR UGZ]
initialGuess = previous
boundaryTypeMap = udfDirichlet, zeroNeumann, zeroNeumann
residualTol = 1e-6
transportCoeff = 1
# Additional numerical diffusivity; physical stress is supplied by the UDF.
diffusionCoeff = 1e-5
regularization = hpfrt + nModes=1 + scalingCoeff=10.0

[SCALAR ULX]
initialGuess = previous
boundaryTypeMap = udfDirichlet, zeroNeumann, udfDirichlet
residualTol = 1e-6
transportCoeff = 1
# Additional numerical diffusivity; physical stress is supplied by the UDF.
diffusionCoeff = 1e-5
regularization = hpfrt + nModes=1 + scalingCoeff=10.0

[SCALAR ULY]
initialGuess = previous
boundaryTypeMap = udfDirichlet, zeroNeumann, udfDirichlet
residualTol = 1e-6
transportCoeff = 1
# Additional numerical diffusivity; physical stress is supplied by the UDF.
diffusionCoeff = 1e-5
regularization = hpfrt + nModes=1 + scalingCoeff=10.0

[SCALAR ULZ]
initialGuess = previous
boundaryTypeMap = udfDirichlet, zeroNeumann, udfDirichlet
residualTol = 1e-6
transportCoeff = 1
# Additional numerical diffusivity; physical stress is supplied by the UDF.
diffusionCoeff = 1e-5
regularization = hpfrt + nModes=1 + scalingCoeff=10.0

[CASEDATA]
rhoLiquid = 998.2
rhoGas = 1.2
muLiquid = 1e-3
muGas = 1.8e-5
alphaInlet = 0.016667
gasInletVelocity = 0.3
initialPlumeHeight = 0.05
initialPlumeThickness = 0.01
gravityZ = -9.81
bubbleDiameter = 3e-3
virtualMassCoefficient = 0.5
# 0: latest strong grad(p); 1: native fluid EXT of strong gradient history.
gasPressureGradientExtrapolation = 0
# 0 removes alpha*div(UG) for diagnostics and changes phase conservation.
alphaCompressionEnabled = 1
# First step, every N steps, and checkpoints; 0: first/checkpoints only.
diagnosticInterval = 10

# Residual stabilization: 0=off, 2=Codina-type crosswind, 5=SUPG, 6=both.
# Legacy constant diffusion modes 1/3/4 remain available, not the default.
alphaStabilizationMode = 6
alphaCrosswindScale = 1.0
alphaStreamlineScale = 1.0
alphaLowerGradientChange = 1e-5
# Upper safeguard only, not a uniformly applied diffusion coefficient (m^2/s).
alphaMaxResidualDiffusivity = 1e-3
alphaStabilizationRelTol = 1e-5
alphaStabilizationAbsTol = 1e-7
alphaStabilizationMaxIterations = 30
# Velocity regularization (m/s); residual crosswind switches off below this speed.
alphaDirectionEpsilon = 1e-6
