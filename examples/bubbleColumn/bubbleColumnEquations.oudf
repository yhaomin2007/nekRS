@kernel void packGasVelocity(const dlong N,
                             const dlong offset,
                             @ restrict const dfloat *ugx,
                             @ restrict const dfloat *ugy,
                             @ restrict const dfloat *ugz,
                             @ restrict dfloat *ug)
{
  for (dlong n = 0; n < N; ++n; @tile(p_blockSize, @outer, @inner)) {
    ug[n + 0 * offset] = ugx[n];
    ug[n + 1 * offset] = ugy[n];
    ug[n + 2 * offset] = ugz[n];
  }
}

@kernel void buildEquationTerms(const dlong N,
                                const dlong offset,
                                const dfloat rhoLiquid,
                                const dfloat rhoGas,
                                const dfloat muLiquid,
                                const dfloat muGas,
                                const dfloat alphaFloor,
                                const dfloat dragCoefficient,
                                const dfloat gravityX,
                                const dfloat gravityY,
                                const dfloat gravityZ,
                                @ restrict const dfloat *alpha,
                                @ restrict const dfloat *um,
                                @ restrict const dfloat *ug,
                                @ restrict const dfloat *gradAlpha,
                                @ restrict const dfloat *gradUg,
                                @ restrict const dfloat *gradP,
                                @ restrict dfloat *rhoMField,
                                @ restrict dfloat *muMField,
                                @ restrict dfloat *divSource,
                                @ restrict dfloat *driftStress,
                                @ restrict dfloat *alphaSource,
                                @ restrict dfloat *ugSource)
{
  for (dlong n = 0; n < N; ++n; @tile(p_blockSize, @outer, @inner)) {
    // Keep the physical volume fraction separate from denominator protection.
    const dfloat aRaw = alpha[n];
    const dfloat a = (aRaw < 0.0) ? 0.0 : ((aRaw > 1.0) ? 1.0 : aRaw);
    const dfloat beta = 1.0 - a;
    const dfloat aSafe = (a > alphaFloor) ? a : alphaFloor;
    const dfloat betaSafe = (beta > alphaFloor) ? beta : alphaFloor;
    const dfloat rhoM = beta * rhoLiquid + a * rhoGas;
    const dfloat muM = beta * muLiquid + a * muGas;

    const dfloat dx = ug[n + 0 * offset] - um[n + 0 * offset];
    const dfloat dy = ug[n + 1 * offset] - um[n + 1 * offset];
    const dfloat dz = ug[n + 2 * offset] - um[n + 2 * offset];

    const dfloat divUg = gradUg[n + (0 * 3 + 0) * offset]
                         + gradUg[n + (1 * 3 + 1) * offset]
                         + gradUg[n + (2 * 3 + 2) * offset];
    const dfloat slipGradAlpha = dx * gradAlpha[n + 0 * offset]
                                   + dy * gradAlpha[n + 1 * offset]
                                   + dz * gradAlpha[n + 2 * offset];

    rhoMField[n] = rhoM;
    muMField[n] = muM;

    // Eq. (15): prescribed divergence of the density-averaged mixture velocity.
    divSource[n] = (rhoGas - rhoLiquid) / rhoM * (slipGradAlpha + a * divUg);

    // Eq. (20): rho-weighted drift stress, tau_d.
    const dfloat driftScale = a * rhoGas * rhoM / (betaSafe * rhoLiquid);
    driftStress[n + 0 * offset] = driftScale * dx * dx;
    driftStress[n + 1 * offset] = driftScale * dx * dy;
    driftStress[n + 2 * offset] = driftScale * dx * dz;
    driftStress[n + 3 * offset] = driftScale * dy * dx;
    driftStress[n + 4 * offset] = driftScale * dy * dy;
    driftStress[n + 5 * offset] = driftScale * dy * dz;
    driftStress[n + 6 * offset] = driftScale * dz * dx;
    driftStress[n + 7 * offset] = driftScale * dz * dy;
    driftStress[n + 8 * offset] = driftScale * dz * dz;

    // Eq. (27): source needed because nekRS advects passive scalars with u_m.
    alphaSource[n] = -slipGradAlpha - a * divUg;

    // Eq. (29): gas-velocity source. Pressure is intentionally lagged one pass.
    // The alpha-weighted gas viscous stress is not yet added in this scaffold.
    const dfloat advX = dx * gradUg[n + 0 * offset]
                         + dy * gradUg[n + 1 * offset]
                         + dz * gradUg[n + 2 * offset];
    const dfloat advY = dx * gradUg[n + 3 * offset]
                         + dy * gradUg[n + 4 * offset]
                         + dz * gradUg[n + 5 * offset];
    const dfloat advZ = dx * gradUg[n + 6 * offset]
                         + dy * gradUg[n + 7 * offset]
                         + dz * gradUg[n + 8 * offset];

    // Minimal placeholder only; the production drag closure must use u_g-u_l.
    const dfloat dragScale = -dragCoefficient / (aSafe * rhoGas);
    ugSource[n + 0 * offset] = -advX - gradP[n + 0 * offset] / rhoGas
                               + gravityX + dragScale * dx;
    ugSource[n + 1 * offset] = -advY - gradP[n + 1 * offset] / rhoGas
                               + gravityY + dragScale * dy;
    ugSource[n + 2 * offset] = -advZ - gradP[n + 2 * offset] / rhoGas
                               + gravityZ + dragScale * dz;
  }
}

@kernel void buildMixtureForce(const dlong N,
                               const dlong offset,
                               const dfloat gravityX,
                               const dfloat gravityY,
                               const dfloat gravityZ,
                               @ restrict const dfloat *rhoM,
                               @ restrict const dfloat *divDriftStress,
                               @ restrict dfloat *force)
{
  for (dlong n = 0; n < N; ++n; @tile(p_blockSize, @outer, @inner)) {
    // nekRS o_EXT is acceleration; it is multiplied by rho_m in velocityRhs.
    force[n + 0 * offset] = -divDriftStress[n + 0 * offset] / rhoM[n] + gravityX;
    force[n + 1 * offset] = -divDriftStress[n + 1 * offset] / rhoM[n] + gravityY;
    force[n + 2 * offset] = -divDriftStress[n + 2 * offset] / rhoM[n] + gravityZ;
  }
}
