void udfDirichlet(bcData *bc)
{
  if (isField("fluid velocity")) {
    if (bc->id == 1) {
      // Phase-volume averaged inlet velocity; the liquid inlet velocity is zero.
      bc->uxFluid = 0.0;
      bc->uyFluid = 0.0;
      bc->uzFluid = p_ALPHA_INLET * p_UG_INLET;
    } else if (bc->id == 3) {
      bc->uxFluid = 0.0;
      bc->uyFluid = 0.0;
      bc->uzFluid = 0.0;
    }
  } else if (isField("scalar alpha")) {
    bc->sScalar = p_ALPHA_INLET;
  } else if (isField("scalar ugx")) {
    bc->sScalar = 0.0;
  } else if (isField("scalar ugy")) {
    bc->sScalar = 0.0;
  } else if (isField("scalar ugz")) {
    bc->sScalar = (bc->id == 1) ? p_UG_INLET : 0.0;
  }
}
