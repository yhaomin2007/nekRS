@kernel void reconstructGasVelocity(const dlong N,
                                    const dlong offset,
                                    const dfloat alphaFloor,
                                    @ restrict const dfloat *alpha,
                                    @ restrict const dfloat *qgx,
                                    @ restrict const dfloat *qgy,
                                    @ restrict const dfloat *qgz,
                                    @ restrict dfloat *ug)
{
  for (dlong n = 0; n < N; ++n; @tile(p_blockSize, @outer, @inner)) {
    const dfloat a = alpha[n] < 0.0 ? 0.0 : (alpha[n] > 1.0 ? 1.0 : alpha[n]);
    const dfloat inverseAlpha = a > alphaFloor ? 1.0 / a : 0.0;
    ug[n + 0 * offset] = qgx[n] * inverseAlpha;
    ug[n + 1 * offset] = qgy[n] * inverseAlpha;
    ug[n + 2 * offset] = qgz[n] * inverseAlpha;
  }
}

@kernel void clipAlpha(const dlong N,
                       const dfloat alphaMinimum,
                       const dfloat alphaMaximum,
                       @ restrict dfloat *alpha)
{
  for (dlong n = 0; n < N; ++n; @tile(p_blockSize, @outer, @inner)) {
    alpha[n] = alpha[n] < alphaMinimum
                   ? alphaMinimum
                   : (alpha[n] > alphaMaximum ? alphaMaximum : alpha[n]);
  }
}

@kernel void clipVectorMagnitude(const dlong N,
                                 const dlong offset,
                                 const dfloat velocityMaximum,
                                 @ restrict dfloat *velocity)
{
  for (dlong n = 0; n < N; ++n; @tile(p_blockSize, @outer, @inner)) {
    const dfloat ux = velocity[n + 0 * offset];
    const dfloat uy = velocity[n + 1 * offset];
    const dfloat uz = velocity[n + 2 * offset];
    const dfloat speed = sqrt(ux * ux + uy * uy + uz * uz);
    const dfloat scale = speed > velocityMaximum
        ? velocityMaximum / speed
        : 1.0;
    velocity[n + 0 * offset] = scale * ux;
    velocity[n + 1 * offset] = scale * uy;
    velocity[n + 2 * offset] = scale * uz;
  }
}

@kernel void postProcessGasFlux(
    const dlong N,
    const dfloat smoothMaskEnabled,
    const dfloat velocityClipEnabled,
    const dfloat velocityMaximum,
    const dfloat alphaFloor,
    const dfloat alphaCutoff,
    const dfloat alphaFullyActive,
    @ restrict const dfloat *alpha,
    @ restrict dfloat *qgx,
    @ restrict dfloat *qgy,
    @ restrict dfloat *qgz)
{
  for (dlong n = 0; n < N; ++n; @tile(p_blockSize, @outer, @inner)) {
    dfloat weight = 1.0;
    if (smoothMaskEnabled != 0.0 && alpha[n] <= alphaCutoff) {
      weight = 0.0;
    } else if (smoothMaskEnabled != 0.0 && alpha[n] < alphaFullyActive) {
      const dfloat ramp =
          (alpha[n] - alphaCutoff) / (alphaFullyActive - alphaCutoff);
      weight = ramp * ramp * (3.0 - 2.0 * ramp);
    }
    const dfloat a = alpha[n] < 0.0 ? 0.0 : (alpha[n] > 1.0 ? 1.0 : alpha[n]);
    const dfloat inverseAlpha = a > alphaFloor ? 1.0 / a : 0.0;
    dfloat ux = weight * qgx[n] * inverseAlpha;
    dfloat uy = weight * qgy[n] * inverseAlpha;
    dfloat uz = weight * qgz[n] * inverseAlpha;
    const dfloat speed = sqrt(ux * ux + uy * uy + uz * uz);
    const dfloat clipScale = (velocityClipEnabled != 0.0 && speed > velocityMaximum)
        ? velocityMaximum / speed
        : 1.0;
    qgx[n] = a * clipScale * ux;
    qgy[n] = a * clipScale * uy;
    qgz[n] = a * clipScale * uz;
  }
}

@kernel void initializePlume(const dlong N,
                             const dlong offset,
                             const dfloat alphaInlet,
                             const dfloat gasInletVelocity,
                             const dfloat plumeHeight,
                             const dfloat plumeThickness,
                             @ restrict const dfloat *z,
                             @ restrict dfloat *alpha,
                             @ restrict dfloat *qgx,
                             @ restrict dfloat *qgy,
                             @ restrict dfloat *qgz,
                             @ restrict dfloat *uv)
{
  for (dlong n = 0; n < N; ++n; @tile(p_blockSize, @outer, @inner)) {
    const dfloat profile =
        0.5 * (1.0 - tanh((z[n] - plumeHeight) / plumeThickness));
    const dfloat a = alphaInlet * profile;
    const dfloat ugVertical = gasInletVelocity * profile;
    alpha[n] = a;
    qgx[n] = 0.0;
    qgy[n] = 0.0;
    qgz[n] = a * ugVertical;
    uv[n + 0 * offset] = 0.0;
    uv[n + 1 * offset] = 0.0;
    uv[n + 2 * offset] = a * ugVertical;
  }
}

@kernel void buildLiquidVelocity(const dlong N,
                                 const dlong offset,
                                 const dfloat alphaFloor,
                                 @ restrict const dfloat *alpha,
                                 @ restrict const dfloat *uv,
                                 @ restrict const dfloat *qg,
                                 @ restrict dfloat *ul)
{
  for (dlong n = 0; n < N; ++n; @tile(p_blockSize, @outer, @inner)) {
    const dfloat aRaw = alpha[n];
    const dfloat a = (aRaw < 0.0) ? 0.0 : ((aRaw > 1.0) ? 1.0 : aRaw);
    const dfloat beta = 1.0 - a;
    const dfloat betaSafe = (beta > alphaFloor) ? beta : alphaFloor;
    for (int i = 0; i < 3; ++i) {
      ul[n + i * offset] =
          (uv[n + i * offset] - qg[n + i * offset]) / betaSafe;
    }
  }
}

@kernel void updateVirtualMassHistory(const dlong N,
                                      const dlong offset,
                                      const dfloat inverseDt,
                                      @ restrict const dfloat *ug,
                                      @ restrict const dfloat *ul,
                                      @ restrict dfloat *ulPrevious,
                                      @ restrict dfloat *ugPrevious,
                                      @ restrict const dfloat *gradUl,
                                      @ restrict const dfloat *gradUg,
                                      @ restrict dfloat *relativeAcceleration)
{
  for (dlong n = 0; n < N; ++n; @tile(p_blockSize, @outer, @inner)) {
    for (int i = 0; i < 3; ++i) {
      dfloat liquidAcceleration =
          (ul[n + i * offset] - ulPrevious[n + i * offset]) * inverseDt;
      dfloat gasAcceleration =
          (ug[n + i * offset] - ugPrevious[n + i * offset]) * inverseDt;
      for (int j = 0; j < 3; ++j) {
        liquidAcceleration += ul[n + j * offset] * gradUl[n + (3 * i + j) * offset];
        gasAcceleration += ug[n + j * offset] * gradUg[n + (3 * i + j) * offset];
      }
      relativeAcceleration[n + i * offset] = liquidAcceleration - gasAcceleration;
      ulPrevious[n + i * offset] = ul[n + i * offset];
      ugPrevious[n + i * offset] = ug[n + i * offset];
    }
  }
}

@kernel void buildOutletRampFactor(const dlong N,
                                   const dfloat zRampBottom,
                                   const dfloat zRampTop,
                                   const dfloat dampingFactor,
                                   @ restrict const dfloat *z,
                                   @ restrict dfloat *rampFactor)
{
  for (dlong n = 0; n < N; ++n; @tile(p_blockSize, @outer, @inner)) {
    dfloat s = (z[n] - zRampBottom) / (zRampTop - zRampBottom);
    s = (s < 0.0) ? 0.0 : ((s > 1.0) ? 1.0 : s);
    // C1-continuous smoothstep avoids slope jumps at the ramp endpoints.
    s = s * s * (3.0 - 2.0 * s);
    rampFactor[n] = 1.0 + (dampingFactor - 1.0) * s;
  }
}

@kernel void buildEquationTerms(const dlong N,
                                const dlong offset,
                                const dfloat rhoLiquid,
                                const dfloat rhoGas,
                                const dfloat muLiquid,
                                const dfloat muGas,
                                const dfloat alphaFloor,
                                const dfloat gasPressureEnabled,
                                const dfloat dragEnabled,
                                const dfloat bubbleDiameter,
                                const dfloat virtualMassEnabled,
                                const dfloat virtualMassCoefficient,
                                const dfloat gravityX,
                                const dfloat gravityY,
                                const dfloat gravityZ,
                                @ restrict const dfloat *alpha,
                                @ restrict const dfloat *uv,
                                @ restrict const dfloat *ug,
                                @ restrict const dfloat *ul,
                                @ restrict const dfloat *gradAlpha,
                                @ restrict const dfloat *gradQg,
                                @ restrict const dfloat *divQg,
                                @ restrict const dfloat *divQgAdvectionFlux,
                                @ restrict const dfloat *gradUg,
                                @ restrict const dfloat *virtualMassRelativeAcceleration,
                                @ restrict const dfloat *gradP,
                                @ restrict dfloat *rhoMField,
                                @ restrict dfloat *rhoPressureField,
                                @ restrict dfloat *muMField,
                                @ restrict dfloat *driftStress,
                                @ restrict dfloat *gasStress,
                                @ restrict dfloat *alphaSource,
                                @ restrict dfloat *qgSource,
                                @ restrict dfloat *dragLambda,
                                @ restrict dfloat *mixtureInterphaseAcceleration)
{
  for (dlong n = 0; n < N; ++n; @tile(p_blockSize, @outer, @inner)) {
    // Keep the physical volume fraction separate from denominator protection.
    const dfloat aRaw = alpha[n];
    const dfloat a = (aRaw < 0.0) ? 0.0 : ((aRaw > 1.0) ? 1.0 : aRaw);
    const dfloat beta = 1.0 - a;
    const dfloat betaSafe = (beta > alphaFloor) ? beta : alphaFloor;
    const dfloat gasActive = (a >= alphaFloor) ? 1.0 : 0.0;
    const dfloat rhoM = beta * rhoLiquid + a * rhoGas;
    const dfloat pressureMobility = beta / rhoLiquid + a / rhoGas;
    const dfloat rhoPressure = 1.0 / pressureMobility;
    const dfloat nuEffective = beta * muLiquid / rhoLiquid
                               + a * muGas / rhoGas;
    const dfloat muEffective = rhoPressure * nuEffective;

    const dfloat dx = ug[n + 0 * offset] - uv[n + 0 * offset];
    const dfloat dy = ug[n + 1 * offset] - uv[n + 1 * offset];
    const dfloat dz = ug[n + 2 * offset] - uv[n + 2 * offset];
    const dfloat urx = ug[n + 0 * offset] - ul[n + 0 * offset];
    const dfloat ury = ug[n + 1 * offset] - ul[n + 1 * offset];
    const dfloat urz = ug[n + 2 * offset] - ul[n + 2 * offset];

    const dfloat divUg = gradUg[n + (0 * 3 + 0) * offset]
                         + gradUg[n + (1 * 3 + 1) * offset]
                         + gradUg[n + (2 * 3 + 2) * offset];

    rhoMField[n] = rhoM;
    rhoPressureField[n] = rhoPressure;
    muMField[n] = muEffective;

    // Kinematic drift tensor in the volume-averaged momentum equation:
    // alpha*(1-alpha)*(ug-ul)(ug-ul)
    // = alpha/(1-alpha)*(ug-uv)(ug-uv).
    const dfloat driftScale = gasActive * a / betaSafe;
    driftStress[n + 0 * offset] = driftScale * dx * dx;
    driftStress[n + 1 * offset] = driftScale * dx * dy;
    driftStress[n + 2 * offset] = driftScale * dx * dz;
    driftStress[n + 3 * offset] = driftScale * dy * dx;
    driftStress[n + 4 * offset] = driftScale * dy * dy;
    driftStress[n + 5 * offset] = driftScale * dy * dz;
    driftStress[n + 6 * offset] = driftScale * dz * dx;
    driftStress[n + 7 * offset] = driftScale * dz * dy;
    driftStress[n + 8 * offset] = driftScale * dz * dz;

    // NekRS supplies native dealiased A_m(alpha)=u_v.grad(alpha). Recover the
    // conservative gas continuity equation with assembled user-side operators.
    alphaSource[n] = uv[n + 0 * offset] * gradAlpha[n + 0 * offset]
                     + uv[n + 1 * offset] * gradAlpha[n + 1 * offset]
                     + uv[n + 2 * offset] * gradAlpha[n + 2 * offset]
                     - divQg[n];

    // Likewise, cancel native A_m(q_i) and replace it with the assembled
    // conservative divergence D(q_i*u_g).
    const dfloat qgAdvectionX =
        uv[n + 0 * offset] * gradQg[n + 0 * offset]
        + uv[n + 1 * offset] * gradQg[n + 1 * offset]
        + uv[n + 2 * offset] * gradQg[n + 2 * offset]
        - divQgAdvectionFlux[n + 0 * offset];
    const dfloat qgAdvectionY =
        uv[n + 0 * offset] * gradQg[n + 3 * offset]
        + uv[n + 1 * offset] * gradQg[n + 4 * offset]
        + uv[n + 2 * offset] * gradQg[n + 5 * offset]
        - divQgAdvectionFlux[n + 1 * offset];
    const dfloat qgAdvectionZ =
        uv[n + 0 * offset] * gradQg[n + 6 * offset]
        + uv[n + 1 * offset] * gradQg[n + 7 * offset]
        + uv[n + 2 * offset] * gradQg[n + 8 * offset]
        - divQgAdvectionFlux[n + 2 * offset];

    // alpha*tau_g with a Newtonian Stokes stress. Its divergence is added
    // outside this pointwise kernel after applying the SEM divergence.
    const dfloat twoThirdsDivUg = (2.0 / 3.0) * divUg;
    for (int i = 0; i < 3; ++i) {
      for (int j = 0; j < 3; ++j) {
        const dfloat trace = (i == j) ? twoThirdsDivUg : 0.0;
        gasStress[n + (3 * i + j) * offset] =
            a * muGas * (gradUg[n + (3 * i + j) * offset]
                         + gradUg[n + (3 * j + i) * offset] - trace);
      }
    }

    // OpenFOAM Schiller-Naumann dispersed-gas drag.
    const dfloat magUr = sqrt(urx * urx + ury * ury + urz * urz);
    const dfloat Re = rhoLiquid * bubbleDiameter * magUr / muLiquid;
    const dfloat CdRe = (Re < 1000.0)
        ? 24.0 * (1.0 + 0.15 * pow(Re, 0.687))
        : 0.44 * Re;
    const dfloat Ki = 0.75 * CdRe * muLiquid
                      / (bubbleDiameter * bubbleDiameter);
    // M_D/rho_g = alpha*Ki/rho_g*(u_l-u_g). Since q_g=alpha*u_g,
    // Ki/rho_g*q_g is the implicit part.
    const dfloat dragRate = dragEnabled * Ki / rhoGas;
    dragLambda[n] = dragRate;
    const dfloat virtualMassScale = a * virtualMassEnabled
                                    * virtualMassCoefficient * rhoLiquid / rhoGas;
    qgSource[n + 0 * offset] = qgAdvectionX
                               - a * gasPressureEnabled * gradP[n + 0 * offset] / rhoGas
                               + a * gravityX + a * dragRate * ul[n + 0 * offset]
                               + virtualMassScale
                                 * virtualMassRelativeAcceleration[n + 0 * offset];
    qgSource[n + 1 * offset] = qgAdvectionY
                               - a * gasPressureEnabled * gradP[n + 1 * offset] / rhoGas
                               + a * gravityY + a * dragRate * ul[n + 1 * offset]
                               + virtualMassScale
                                 * virtualMassRelativeAcceleration[n + 1 * offset];
    qgSource[n + 2 * offset] = qgAdvectionZ
                               - a * gasPressureEnabled * gradP[n + 2 * offset] / rhoGas
                               + a * gravityZ + a * dragRate * ul[n + 2 * offset]
                               + virtualMassScale
                                 * virtualMassRelativeAcceleration[n + 2 * offset];

    // Interphase forces cancel in mass-weighted momentum, but not after the
    // phase momentum equations are divided by their densities and summed.
    // If a_g^I is the interphase acceleration in the gas equation, the
    // volume-mixture contribution is alpha*(1-rho_g/rho_l)*a_g^I.
    const dfloat gasVirtualMassScale = virtualMassEnabled
                                      * virtualMassCoefficient
                                      * rhoLiquid / rhoGas;
    const dfloat volumeWeight = a * (1.0 - rhoGas / rhoLiquid);
    mixtureInterphaseAcceleration[n + 0 * offset] =
        volumeWeight
        * (dragRate * (ul[n + 0 * offset] - ug[n + 0 * offset])
           + gasVirtualMassScale
             * virtualMassRelativeAcceleration[n + 0 * offset]);
    mixtureInterphaseAcceleration[n + 1 * offset] =
        volumeWeight
        * (dragRate * (ul[n + 1 * offset] - ug[n + 1 * offset])
           + gasVirtualMassScale
             * virtualMassRelativeAcceleration[n + 1 * offset]);
    mixtureInterphaseAcceleration[n + 2 * offset] =
        volumeWeight
        * (dragRate * (ul[n + 2 * offset] - ug[n + 2 * offset])
           + gasVirtualMassScale
             * virtualMassRelativeAcceleration[n + 2 * offset]);
  }
}

@kernel void buildGasPressureAccelerationMonitor(
    const dlong N,
    const dfloat rhoGas,
    const dfloat gasMomentumCutoff,
    @ restrict const dfloat *alpha,
    @ restrict const dfloat *gradPMagnitude,
    @ restrict dfloat *activeAcceleration,
    @ restrict dfloat *inactiveAcceleration)
{
  for (dlong n = 0; n < N; ++n; @tile(p_blockSize, @outer, @inner)) {
    const dfloat acceleration = gradPMagnitude[n] / rhoGas;
    const int active = alpha[n] >= gasMomentumCutoff;
    activeAcceleration[n] = active ? acceleration : 0.0;
    inactiveAcceleration[n] = active ? 0.0 : acceleration;
  }
}

@kernel void buildGasFluxConsistencyMonitor(
    const dlong N,
    const dlong offset,
    @ restrict const dfloat *alpha,
    @ restrict const dfloat *qg,
    @ restrict const dfloat *ug,
    @ restrict dfloat *errorMagnitude)
{
  for (dlong n = 0; n < N; ++n; @tile(p_blockSize, @outer, @inner)) {
    const dfloat a = alpha[n] < 0.0 ? 0.0 : (alpha[n] > 1.0 ? 1.0 : alpha[n]);
    const dfloat ex = qg[n + 0 * offset] - a * ug[n + 0 * offset];
    const dfloat ey = qg[n + 1 * offset] - a * ug[n + 1 * offset];
    const dfloat ez = qg[n + 2 * offset] - a * ug[n + 2 * offset];
    errorMagnitude[n] = sqrt(ex * ex + ey * ey + ez * ez);
  }
}

@kernel void buildMixtureForce(const dlong N,
                               const dlong offset,
                               const dfloat alphaFloor,
                               const dfloat driftStressEnabled,
                               const dfloat gravityX,
                               const dfloat gravityY,
                               const dfloat gravityZ,
                               @ restrict const dfloat *alpha,
                               @ restrict const dfloat *divDriftStress,
                               @ restrict const dfloat *interphaseAcceleration,
                               @ restrict dfloat *force)
{
  for (dlong n = 0; n < N; ++n; @tile(p_blockSize, @outer, @inner)) {
    dfloat driftAccelerationX = 0.0;
    dfloat driftAccelerationY = 0.0;
    dfloat driftAccelerationZ = 0.0;
    if (driftStressEnabled != 0.0) {
      // The drift-stress divergence is the only mixture-momentum source that
      // uses u_g. Suppress it wherever the gas phase is numerically absent.
      // This second mask prevents differentiation of neighboring nonzero
      // drift stress from leaking a gas-dependent source into alpha < floor.
      const dfloat gasActive = (alpha[n] >= alphaFloor) ? 1.0 : 0.0;
      driftAccelerationX = -gasActive * divDriftStress[n + 0 * offset];
      driftAccelerationY = -gasActive * divDriftStress[n + 1 * offset];
      driftAccelerationZ = -gasActive * divDriftStress[n + 2 * offset];
    }
    // nekRS o_EXT is acceleration; velocityRhs multiplies it by rhoPressure.
    force[n + 0 * offset] = driftAccelerationX + gravityX
                            + interphaseAcceleration[n + 0 * offset];
    force[n + 1 * offset] = driftAccelerationY + gravityY
                            + interphaseAcceleration[n + 1 * offset];
    force[n + 2 * offset] = driftAccelerationZ + gravityZ
                            + interphaseAcceleration[n + 2 * offset];
  }
}
