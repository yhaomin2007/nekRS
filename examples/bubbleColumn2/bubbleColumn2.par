userSections = CASEDATA

[GENERAL]
polynomialOrder = 5
stopAt = numSteps
numSteps = 100000
dt = 1e-5
timeStepper = tombo2
checkpointInterval = 1000
scalars = ALPHA, UGX, UGY, UGZ

[PROBLEMTYPE]
equation = navierStokes+variableViscosity

[FLUID PRESSURE]
residualTol = 1e-6

[FLUID VELOCITY]
boundaryTypeMap = udfDirichlet, zeroNeumann, udfDirichlet
residualTol = 1e-6
rho = 998.2
viscosity = 1.0e-3
regularization = hpfrt + nModes=1 + scalingCoeff=10.0

[SCALAR ALPHA]
boundaryTypeMap = udfDirichlet, zeroNeumann, zeroNeumann
residualTol = 1e-6
transportCoeff = 1.0
diffusionCoeff = 1e-5
regularization = hpfrt + nModes=1 + scalingCoeff=10.0

[SCALAR UGX]
boundaryTypeMap = udfDirichlet, zeroNeumann, udfDirichlet
residualTol = 1e-6
transportCoeff = 1.0
diffusionCoeff = 1e-5
regularization = hpfrt + nModes=1 + scalingCoeff=10.0

[SCALAR UGY]
boundaryTypeMap = udfDirichlet, zeroNeumann, udfDirichlet
residualTol = 1e-6
transportCoeff = 1.0
diffusionCoeff =1e-5
regularization = hpfrt + nModes=1 + scalingCoeff=10.0

[SCALAR UGZ]
boundaryTypeMap = udfDirichlet, zeroNeumann, udfDirichlet
residualTol = 1e-6
transportCoeff = 1.0
diffusionCoeff = 1e-5
regularization = hpfrt + nModes=1 + scalingCoeff=10.0

[CASEDATA]
rhoLiquid = 998.2
rhoGas = 1.2
muLiquid = 1e-3
muGas = 1.8e-5
alphaInlet = 0.016667
gasInletVelocity = 0.3
gasInitialVelocity = 0.3
initialPlumeHeight = 0.05
initialPlumeThickness = 0.01
gravityX = 0
gravityY = 0
gravityZ = -9.81
alphaFloor = 1e-6
alphaClipEnabled = 1
bubbleDiameter = 3e-3
# VM retained from the preceding configuration; this is not a stable-VM claim.
virtualMassEnabled = 1
virtualMassCoefficient = 0.5
virtualMassStartStep = 100
virtualMassRampStep = 10000
virtualMassTimeDerivativeOrder = 1
stabilityMonitorInterval = 10
