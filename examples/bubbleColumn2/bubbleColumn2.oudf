void udfDirichlet(bcData *bc)
{
  if(isField("fluid velocity")){
    bc->uxFluid=0;bc->uyFluid=0;
    bc->uzFluid=bc->id==1?bc->usrwrk[bc->idxVol]*p_ALPHA_INLET*p_UG_INLET:0;
  } else if(isField("fluid pressure")){
    const dfloat un=bc->uxFluid*bc->nx+bc->uyFluid*bc->ny+bc->uzFluid*bc->nz;
    bc->pFluid=-.25*(bc->uxFluid*bc->uxFluid+bc->uyFluid*bc->uyFluid+bc->uzFluid*bc->uzFluid)*(1-tanh(20*un));
  } else if(isField("scalar alpha")){
    bc->sScalar=p_ALPHA_INLET;
  } else if(isField("scalar ugz")){
    bc->sScalar=bc->id==1?bc->usrwrk[bc->idxVol]*p_UG_INLET:0;
  } else if(isField("scalar ugx") || isField("scalar ugy"))bc->sScalar=0;
}
