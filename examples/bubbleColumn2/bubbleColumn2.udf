#include "bubbleColumn2Native.hpp"
#include "bubbleColumn2Cubature.hpp"
#ifdef __okl__
#include "bubbleColumn2.oudf"
#endif

void UDF_Setup0(MPI_Comm,setupAide &)
{
  platform->options.setArgs("LOWMACH","FALSE");
  platform->options.setArgs("FLUID PRESSURE ELLIPTIC COEFF FIELD","TRUE");
  int N=0;platform->options.getArgs("POLYNOMIAL DEGREE",N);
  // Same default formula as v26 parseGeneral.hpp; it is not a case parameter.
  const int cubN=std::round(1.5*(N+1)-1)-1;
  int requested=-1;platform->par->extract("general","cubaturepolynomialorder",requested);
  nekrsCheck(requested!=-1,platform->comm.mpiComm(),EXIT_FAILURE,"%s",
      "Method2 selects native cubature order automatically: remove cubaturePolynomialOrder from .par.\n");
  platform->options.setArgs("ADVECTION TYPE","CUBATURE");
  platform->options.setArgs("OVERINTEGRATION","TRUE");
  platform->options.setArgs("CUBATURE POLYNOMIAL DEGREE",std::to_string(cubN));
  const auto missing=bubbleColumn2::missingCubatureInterpolationHeader(N,cubN);
  if(!missing.empty()){
    platform->kernelInfo["headers"].asArray();platform->kernelInfo["headers"]+=missing;
  }
  auto &p=bubbleColumn2::p;
#define READ(KEY,FIELD) platform->par->extract("casedata",KEY,p.FIELD)
  READ("rholiquid",rhoLiquid);READ("rhogas",rhoGas);READ("muliquid",muLiquid);READ("mugas",muGas);
  READ("alphainlet",alphaInlet);READ("gasinletvelocity",ugInlet);READ("gasinitialvelocity",ugInitial);
  READ("initialplumeheight",initialPlumeHeight);READ("initialplumethickness",initialPlumeThickness);
  READ("gravityx",gravity[0]);READ("gravityy",gravity[1]);READ("gravityz",gravity[2]);
  READ("alphafloor",alphaFloor);READ("alphaclipenabled",alphaClippingEnabled);
  READ("bubblediameter",bubbleDiameter);READ("virtualmassenabled",virtualMassEnabled);
  READ("virtualmasscoefficient",virtualMassCoefficient);READ("virtualmassstartstep",virtualMassStartStep);
  READ("virtualmassrampstep",virtualMassRampStep);READ("virtualmasstimederivativeorder",virtualMassTimeDerivativeOrder);
  READ("stabilitymonitorinterval",stabilityMonitorInterval);
#undef READ
  for(dfloat value:{p.rhoLiquid,p.rhoGas,p.muLiquid,p.muGas,p.bubbleDiameter,p.alphaFloor,
      p.alphaInlet,p.initialPlumeThickness,p.initialPlumeHeight,p.virtualMassCoefficient,
      p.gravity[0],p.gravity[1],p.gravity[2]})
    nekrsCheck(!std::isfinite(value),platform->comm.mpiComm(),EXIT_FAILURE,"%s","Nonfinite method2 parameter.\n");
  nekrsCheck(!(p.rhoLiquid>0 && p.rhoGas>0 && p.muLiquid>0 && p.muGas>0 && p.bubbleDiameter>0
      && p.alphaFloor>0 && p.alphaFloor<1 && p.alphaInlet>=0 && p.alphaInlet<=1
      && p.initialPlumeThickness>0 && p.initialPlumeHeight>=0 && p.virtualMassCoefficient>=0)
      || !std::isfinite(p.ugInlet) || !std::isfinite(p.ugInitial)
      || (p.virtualMassEnabled!=0 && p.virtualMassEnabled!=1)
      || (p.alphaClippingEnabled!=0 && p.alphaClippingEnabled!=1)
      || p.virtualMassStartStep<0 || p.virtualMassRampStep<0 || p.stabilityMonitorInterval<1
      || (p.virtualMassTimeDerivativeOrder!=1 && p.virtualMassTimeDerivativeOrder!=2),
      platform->comm.mpiComm(),EXIT_FAILURE,"%s","Invalid simplified method2 phase/VM/initial parameters.\n");
}
void UDF_LoadKernels(deviceKernelProperties &info)
{
  info.define("p_ALPHA_INLET")=bubbleColumn2::p.alphaInlet;
  info.define("p_UG_INLET")=bubbleColumn2::p.ugInlet;
  bubbleColumn2::registerKernels(info);
}
void UDF_Setup()
{
  using namespace bubbleColumn2;
  nekrsCheck(nrs->scalar->NSfields!=4 || nrs->scalar->anyCvodeSolver || nrs->scalar->Nsubsteps
      || nrs->advectionSubcycingSteps || nrs->geom || nrs->neknek,
      platform->comm.mpiComm(),EXIT_FAILURE,"%s","Method2 requires four fixed-mesh native scalars, no subcycling/NekNek.\n");
  for(int i=0;i<4;++i){
    nekrsCheck(nrs->scalar->nameToIndex.at(names[i])!=i || !nrs->scalar->compute[i],
        platform->comm.mpiComm(),EXIT_FAILURE,"%s","Expected active ALPHA,UGX,UGY,UGZ.\n");
    auto range=platform->linAlg->minMax(nrs->meshV->Nlocal,{nrs->scalar->o_transportCoeff(names[i])},platform->comm.mpiComm());
    nekrsCheck(std::abs(range[0].first-1)>1e-12 || std::abs(range[0].second-1)>1e-12,
        platform->comm.mpiComm(),EXIT_FAILURE,"%s","Scalar transportCoeff must be 1.\n");
  }
  nekrsCheck(nrs->scalar->vFieldOffset!=nrs->fieldOffset,
      platform->comm.mpiComm(),EXIT_FAILURE,"%s","Method2 requires a shared scalar/velocity mesh layout.\n");
  allocate();
  if(platform->options.getArgs("RESTART FILE NAME").empty())
    initializePlumeKernel(nrs->meshV->Nlocal,nrs->fieldOffset,p.alphaInlet,p.ugInitial,
        p.initialPlumeHeight,p.initialPlumeThickness,nrs->meshV->o_z,
        nrs->scalar->o_solution("alpha"),nrs->scalar->o_solution("ugx"),
        nrs->scalar->o_solution("ugy"),nrs->scalar->o_solution("ugz"),nrs->fluid->o_U);
  initializeHistory();
  nrs->userSource=&addExplicitSources;nrs->userProperties=&updateProperties;
  nrs->postScalar=&postProcessAlpha;nrs->userDivergence=&enforceZeroDivergence;
  nrs->scalar->userImplicitLinearTerm=&implicitGasDrag;
  if(platform->comm.mpiRank()==0){
    int cubN=0;platform->options.getArgs("CUBATURE POLYNOMIAL DEGREE",cubN);
    printf("METHOD2 SIMPLE: alpha/UG -> native P/UM; NO UG pressure correction.\n");
    printf("METHOD2 SIMPLE: native UG-advection and native source EXT; automatic cubature order=%d.\n",cubN);
    printf("METHOD2 SIMPLE: UG drag=lambda(lagged)*UL_EXT-lambda*UG; full UM drag uses native EXT.\n");
    printf("METHOD2 SIMPLE: uniform inlet (wall-rim precedence), no extra alpha filter, no outlet ramp; VM enabled=%g.\n",p.virtualMassEnabled);
  }
}
void UDF_ExecuteStep(double time,int step)
{
  using namespace bubbleColumn2;
  reconstructLiquidVelocity();
  if(step>0 && p.virtualMassEnabled!=0)updateVirtualMassHistory();
  if(step>0 && step%p.stabilityMonitorInterval==0){
    const auto range=platform->linAlg->minMax(nrs->meshV->Nlocal,{nrs->scalar->o_solution("alpha")},platform->comm.mpiComm());
    const dfloat cfl=computeGasCfl();
    if(platform->comm.mpiRank()==0)printf("METHOD2 SIMPLE step=%d alphaMin/Max=(%.8e,%.8e) UG_CFL=%.8e\n",step,range[0].first,range[0].second,cfl);
  }
  if(nrs->checkpointStep){
    writeVector("ug",time,o_ug);writeVector("ul",time,o_ul);
    opSEM::strongGrad(nrs->meshV,nrs->fieldOffset,nrs->fluid->o_P,o_gradP);
    writeVector("gps",time,o_gradP);writeVector("gpp",time,o_pressureSample);
    nrs->copyToNek(time,step);nek::userchk();
  }
}
