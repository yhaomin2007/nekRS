#include "bubbleColumn2Terms.hpp"
#include "bubbleColumn2Cubature.hpp"

#ifdef __okl__
#include "bubbleColumn2.oudf"
#endif

void UDF_LoadKernels(deviceKernelProperties& kernelInfo)
{
  kernelInfo.define("p_ALPHA_INLET") = bubbleColumn2::p.alphaInlet;
  kernelInfo.define("p_UG_INLET") = bubbleColumn2::p.ugInlet;
  bubbleColumn2::registerKernels(kernelInfo);
}

void UDF_Setup0(MPI_Comm, setupAide &)
{
  // The native velocity is the phase-volume average
  //   u_v = (1-alpha) u_l + alpha u_g.
  // For incompressible phases without phase change, div(u_v)=0 exactly.
  // NekRS uses 1/rho in its pressure operator, so the property callback stores
  // rho_p = 1 / ((1-alpha)/rho_l + alpha/rho_g).
  platform->options.setArgs("LOWMACH", "FALSE");
  platform->options.setArgs("FLUID PRESSURE ELLIPTIC COEFF FIELD", "TRUE");
  // Core registrations copy platform->kernelInfo after setup0. OCCA emits
  // literal headers after its includes, so this supplies only missing c_I.
  int N = 0, cubN = 0;
  platform->options.getArgs("POLYNOMIAL DEGREE", N);
  platform->options.getArgs("CUBATURE POLYNOMIAL DEGREE", cubN);
  const auto interpolationHeader = bubbleColumn2::missingCubatureInterpolationHeader(N, cubN);
  if (!interpolationHeader.empty()) {
    platform->kernelInfo["headers"].asArray();
    platform->kernelInfo["headers"] += interpolationHeader;
  }
  auto &p = bubbleColumn2::p;
  platform->par->extract("casedata", "rholiquid", p.rhoLiquid);
  platform->par->extract("casedata", "rhogas", p.rhoGas);
  platform->par->extract("casedata", "muliquid", p.muLiquid);
  platform->par->extract("casedata", "mugas", p.muGas);
  platform->par->extract("casedata", "alphainlet", p.alphaInlet);
  platform->par->extract("casedata", "gasinletvelocity", p.ugInlet);
  p.ugInitial = p.ugInlet;
  platform->par->extract("casedata", "uginitial", p.ugInitial);
  platform->par->extract("casedata", "gasinitialvelocity", p.ugInitial);
  platform->par->extract("casedata", "frozengasvelocityenabled", p.frozenGasVelocityEnabled);
  platform->par->extract("casedata", "smoothgasvelocityprofileenabled", p.smoothGasVelocityProfileEnabled);
  platform->par->extract("casedata", "mixtureforcingenabled", p.mixtureForcingEnabled);
  platform->par->extract("casedata", "frozengasmixtureforcingenabled", p.frozenGasMixtureForcingEnabled);
  platform->par->extract("casedata", "frozengaswallrampwidth", p.frozenGasWallRampWidth);
  platform->par->extract("casedata", "frozengasradius", p.frozenGasRadius);
  platform->par->extract("casedata", "frozengascenterx", p.frozenGasCenterX);
  platform->par->extract("casedata", "frozengascentery", p.frozenGasCenterY);
  nekrsCheck(p.frozenGasVelocityEnabled < 0 || p.frozenGasVelocityEnabled > 1
                 || p.smoothGasVelocityProfileEnabled < 0 || p.smoothGasVelocityProfileEnabled > 1
                 || p.mixtureForcingEnabled < 0 || p.mixtureForcingEnabled > 1
                 || p.frozenGasMixtureForcingEnabled < 0 || p.frozenGasMixtureForcingEnabled > 1
                 || ((p.frozenGasVelocityEnabled || p.smoothGasVelocityProfileEnabled)
                     && (!std::isfinite(p.frozenGasWallRampWidth) || p.frozenGasWallRampWidth <= 0
                         || !std::isfinite(p.frozenGasRadius) || p.frozenGasRadius < 0
                         || !std::isfinite(p.frozenGasCenterX) || !std::isfinite(p.frozenGasCenterY))),
             platform->comm.mpiComm(), EXIT_FAILURE,
             "%s", "Frozen UG requires enabled=0/1, finite width>0, radius>=0, and finite center coordinates.\n");
  platform->par->extract("casedata", "initialplumeheight", p.initialPlumeHeight);
  platform->par->extract("casedata", "initialplumethickness", p.initialPlumeThickness);
  nekrsCheck(!(std::isfinite(p.initialPlumeHeight) && p.initialPlumeHeight >= 0.0
               && std::isfinite(p.initialPlumeThickness) && p.initialPlumeThickness > 0.0
               && std::isfinite(p.alphaInlet) && p.alphaInlet >= 0.0 && p.alphaInlet <= 1.0
               && std::isfinite(p.ugInlet) && std::isfinite(p.ugInitial) && std::isfinite(p.rhoLiquid) && p.rhoLiquid > 0.0
               && std::isfinite(p.rhoGas) && p.rhoGas > 0.0),
             platform->comm.mpiComm(), EXIT_FAILURE,
             "%s", "Plume initialization requires valid height/thickness, alphaInlet, "
             "gasInitialVelocity and positive phase densities.\n");
  platform->par->extract("casedata", "gravityx", p.gravity[0]);
  platform->par->extract("casedata", "gravityy", p.gravity[1]);
  platform->par->extract("casedata", "gravityz", p.gravity[2]);
  platform->par->extract("casedata", "alphafloor", p.alphaFloor);
  // Retain the old spelling as an alias; the documented key takes precedence.
  platform->par->extract("casedata", "alphaclippenabled", p.alphaClippingEnabled);
  platform->par->extract("casedata", "alphaclipenabled", p.alphaClippingEnabled);
  platform->par->extract("casedata", "alphaexplicitfiltermodes", p.alphaExplicitFilterModes);
  platform->par->extract("casedata", "alphaexplicitfilterstrength", p.alphaExplicitFilterStrength);
  platform->par->extract("casedata", "gasvelocitylowalphacutoffenabled", p.gasVelocityLowAlphaCutoffEnabled);
  platform->par->extract("casedata", "alphaminimum", p.alphaMinimum);
  platform->par->extract("casedata", "alphamaximum", p.alphaMaximum);
  platform->par->extract(
      "casedata", "subtractalphadiffusion", p.subtractAlphaDiffusion);
  platform->par->extract("casedata", "subtractugxdiffusion", p.subtractUgDiffusion[0]);
  platform->par->extract("casedata", "subtractugydiffusion", p.subtractUgDiffusion[1]);
  platform->par->extract("casedata", "subtractugzdiffusion", p.subtractUgDiffusion[2]);
  platform->par->extract("casedata", "zrampbottom", p.zRampBottom);
  platform->par->extract("casedata", "zramptop", p.zRampTop);
  platform->par->extract("casedata", "outletdampingfactor", p.outletDampingFactor);
  platform->par->extract("casedata",
                         "smoothgasvelocitymaskenabled",
                         p.smoothGasVelocityMaskEnabled);
  platform->par->extract("casedata", "gasvelocityclipenabled", p.gasVelocityClipEnabled);
  platform->par->extract("casedata", "gasvelocitymaximum", p.gasVelocityMaximum);
  platform->par->extract(
      "casedata", "volumevelocityclipenabled", p.volumeVelocityClipEnabled);
  platform->par->extract(
      "casedata", "volumevelocitymaximum", p.volumeVelocityMaximum);
  platform->par->extract("casedata", "gasmomentumcutoff", p.gasMomentumCutoff);
  platform->par->extract(
      "casedata", "gasmomentumfullyactive", p.gasMomentumFullyActive);
  platform->par->extract("casedata", "gaspressureenabled", p.gasPressureEnabled);
  platform->par->extract("casedata", "gaspressureinletmaskenabled", p.gasPressureInletMaskEnabled);
  platform->par->extract("casedata", "gaspressureinletregionenabled", p.gasPressureInletRegionEnabled);
  platform->par->extract("casedata", "gaspressureinletzeroendz", p.gasPressureInletZeroEndZ);
  platform->par->extract("casedata", "gaspressureinletrampendz", p.gasPressureInletRampEndZ);
  platform->par->extract(
      "casedata", "gaspressuregradientmethod", p.gasPressureGradientMethod);
  platform->par->extract("casedata", "gashydrostaticdensity", p.gasHydrostaticDensity);
  platform->par->extract("casedata", "gaspressurecorrectorenabled", p.gasPressureCorrectorEnabled);
  platform->par->extract("casedata", "gaspressurecorrectorgradientmethod", p.gasPressureCorrectorGradientMethod);
  nekrsCheck(p.gasPressureCorrectorEnabled < 0 || p.gasPressureCorrectorEnabled > 1
                 || p.gasPressureCorrectorGradientMethod < 0 || p.gasPressureCorrectorGradientMethod > 1,
             platform->comm.mpiComm(), EXIT_FAILURE,
             "%s", "UG pressure corrector enabled and gradient method must be 0/1.\n");
  platform->par->extract("casedata",
                         "gaspressuregradientfilterenabled",
                         p.gasPressureGradientFilterEnabled);
  platform->par->extract("casedata",
                         "gaspressuregradientfilterweight",
                         p.gasPressureGradientFilterWeight);
  platform->par->extract("casedata", "dragenabled", p.dragEnabled);
  platform->par->extract("casedata", "mixturedragrampenabled", p.mixtureDragRampEnabled);
  platform->par->extract("casedata", "mixturedragrampstartstep", p.mixtureDragRampStartStep);
  platform->par->extract("casedata", "mixturedragrampsteps", p.mixtureDragRampSteps);
  nekrsCheck(p.mixtureDragRampEnabled != 0.0
                 && (p.mixtureDragRampStartStep < 0 || p.mixtureDragRampSteps <= 0),
             platform->comm.mpiComm(), EXIT_FAILURE,
             "Mixture drag ramp requires startStep >= 0 and rampSteps > 0 "
             "(startStep=%d, rampSteps=%d)\n",
             p.mixtureDragRampStartStep, p.mixtureDragRampSteps);
  platform->par->extract("casedata", "mixturedragenabled", p.mixtureDragEnabled);
  platform->par->extract("casedata", "dragalphacutoff", p.dragAlphaCutoff);
  platform->par->extract("casedata", "dragsliplimitenabled", p.dragSlipLimitEnabled);
  platform->par->extract("casedata", "dragslipmaximum", p.dragSlipMaximum);
  nekrsCheck(p.dragSlipLimitEnabled != 0.0
                 && !(std::isfinite(p.dragSlipMaximum) && p.dragSlipMaximum > 0.0),
             platform->comm.mpiComm(), EXIT_FAILURE,
             "dragSlipMaximum must be finite and positive, got %g\n", p.dragSlipMaximum);
  nekrsCheck(!(p.dragAlphaCutoff >= 0.0 && p.dragAlphaCutoff <= 1.0),
             platform->comm.mpiComm(), EXIT_FAILURE, "dragAlphaCutoff must be in [0,1], got %g\n", p.dragAlphaCutoff);
  platform->par->extract("casedata", "bubblediameter", p.bubbleDiameter);
  platform->par->extract("casedata", "driftstressenabled", p.driftStressEnabled);
  platform->par->extract("casedata", "mixtureviscouscorrectionenabled",
                         p.mixtureViscousCorrectionEnabled);
  platform->par->extract("casedata", "virtualmassenabled", p.virtualMassEnabled);
  platform->par->extract("casedata", "mixturevirtualmassenabled", p.mixtureVirtualMassEnabled);
  platform->par->extract("casedata", "coupledvirtualmassenabled", p.coupledVirtualMassEnabled);
  platform->par->extract("casedata", "explicitvirtualmassenabled", p.explicitVirtualMassEnabled);
  nekrsCheck(p.explicitVirtualMassEnabled < 0 || p.explicitVirtualMassEnabled > 1
                 || (p.explicitVirtualMassEnabled && p.coupledVirtualMassEnabled),
             platform->comm.mpiComm(), EXIT_FAILURE,
             "%s", "explicitVirtualMassEnabled must be 0/1 and cannot be combined with coupledVirtualMassEnabled.\n");
  nekrsCheck(p.explicitVirtualMassEnabled
                 && (!p.mixtureVirtualMassEnabled || !p.mixtureForcingEnabled),
             platform->comm.mpiComm(), EXIT_FAILURE,
             "%s", "Fully explicit VM requires paired UG/UM VM and mixture forcing.\n");
  nekrsCheck(p.coupledVirtualMassEnabled < 0 || p.coupledVirtualMassEnabled > 1,
             platform->comm.mpiComm(), EXIT_FAILURE,
             "%s", "coupledVirtualMassEnabled must be 0 or 1.\n");
  nekrsCheck(p.mixtureVirtualMassEnabled < 0 || p.mixtureVirtualMassEnabled > 1,
             platform->comm.mpiComm(), EXIT_FAILURE,
             "%s", "mixtureVirtualMassEnabled must be 0 or 1.\n");
  platform->par->extract("casedata", "virtualmasscoefficient", p.virtualMassCoefficient);
  nekrsCheck(p.frozenGasVelocityEnabled && p.virtualMassEnabled != 0.0,
             platform->comm.mpiComm(), EXIT_FAILURE,
             "%s", "Set virtualMassEnabled=0 for the frozen UG isolation test.\n");
  platform->par->extract("casedata", "virtualmasstimederivativeorder", p.virtualMassTimeDerivativeOrder);
  platform->par->extract("casedata", "virtualmassstartstep", p.virtualMassStartStep);
  platform->par->extract("casedata", "virtualmassrampstep", p.virtualMassRampStep);
  nekrsCheck(!(std::isfinite(p.rhoGas) && p.rhoGas > 0.0
                 && std::isfinite(p.rhoLiquid) && p.rhoLiquid > 0.0
                 && std::isfinite(p.virtualMassCoefficient) && p.virtualMassCoefficient >= 0.0
                 && std::isfinite(p.virtualMassEnabled) && p.virtualMassEnabled >= 0.0),
             platform->comm.mpiComm(), EXIT_FAILURE,
             "%s", "UG added inertia requires positive finite densities and nonnegative finite VM controls.\n");
  nekrsCheck((p.virtualMassTimeDerivativeOrder != 1 && p.virtualMassTimeDerivativeOrder != 2)
               || p.virtualMassStartStep < 0 || p.virtualMassRampStep < 0,
             platform->comm.mpiComm(), EXIT_FAILURE,
             "virtualMassTimeDerivativeOrder must be 1 or 2; virtualMassStartStep and virtualMassRampStep must be >= 0 (order=%d start=%d ramp=%d)\n",
             p.virtualMassTimeDerivativeOrder, p.virtualMassStartStep, p.virtualMassRampStep);
  nekrsCheck(p.coupledVirtualMassEnabled
      && (p.frozenGasVelocityEnabled || !p.mixtureVirtualMassEnabled
          || !p.mixtureForcingEnabled || p.driftStressEnabled != 1.0
          || p.mixtureDragEnabled != 1.0 || p.mixtureDragRampEnabled != 0.0
          || p.gasPressureEnabled != 1.0 || p.gasPressureGradientMethod > 1
          || p.gasPressureGradientFilterEnabled != 0.0
          || p.gasPressureInletMaskEnabled || p.gasPressureInletRegionEnabled
          || p.gasVelocityClipEnabled != 0.0 || p.gasVelocityLowAlphaCutoffEnabled
          || p.volumeVelocityClipEnabled != 0.0),
      platform->comm.mpiComm(), EXIT_FAILURE,
      "%s", "Coupled VM requires solved/unclipped velocities, paired VM and mixture forces, "
      "drift and mixture drag enabled, no independent mixture drag ramp, and full computed UG pressure without masks/filter.\n");
  platform->par->extract("casedata", "stabilitymonitorenabled", p.stabilityMonitorEnabled);
  platform->par->extract("casedata", "stabilitymonitorinterval", p.stabilityMonitorInterval);
  platform->par->extract(
      "casedata", "validationoutputinterval", p.validationOutputInterval);
}

void UDF_Setup()
{
  nekrsCheck(nrs->scalar->NSfields != 4 || nrs->scalar->anyCvodeSolver,
             platform->comm.mpiComm(), EXIT_FAILURE,
             "%s", "bubbleColumn2 requires ALPHA,UGX,UGY,UGZ with native scalar solvers.\n");
  const char *names[4] = {"alpha", "ugx", "ugy", "ugz"};
  for (int i = 0; i < 4; ++i) {
    auto it = nrs->scalar->nameToIndex.find(names[i]);
    nekrsCheck(it == nrs->scalar->nameToIndex.end() || it->second != i,
               platform->comm.mpiComm(), EXIT_FAILURE,
               "Expected scalar %s at index %d\n", names[i], i);
    auto range = platform->linAlg->minMax(nrs->meshV->Nlocal,
        {nrs->scalar->o_transportCoeff(names[i])}, platform->comm.mpiComm());
    nekrsCheck(std::abs(range[0].first - 1.0) > 1e-12 || std::abs(range[0].second - 1.0) > 1e-12,
               platform->comm.mpiComm(), EXIT_FAILURE,
               "Scalar %s requires transportCoeff=1 for the normalized UG equations\n", names[i]);
  }
  bubbleColumn2::allocate();
  if (bubbleColumn2::p.gasPressureCorrectorEnabled) {
    const auto &p = bubbleColumn2::p;
    nekrsCheck(p.frozenGasVelocityEnabled || p.gasVelocityClipEnabled != 0.0
                   || p.gasVelocityLowAlphaCutoffEnabled,
               platform->comm.mpiComm(), EXIT_FAILURE,
               "%s", "UG pressure corrector requires solved UG with gas clipping/low-alpha masking disabled.\n");
    for (int i = 1; i < 4; ++i) {
      const auto sid = scalarDigitStr(i);
      nekrsCheck(!nrs->scalar->compute[i] || platform->app->bc->hasRobin("SCALAR"+sid),
                 platform->comm.mpiComm(), EXIT_FAILURE,
                 "%s", "UG pressure corrector requires active scalar solves and Dirichlet/Neumann boundaries.\n");
    }
    if (platform->comm.mpiRank() == 0)
      printf("bubbleColumn2 UG pressure corrector ON: new pressure gradient method=%d; frozen predictor diffusion/BDF/drag; one correction after native UM/P\n",
             p.gasPressureCorrectorGradientMethod);
  }
  if (platform->options.getArgs("RESTART FILE NAME").empty()) {
    const auto &p = bubbleColumn2::p;
    bubbleColumn2::initializePlumeKernel(
        nrs->meshV->Nlocal, nrs->fieldOffset,
        p.alphaInlet, p.ugInitial, p.initialPlumeHeight, p.initialPlumeThickness,
        nrs->meshV->o_z,
        nrs->scalar->o_solution("alpha"), nrs->scalar->o_solution("ugx"),
        nrs->scalar->o_solution("ugy"), nrs->scalar->o_solution("ugz"), nrs->fluid->o_U);
  }
  if (bubbleColumn2::p.smoothGasVelocityProfileEnabled
      && platform->options.getArgs("RESTART FILE NAME").empty()) {
    // Same initial and inlet profile as the frozen test, but no repeated
    // restoration: native UG solves may change the field from the first step.
    const char *names[3] = {"ugx", "ugy", "ugz"};
    for (int i = 0; i < 3; ++i)
      nrs->scalar->o_solution(names[i]).copyFrom(bubbleColumn2::o_frozenUg,
          nrs->meshV->Nlocal, 0, i*nrs->fieldOffset);
    bubbleColumn2::reconstructGasVelocity();
    nrs->fluid->o_U.copyFrom(bubbleColumn2::o_qg, 3*nrs->fieldOffset);
  }
  if (bubbleColumn2::p.frozenGasVelocityEnabled) {
    // Keep fields/properties/checkpoint layout, but skip native UG boundary
    // updates, forcing, filtering and solves. ALPHA remains an active scalar.
    std::vector<dlong> compute(nrs->scalar->NSfields, 1);
    for (int i = 1; i < 4; ++i) {
      nrs->scalar->compute[i] = 0;
      compute[i] = 0;
    }
    nrs->scalar->o_compute.copyFrom(compute.data(), compute.size());
    bubbleColumn2::reconstructGasVelocity();
    if (platform->options.getArgs("RESTART FILE NAME").empty())
      nrs->fluid->o_U.copyFrom(bubbleColumn2::o_qg, 3*nrs->fieldOffset);
    if (platform->comm.mpiRank() == 0)
      printf("bubbleColumn2 FROZEN UG: axial core=%g, radius=%g, wall ramp width=%g; UG solves disabled; alpha uses prescribed UG; VM off\n",
             bubbleColumn2::p.ugInlet, bubbleColumn2::p.frozenGasRadius,
             bubbleColumn2::p.frozenGasWallRampWidth);
    if (platform->comm.mpiRank() == 0)
      printf("bubbleColumn2 FROZEN UG mixture user forcing=%d (0: omit drag, drift, gravity and viscous-correction sources; native UM solve retained)\n",
             bubbleColumn2::p.frozenGasMixtureForcingEnabled);
  }
  bubbleColumn2::initializeHistory();
  if (platform->comm.mpiRank() == 0)
    printf("bubbleColumn2 test controls: UG solved=%d, smooth initial/inlet profile=%d, user mixture forcing=%d\n",
           !bubbleColumn2::p.frozenGasVelocityEnabled,
           bubbleColumn2::p.frozenGasVelocityEnabled || bubbleColumn2::p.smoothGasVelocityProfileEnabled,
           bubbleColumn2::p.mixtureForcingEnabled
             && (!bubbleColumn2::p.frozenGasVelocityEnabled || bubbleColumn2::p.frozenGasMixtureForcingEnabled));
  nrs->userSource = &bubbleColumn2::addExplicitSources;
  if (platform->comm.mpiRank() == 0)
    printf("bubbleColumn2 UG: scalars-first order; conservative cubature alpha and material UG transport; scalar EXT1; UM divergence zero\n");
  if (platform->comm.mpiRank() == 0 && bubbleColumn2::p.coupledVirtualMassEnabled)
    printf("bubbleColumn2 COUPLED VM: local phase material-inertia elimination; transformed UG/UM pressure, drag and phase stresses; no lagged VM acceleration source; native BDF and UM pressure solve retained\n");
  if (platform->comm.mpiRank() == 0 && bubbleColumn2::p.virtualMassEnabled != 0.0
      && !bubbleColumn2::p.coupledVirtualMassEnabled
      && !bubbleColumn2::p.explicitVirtualMassEnabled)
    printf("bubbleColumn2 virtual mass: implicit gas material inertia, lagged liquid acceleration order=%d, startStep=%d rampStep=%d; UM VM enabled=%d (explicit when enabled); history collected during delay\n",
           bubbleColumn2::p.virtualMassTimeDerivativeOrder, bubbleColumn2::p.virtualMassStartStep,
           bubbleColumn2::p.virtualMassRampStep, bubbleColumn2::p.mixtureVirtualMassEnabled);
  if (platform->comm.mpiRank() == 0 && bubbleColumn2::p.explicitVirtualMassEnabled)
    printf("bubbleColumn2 FULLY EXPLICIT VM: UG and UM use the same last-completed-step (aL-aG); gas inertia=rhoGas; no VM EXT extrapolation; derivative order=%d; coefficient=%g; startStep=%d rampStep=%d; physical phase-stress correction retained\n",
           bubbleColumn2::p.virtualMassTimeDerivativeOrder, bubbleColumn2::p.virtualMassCoefficient,
           bubbleColumn2::p.virtualMassStartStep, bubbleColumn2::p.virtualMassRampStep);
  if (platform->comm.mpiRank() == 0)
    printf("bubbleColumn2 drag: UG implicit reaction with lagged liquid velocity; mixture explicit; "
           "drag excluded from EXT extrapolation\n");
  if (bubbleColumn2::p.mixtureDragRampEnabled != 0.0 && platform->comm.mpiRank() == 0)
    printf("bubbleColumn2 mixture drag ramp: startStep=%d rampSteps=%d; "
           "linear step ramp; explicit mixture drag excluded from EXT extrapolation\n",
           bubbleColumn2::p.mixtureDragRampStartStep, bubbleColumn2::p.mixtureDragRampSteps);
  if (platform->comm.mpiRank() == 0 && bubbleColumn2::p.gasPressureInletRegionEnabled)
    printf("bubbleColumn2 UG pressure inlet region: zero for z<=%g; smoothstep recovery to full pressure at z=%g; UM pressure unchanged\n",
           bubbleColumn2::p.gasPressureInletZeroEndZ, bubbleColumn2::p.gasPressureInletRampEndZ);
  if (platform->comm.mpiRank() == 0 && bubbleColumn2::p.gasPressureGradientMethod == 2) {
    const auto &p = bubbleColumn2::p;
    const dfloat rhoRef = p.gasHydrostaticDensity > 0.0 ? p.gasHydrostaticDensity : p.rhoLiquid;
    printf("bubbleColumn2 UG hydrostatic pressure: rhoRef=%g gradP=(%g,%g,%g); local pressure fluctuations, filters and inlet masks bypassed; UM pressure unchanged\n",
           rhoRef, rhoRef*p.gravity[0], rhoRef*p.gravity[1], rhoRef*p.gravity[2]);
  }
  nrs->postScalar = &bubbleColumn2::postProcessAlpha;
  nrs->scalar->userImplicitLinearTerm = &bubbleColumn2::implicitGasDrag;
  nrs->userProperties = &bubbleColumn2::updateProperties;
  nrs->userDivergence = &bubbleColumn2::enforceZeroDivergence;
}

void UDF_ExecuteStep(double time, int tstep)
{
  bubbleColumn2::correctGasPressure();
  // Apply an emergency magnitude limiter immediately after the fluid solve so
  // the bounded volume velocity is used by diagnostics, output, and the next
  // timestep/CFL evaluation.
  bubbleColumn2::clipVolumeVelocity();
  if (tstep > 0 && bubbleColumn2::p.virtualMassEnabled != 0.0
      && !bubbleColumn2::p.coupledVirtualMassEnabled) {
    bubbleColumn2::updateVirtualMassHistory();
  }
  if (tstep > 0) {
    bubbleColumn2::printStabilityMonitors(time, tstep);
  }
  if (nrs->checkpointStep) {
    // Write reconstructed phase velocities as separate vector fields without
    // replacing the transported UG checkpoint variables used for restart.
    bubbleColumn2::reconstructGasVelocity();
    bubbleColumn2::reconstructLiquidVelocity();
    const dlong offset = nrs->fieldOffset;
    std::vector<deviceMemory<dfloat>> gasVelocity = {
        bubbleColumn2::o_ug.slice(0 * offset, nrs->meshV->Nlocal),
        bubbleColumn2::o_ug.slice(1 * offset, nrs->meshV->Nlocal),
        bubbleColumn2::o_ug.slice(2 * offset, nrs->meshV->Nlocal)};
    nrs->writeToFile(
        "ug", time, nrs->meshV, {{"velocity", gasVelocity}});
    std::vector<deviceMemory<dfloat>> liquidVelocity = {
        bubbleColumn2::o_ul.slice(0 * offset, nrs->meshV->Nlocal),
        bubbleColumn2::o_ul.slice(1 * offset, nrs->meshV->Nlocal),
        bubbleColumn2::o_ul.slice(2 * offset, nrs->meshV->Nlocal)};
    nrs->writeToFile(
        "ul", time, nrs->meshV, {{"velocity", liquidVelocity}});
    nrs->copyToNek(time, tstep);
    nek::userchk();
  }
  if (tstep > 0) {
    bubbleColumn2::writeValidationChecks(time, tstep);
  }
}
