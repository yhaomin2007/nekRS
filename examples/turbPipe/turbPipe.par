userSections = CASEDATA

#[OCCA]
#backend = CUDA
#deviceNumber = LOCAL-RANK

[GENERAL]
#verbose = true
polynomialOrder = 7
#startFrom = "restart.fld"
stopAt = numSteps
numSteps = 1000

timeStepper = tombo2

#dt = 6.0e-3
#advectionSubCyclingSteps = 2
dt = 1e-3
advectionSubCyclingSteps = 0

checkpointControl = steps
checkpointInterval = 100

regularization = hpfrt + nModes=1 + scalingCoeff=10

scalars = s00

[MESH]
file = turbPipe.re2

[FLUID PRESSURE]
initialGuess = previous
residualTol = 1e-10
#initialGuess = projectionAconj+nVector=10

[FLUID VELOCITY]
initialGuess = previous
boundaryTypeMap = udfDirichlet, zeroNeumann,zeroDirichlet
rho = 1.0
viscosity = 1/19000
residualTol = 1e-10

[SCALAR S00]
initialGuess = previous
transportCoeff = 1.0
diffusionCoeff = 1/19000
boundaryTypeMap = udfDirichlet, zeroNeumann, udfDirichlet
residualTol = 1e-10
regularization = avm+noiseThreshold=1e-3

[CASEDATA]
# adjust to actual mesh
NSLABS  = 60
NELSLAB = 132
processAscentYamlFrequency = 100

# Shared line sampling; this case uses the original native one-pass solver.
lineProfilesEnabled = 1
lineProfileInterval = 100
lineProfilePoints = 201
