@kernel void diagnosticFields(const dlong N,
                              const dlong offset,
                              @ restrict const dfloat *UL,
                              @ restrict const dfloat *UG,
                              @ restrict const dfloat *K,
                              @ restrict dfloat *slipVelocity,
                              @ restrict dfloat *interphaseForce)
{
  for (dlong n = 0; n < N; ++n; @tile(p_blockSize, @outer, @inner)) {
    for (int c = 0; c < 3; ++c) {
      const dfloat slip = UG[n + c*offset] - UL[n + c*offset];
      slipVelocity[n + c*offset] = slip;
      interphaseForce[n + c*offset] = K[n] * slip;
    }
  }
}
